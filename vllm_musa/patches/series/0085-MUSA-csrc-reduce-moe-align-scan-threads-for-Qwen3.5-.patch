From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Tue, 28 Jul 2026 10:00:00 +0800
Subject: [PATCH] MUSA(csrc): reduce moe align scan threads for Qwen3.5 decode

Use a 288-thread BlockScan specialization for the Qwen3.5 decode shape
(256 routed experts, optionally plus the folded shared expert, and at most 16
input rows). Keep the established 1024-thread specialization for every other
shape.
---
 .../moe/moe_align_sum_kernels.cu              | 58 ++++++++++++++-----
 1 file changed, 42 insertions(+), 16 deletions(-)

diff --git a/csrc/libtorch_stable/moe/moe_align_sum_kernels.cu b/csrc/libtorch_stable/moe/moe_align_sum_kernels.cu
index 7041012..4e9819d 100644
--- a/csrc/libtorch_stable/moe/moe_align_sum_kernels.cu
+++ b/csrc/libtorch_stable/moe/moe_align_sum_kernels.cu
@@ -94,7 +94,7 @@ __device__ __forceinline__ int get_local_expert_id(
   return expert_id;
 }
 
-template <typename scalar_t>
+template <typename scalar_t, int32_t block_threads = 1024>
 __device__ void _moe_align_block_size(
     const scalar_t* __restrict__ topk_ids,
     int32_t* __restrict__ sorted_token_ids, int32_t* __restrict__ expert_ids,
@@ -152,7 +152,7 @@ __device__ void _moe_align_block_size(
   __syncthreads();
 
   // Compute prefix sum over token counts per expert
-  using BlockScan = cub::BlockScan<int32_t, 1024>;
+  using BlockScan = cub::BlockScan<int32_t, block_threads>;
   __shared__ typename BlockScan::TempStorage temp_storage;
 
   int expert_count = 0;
@@ -319,7 +319,7 @@ __device__ void _count_and_sort_expert_tokens(
   }
 }
 
-template <typename scalar_t>
+template <typename scalar_t, int32_t block_threads = 1024>
 __global__ void moe_align_block_size_kernel(
     const scalar_t* __restrict__ topk_ids,
     int32_t* __restrict__ sorted_token_ids, int32_t* __restrict__ expert_ids,
@@ -328,7 +328,7 @@ __global__ void moe_align_block_size_kernel(
     int32_t padded_num_experts, int32_t experts_per_warp, int32_t block_size,
     size_t numel, int32_t* __restrict__ cumsum, int32_t max_num_tokens_padded,
     int32_t topk_num, bool has_expert_map) {
-  _moe_align_block_size(
+  _moe_align_block_size<scalar_t, block_threads>(
       topk_ids, sorted_token_ids, expert_ids, total_tokens_post_pad, expert_map,
       num_experts, padded_num_experts, experts_per_warp, block_size, numel,
       cumsum, max_num_tokens_padded, CEILDIV(max_num_tokens_padded, block_size),
@@ -632,8 +632,10 @@ void moe_align_block_size(
   int64_t padded_num_experts =
       ((num_experts + WARP_SIZE - 1) / WARP_SIZE) * WARP_SIZE;
   int experts_per_warp = WARP_SIZE;
-  int threads = 1024;
-  threads = ((threads + WARP_SIZE - 1) / WARP_SIZE) * WARP_SIZE;
+  constexpr int32_t default_threads = 1024;
+  // e256 needs one lane beyond the last expert to materialize the final
+  // prefix sum. 288 is the smallest warp-aligned block that provides it.
+  constexpr int32_t small_batch_e256_threads = 288;
 
   // BlockScan uses 1024 threads and assigns one thread per expert.
   TORCH_CHECK(padded_num_experts < 1024,
@@ -678,7 +680,12 @@ void moe_align_block_size(
         } else {
           torch::Tensor cumsum_buffer =
               torch::empty({num_experts + 1}, options_int);
-          auto align_kernel = vllm::moe::moe_align_block_size_kernel<scalar_t>;
+          const bool small_batch_e256_mode =
+              topk_ids.size(0) <= 16 &&
+              (num_experts == 256 || num_experts == 257);
+          const int32_t threads = small_batch_e256_mode
+                                      ? small_batch_e256_threads
+                                      : default_threads;
 
           size_t num_warps = CEILDIV(padded_num_experts, experts_per_warp);
           size_t shared_mem_size =
@@ -687,15 +694,34 @@ void moe_align_block_size(
           // launch two threadblocks
           // blockIdx.x == 0: counting experts and aligning
           // blockIdx.x == 1: filling sorted_token_ids
-          align_kernel<<<2, threads, shared_mem_size, stream>>>(
-              topk_ids.data_ptr<scalar_t>(),
-              sorted_token_ids.data_ptr<int32_t>(),
-              experts_ids.data_ptr<int32_t>(),
-              num_tokens_post_pad.data_ptr<int32_t>(),
-              expert_map.data_ptr<int32_t>(), num_experts, padded_num_experts,
-              experts_per_warp, block_size, topk_ids.numel(),
-              cumsum_buffer.data_ptr<int32_t>(), sorted_token_ids.size(0),
-              topk_ids.size(1), has_expert_map);
+          if (small_batch_e256_mode) {
+            auto align_kernel =
+                vllm::moe::moe_align_block_size_kernel<
+                    scalar_t, small_batch_e256_threads>;
+            align_kernel<<<2, small_batch_e256_threads, shared_mem_size,
+                           stream>>>(
+                topk_ids.data_ptr<scalar_t>(),
+                sorted_token_ids.data_ptr<int32_t>(),
+                experts_ids.data_ptr<int32_t>(),
+                num_tokens_post_pad.data_ptr<int32_t>(),
+                expert_map.data_ptr<int32_t>(), num_experts,
+                padded_num_experts, experts_per_warp, block_size,
+                topk_ids.numel(), cumsum_buffer.data_ptr<int32_t>(),
+                sorted_token_ids.size(0), topk_ids.size(1), has_expert_map);
+          } else {
+            auto align_kernel =
+                vllm::moe::moe_align_block_size_kernel<scalar_t,
+                                                        default_threads>;
+            align_kernel<<<2, default_threads, shared_mem_size, stream>>>(
+                topk_ids.data_ptr<scalar_t>(),
+                sorted_token_ids.data_ptr<int32_t>(),
+                experts_ids.data_ptr<int32_t>(),
+                num_tokens_post_pad.data_ptr<int32_t>(),
+                expert_map.data_ptr<int32_t>(), num_experts,
+                padded_num_experts, experts_per_warp, block_size,
+                topk_ids.numel(), cumsum_buffer.data_ptr<int32_t>(),
+                sorted_token_ids.size(0), topk_ids.size(1), has_expert_map);
+          }
 
           const int block_threads = std::min(256, (int)threads);
           const int num_blocks =
