+def test_musa_mamba_pool_holds_replay_snapshot_through_decode(monkeypatch):
+    """Decoding past the last-prompt-block snapshot must fit the Mamba pool.
+
+    The snapshot stays referenced until the request finishes. A dedicated pool
+    sized only for the resident window makes the request preempt itself at the
+    next block boundary and replay to the same point forever.
+    """
+    monkeypatch.setattr(
+        "vllm.v1.core.kv_cache_coordinator.musa_mamba_separate_pool_enabled",
+        lambda: True,
+    )
+    monkeypatch.delenv("VLLM_PREFIX_CACHE_RETENTION_INTERVAL", raising=False)
+    block_size, num_spec, max_model_len = 16, 6, 48
+    kv_cache_groups = [
+        KVCacheGroupSpec(
+            ["attn"],
+            FullAttentionSpec(
+                block_size=block_size,
+                num_kv_heads=1,
+                head_size=1,
+                dtype=torch.float32,
+            ),
+        ),
+        KVCacheGroupSpec(
+            ["mamba"],
+            MambaSpec(
+                block_size=block_size,
+                shapes=((1, 1),),
+                dtypes=(torch.float32,),
+                mamba_cache_mode="align",
+                num_speculative_blocks=num_spec,
+            ),
+        ),
+    ]
+    vllm_config = SimpleNamespace(
+        cache_config=SimpleNamespace(
+            mamba_cache_mode="align",
+            enable_prefix_caching=True,
+            prefix_match_unit=None,
+        ),
+        model_config=SimpleNamespace(max_model_len=max_model_len),
+        parallel_config=SimpleNamespace(decode_context_parallel_size=1),
+        kv_transfer_config=None,
+        max_concurrent_batches=1,
+    )
+    blocks_per_request = kv_cache_utils._musa_mamba_blocks_per_request(
+        vllm_config, kv_cache_groups
+    )
+
+    def runs_to_max_model_len(mamba_num_blocks):
+        manager = make_kv_cache_manager(
+            KVCacheConfig(
+                num_blocks=64,
+                musa_mamba_num_blocks=mamba_num_blocks,
+                kv_cache_tensors=[],
+                kv_cache_groups=kv_cache_groups,
+            ),
+            max_model_len=max_model_len,
+            enable_caching=True,
+            hash_block_size=block_size,
+        )
+        # The prompt ends inside the second block; prefill in sub-block chunks
+        # and then decode one token per step across the next block boundary.
+        req = make_request("r", list(range(30)), block_size, sha256)
+        while req.num_tokens < max_model_len:
+            num_new = min(8, req.num_tokens - req.num_computed_tokens)
+            if (
+                manager.allocate_slots(req, num_new, num_lookahead_tokens=num_spec)
+                is None
+            ):
+                return False
+            req.num_computed_tokens += num_new
+            if req.num_computed_tokens == req.num_tokens:
+                req.append_output_token_ids(1000 + req.num_tokens)
+        return True
+
+    # The block-table row binds here and equals this request's real peak: the
+    # running, speculative and retiring blocks plus the pinned snapshot. The
+    # pool adds the BlockPool null block.
+    assert blocks_per_request == max_model_len // block_size + num_spec
+    assert blocks_per_request == num_spec + 3
+    assert runs_to_max_model_len(blocks_per_request + 1)
+    assert not runs_to_max_model_len(blocks_per_request)
+
+
