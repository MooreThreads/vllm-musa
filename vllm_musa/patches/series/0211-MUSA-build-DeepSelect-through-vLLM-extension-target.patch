From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Tue, 3 Nov 2026 20:30:00 +0800
Subject: [PATCH] MUSA: build DeepSelect through vLLM extension target

Keep the upstream DeepSelect FetchContent URL, revision, and source override.
Build only vllm._deepselect_C in the existing empty target mode. DeepSelect
owns compiler selection and kernel compatibility; vLLM owns compilation,
installation, and native torch.ops registration.
---
 CMakeLists.txt                                | 16 ++++++++++
 cmake/external_projects/deepselect.cmake      | 31 +------------------
 .../external_projects/deepselect_source.cmake | 29 +++++++++++++++++
 setup.py                                      |  4 ++-
 4 files changed, 49 insertions(+), 31 deletions(-)
 create mode 100644 cmake/external_projects/deepselect_source.cmake

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 3a71d7e1e5..bcc5e8ebec 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -11,6 +11,14 @@ cmake_minimum_required(VERSION 3.26)
 # If you want to only build one target, make sure to install it manually:
 # cmake --build . --target _C
 # cmake --install . --component _C
+if(VLLM_TARGET_DEVICE STREQUAL "empty")
+  include(cmake/external_projects/deepselect_source.cmake)
+  if(NOT EXISTS "${deepselect_SOURCE_DIR}/cmake/vllm_musa_toolchain.cmake")
+    message(FATAL_ERROR "DeepSelect build integration missing; set DEEPSELECT_SRC_DIR to the updated MUSA checkout")
+  endif()
+  include("${deepselect_SOURCE_DIR}/cmake/vllm_musa_toolchain.cmake")
+endif()
+
 project(vllm_extensions LANGUAGES CXX)
 
 set(CMAKE_CXX_STANDARD 20)
@@ -47,6 +55,9 @@ install(CODE "set(CMAKE_INSTALL_LOCAL_ONLY TRUE)" ALL_COMPONENTS)
 # first match will be selected.  These should be kept in sync with setup.py.
 #
 set(PYTHON_SUPPORTED_VERSIONS "3.11" "3.12" "3.13" "3.14")
+if(VLLM_TARGET_DEVICE STREQUAL "empty")
+  list(APPEND PYTHON_SUPPORTED_VERSIONS "3.10")
+endif()
 
 # Supported AMD GPU architectures.
 set(HIP_SUPPORTED_ARCHS "gfx906;gfx908;gfx90a;gfx942;gfx950;gfx1250;gfx1030;gfx1100;gfx1101;gfx1102;gfx1103;gfx1150;gfx1151;gfx1152;gfx1153;gfx1200;gfx1201")
@@ -95,6 +106,11 @@ endif()
 #
 # Update cmake's `CMAKE_PREFIX_PATH` with torch location.
 #
+if(VLLM_TARGET_DEVICE STREQUAL "empty")
+  include("${deepselect_SOURCE_DIR}/cmake/vllm_musa.cmake")
+  return()
+endif()
+
 append_cmake_prefix_path("torch" "torch.utils.cmake_prefix_path")
 
 # Ensure the 'nvcc' command is in the PATH
diff --git a/cmake/external_projects/deepselect.cmake b/cmake/external_projects/deepselect.cmake
index e2a5592e61..998e30c5b6 100644
--- a/cmake/external_projects/deepselect.cmake
+++ b/cmake/external_projects/deepselect.cmake
@@ -1,33 +1,4 @@
-include(FetchContent)
-
-# If DEEPSELECT_SRC_DIR is set, DeepSelect is built from that directory
-# instead of downloading.
-# It can be set as an environment variable or passed as a cmake argument.
-# The environment variable takes precedence.
-if (DEFINED ENV{DEEPSELECT_SRC_DIR})
-  set(DEEPSELECT_SRC_DIR $ENV{DEEPSELECT_SRC_DIR})
-endif()
-
-if(DEEPSELECT_SRC_DIR)
-  FetchContent_Declare(
-        deepselect
-        SOURCE_DIR ${DEEPSELECT_SRC_DIR}
-        CONFIGURE_COMMAND ""
-        BUILD_COMMAND ""
-  )
-else()
-  FetchContent_Declare(
-        deepselect
-        GIT_REPOSITORY https://github.com/vllm-project/DeepSelect.git
-        GIT_TAG d96d33afe1fab0d6066da49cdc91e64c2bee65ea
-        GIT_PROGRESS TRUE
-        CONFIGURE_COMMAND ""
-        BUILD_COMMAND ""
-  )
-endif()
-
-FetchContent_MakeAvailable(deepselect)
-message(STATUS "DeepSelect is available at ${deepselect_SOURCE_DIR}")
+include(${CMAKE_CURRENT_LIST_DIR}/deepselect_source.cmake)
 
 # DeepSelect kernels require CUDA 12.9+; 10.0f (family) covers SM100 and SM103.
 set(DEEPSELECT_SUPPORT_ARCHS)
diff --git a/cmake/external_projects/deepselect_source.cmake b/cmake/external_projects/deepselect_source.cmake
new file mode 100644
index 0000000000..e2a9e3c890
--- /dev/null
+++ b/cmake/external_projects/deepselect_source.cmake
@@ -0,0 +1,29 @@
+include_guard(GLOBAL)
+include(FetchContent)
+
+if (DEFINED ENV{DEEPSELECT_SRC_DIR})
+  set(DEEPSELECT_SRC_DIR $ENV{DEEPSELECT_SRC_DIR})
+endif()
+
+if(DEEPSELECT_SRC_DIR)
+  FetchContent_Declare(
+        deepselect
+        SOURCE_DIR ${DEEPSELECT_SRC_DIR}
+        SOURCE_SUBDIR _vllm_source_only
+        CONFIGURE_COMMAND ""
+        BUILD_COMMAND ""
+  )
+else()
+  FetchContent_Declare(
+        deepselect
+        GIT_REPOSITORY https://github.com/vllm-project/DeepSelect.git
+        GIT_TAG d96d33afe1fab0d6066da49cdc91e64c2bee65ea
+        GIT_PROGRESS TRUE
+        SOURCE_SUBDIR _vllm_source_only
+        CONFIGURE_COMMAND ""
+        BUILD_COMMAND ""
+  )
+endif()
+
+FetchContent_MakeAvailable(deepselect)
+message(STATUS "DeepSelect is available at ${deepselect_SOURCE_DIR}")
diff --git a/setup.py b/setup.py
index 37bfc3e41b..43b7d21f88 100644
--- a/setup.py
+++ b/setup.py
@@ -1652,7 +1652,9 @@ for rust_extension_path in get_precompiled_rust_extension_paths():
     add_vllm_package_data(rust_extension_path.name)
 
 if _no_device():
-    ext_modules = []
+    deepselect_extension = CMakeExtension(name="vllm._deepselect_C")
+    deepselect_extension.py_limited_api = False
+    ext_modules = [deepselect_extension]
 
 if not ext_modules:
     cmdclass = {}
