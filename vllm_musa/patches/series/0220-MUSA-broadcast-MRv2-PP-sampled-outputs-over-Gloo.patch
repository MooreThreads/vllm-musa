 def compute_need_sampled_mask(input_batch: InputBatch) -> np.ndarray | None:
@@ -59,7 +80,9 @@ class PPHandler:
 
     Uses a dedicated NCCL communicator (sibling of the PP `device_group`)
     for the broadcast so it does not serialize on the wire with the
-    inter-stage hidden-state p2p send/recv ops.
+    inter-stage hidden-state p2p send/recv ops. On MUSA, stages packed
+    feedback over a sibling Gloo CPU subgroup with GIL-releasing event
+    synchronization so collectives do not spin on GPU streams.
     """
 
     def __init__(
@@ -91,11 +114,120 @@ class PPHandler:
         self.req_idx_gen_np = np.zeros(max_num_reqs, dtype=np.int32)
 
         # Dedicated subgroup for the sampled-token broadcast.
-        self.broadcast_group = get_pp_group().make_sibling_device_group(
-            group_desc="pp_broadcast"
+        self._use_cpu_broadcast = current_platform.is_musa()
+        self._pin_memory = (
+            self._use_cpu_broadcast and current_platform.is_pin_memory_available()
         )
+        self._musart_event_sync = (
+            _load_musart_event_sync() if self._use_cpu_broadcast else None
+        )
+        self._send_queue: (
+            queue.SimpleQueue[tuple[torch.cuda.Event, torch.Tensor] | None] | None
+        ) = None
+        self._send_thread: threading.Thread | None = None
+        self._send_exc: BaseException | None = None
+        self._ring_idx = 0
+        self._cpu_ring: list[torch.Tensor] = []
+        if self._use_cpu_broadcast:
+            self.broadcast_group = self._make_cpu_broadcast_group()
+            row_i32 = max_num_reqs * (2 * self.max_sample_len + 2)
+            self._cpu_ring = [
+                torch.empty(
+                    row_i32,
+                    dtype=torch.int32,
+                    device="cpu",
+                    pin_memory=self._pin_memory,
+                )
+                for _ in range(max(8, ring_depth * 3))
+            ]
+            if self.is_last_rank:
+                self._send_queue = queue.SimpleQueue()
+                self._send_thread = threading.Thread(
+                    target=self._cpu_broadcast_loop,
+                    name="vllm-pp-broadcast",
+                    daemon=True,
+                )
+                self._send_thread.start()
+        else:
+            self.broadcast_group = get_pp_group().make_sibling_device_group(
+                group_desc="pp_broadcast"
+            )
         self.aux_hidden_state_relay_keys: tuple[str, ...] = ()
 
+    @staticmethod
+    def _make_cpu_broadcast_group() -> ProcessGroup:
+        pp_group = get_pp_group()
+        cpu_timeout = get_cpu_distributed_timeout_or_none()
+        sibling: ProcessGroup | None = None
+        for ranks in pp_group.group_ranks:
+            pg = torch.distributed.new_group(
+                ranks, backend="gloo", group_desc="pp_broadcast", timeout=cpu_timeout
+            )
+            if pp_group.rank in ranks:
+                sibling = pg
+        assert sibling is not None
+        return sibling
+
+    def _wait_event_gil_free(self, event: torch.cuda.Event) -> None:
+        if (
+            getattr(event.synchronize, "_torchada_gil_free", False) is not True
+            and self._musart_event_sync is not None
+            and (
+                ptr := getattr(event, "musa_event", None)
+                or getattr(event, "cuda_event", None)
+            )
+        ):
+            if rc := self._musart_event_sync(ctypes.c_void_p(ptr)):
+                event.synchronize()
+                raise RuntimeError(f"musaEventSynchronize failed with error {rc}")
+            return
+        event.synchronize()
+
+    def _cpu_broadcast_loop(self) -> None:
+        assert self._send_queue is not None
+        torch.cuda.set_device(self.device)
+        while (item := self._send_queue.get()) is not None:
+            event, cpu_tensor = item
+            try:
+                self._wait_event_gil_free(event)
+                torch.distributed.broadcast(
+                    cpu_tensor, src=self.last_rank, group=self.broadcast_group
+                )
+            except BaseException as exc:
+                self._send_exc = exc
+                logger.exception("PP CPU broadcast worker failed")
+                return
+
+    def _stage_cpu_broadcast(
+        self, src_gpu: torch.Tensor, cpu_buf: torch.Tensor | None = None
+    ) -> None:
+        if self._send_exc is not None:
+            raise RuntimeError("PP CPU broadcast worker failed") from self._send_exc
+        assert self._send_queue is not None
+        if cpu_buf is None:
+            cpu_buf = torch.empty(
+                src_gpu.shape,
+                dtype=src_gpu.dtype,
+                device="cpu",
+                pin_memory=self._pin_memory,
+            )
+        cpu_buf.copy_(src_gpu, non_blocking=self._pin_memory)
+        self._send_queue.put((self.broadcast_stream.record_event(), cpu_buf))
+
+    def shutdown(self) -> None:
+        if self._send_thread is not None and self._send_queue is not None:
+            if self._send_thread.is_alive():
+                self._send_queue.put(None)
+                self._send_thread.join(timeout=10.0)
+            self._send_thread = None
+        while self.queue:
+            if (slot := self.queue.popleft()) is not None:
+                for work in slot.cpu_works:
+                    work.wait()
+        if self._send_exc is not None:
+            exc, self._send_exc = self._send_exc, None
+            raise RuntimeError("PP CPU broadcast worker failed") from exc
+
     def on_req_idx_freed(self, req_idx: int) -> None:
         self.req_idx_gen_np[req_idx] += 1
 
