From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Tue, 27 Oct 2026 10:43:12 +0800
Subject: [PATCH] MUSA: load DeepSeek-V4 FP8 experts with their own block size

---
 vllm/models/deepseek_v4/quant_config.py     | 69 ++++++++++++++++++++-
 vllm/models/deepseek_v41/nvidia/dspark.py   |  5 +-
 vllm/models/deepseek_v41/nvidia/model.py    | 15 ++++-
 vllm/models/deepseek_v41/nvidia/vl_model.py |  3 +-
 4 files changed, 87 insertions(+), 5 deletions(-)

diff --git a/vllm/models/deepseek_v4/quant_config.py b/vllm/models/deepseek_v4/quant_config.py
index f3aaf72d9b..349a6c2c34 100644
--- a/vllm/models/deepseek_v4/quant_config.py
+++ b/vllm/models/deepseek_v4/quant_config.py
@@ -4,15 +4,18 @@
 
 from __future__ import annotations
 
+import copy
 from typing import TYPE_CHECKING, cast
 
+import regex as re
+
 from vllm.config import get_current_vllm_config
 from vllm.model_executor.layers.fused_moe import (
     RoutedExperts,
     UnquantizedFusedMoEMethod,
 )
 from vllm.model_executor.layers.quantization import QuantizationMethods
-from vllm.model_executor.layers.quantization.fp8 import Fp8Config
+from vllm.model_executor.layers.quantization.fp8 import Fp8Config, Fp8MoEMethod
 from vllm.model_executor.layers.quantization.mxfp4 import Mxfp4MoEMethod
 from vllm.model_executor.layers.quantization.utils.quant_utils import (
     is_layer_skipped,
@@ -51,6 +54,12 @@ class DeepseekV4FP8Config(Fp8Config):
         self._resolved_expert_dtype: str | None = None
         self._resolved_moe_quant_algo: str | None = None
         self._nvfp4_config: ModelOptNvFp4Config | None = None
+        # FP8 routed experts may use a coarser block than the linear layers,
+        # e.g. 128x128 experts converted from MXFP4 beside 32x32 linears.
+        self.expert_weight_block_size: list[int] | None = (
+            list(self.weight_block_size) if self.weight_block_size else None
+        )
+        self._expert_fp8_config: Fp8Config | None = None
         # ``is_scale_e8m0`` is a property that resolves on first read,
         # by which time the current vllm_config has been set.
 
@@ -175,6 +184,27 @@ class DeepseekV4FP8Config(Fp8Config):
             }
         return cast("DeepseekV4FP8Config", super().from_config(config))
 
+    def maybe_update_config(
+        self,
+        model_name: str,
+        hf_config=None,
+        revision: str | None = None,
+    ) -> None:
+        if self.weight_block_size is None:
+            return
+        block = getattr(hf_config, "expert_weight_block_size", None)
+        if block is None:
+            block = _checkpoint_expert_weight_block_size(model_name, revision)
+        if block is not None:
+            self.expert_weight_block_size = [int(b) for b in block]
+
+    def _get_expert_fp8_config(self) -> Fp8Config:
+        if self._expert_fp8_config is None:
+            expert_config = copy.copy(self)
+            expert_config.weight_block_size = list(self.expert_weight_block_size)
+            self._expert_fp8_config = expert_config
+        return self._expert_fp8_config
+
     def get_quant_method(self, layer, prefix):
         if isinstance(layer, RoutedExperts):
             if is_layer_skipped(
@@ -194,6 +224,43 @@ class DeepseekV4FP8Config(Fp8Config):
                         moe_config=layer.moe_config,
                     )
                 return Mxfp4MoEMethod(layer.moe_config)
+            if (
+                self.expert_weight_block_size is not None
+                and self.expert_weight_block_size != self.weight_block_size
+            ):
+                return Fp8MoEMethod(self._get_expert_fp8_config(), layer)
             # expert_dtype == "fp8": fall through to Fp8Config which
             # returns Fp8MoEMethod with block-wise float32 scales.
         return super().get_quant_method(layer, prefix)
+
+
+_EXPERT_W1_WEIGHT = re.compile(r"\.experts\.\d+\.w1\.weight$")
+
+
+def _checkpoint_expert_weight_block_size(
+    model_name: str, revision: str | None
+) -> list[int] | None:
+    """Block shape of a local checkpoint's routed-expert FP8 weights, read
+    from the first expert weight and its scale in the safetensors metadata."""
+    from pathlib import Path
+
+    from vllm.transformers_utils.config import get_safetensors_params_metadata
+
+    if not Path(model_name).is_dir():
+        return None
+    try:
+        metadata = get_safetensors_params_metadata(model_name, revision=revision)
+    except Exception:
+        return None
+    for name, info in metadata.items():
+        if not _EXPERT_W1_WEIGHT.search(name):
+            continue
+        scale = metadata.get(name[: -len("weight")] + "scale")
+        if scale is None or info.get("dtype") not in ("F8_E4M3", "F8_E5M2"):
+            return None
+        rows, cols = info["shape"]
+        scale_rows, scale_cols = scale["shape"]
+        if rows % scale_rows or cols % scale_cols:
+            return None
+        return [rows // scale_rows, cols // scale_cols]
+    return None
diff --git a/vllm/models/deepseek_v41/nvidia/dspark.py b/vllm/models/deepseek_v41/nvidia/dspark.py
index a09c3159c2..4a39edd701 100644
--- a/vllm/models/deepseek_v41/nvidia/dspark.py
+++ b/vllm/models/deepseek_v41/nvidia/dspark.py
@@ -56,6 +56,7 @@ from .model import (
     DeepseekV4DecoderLayer,
     DeepseekV4Model,
     _linear_scale_param_name,
+    _resolve_expert_dtype,
     _use_sequence_parallel,
     make_deepseek_v4_expert_params_mapping,
     maybe_init_gemm_rs,
@@ -292,7 +293,7 @@ class DSparkDeepseekV4ForCausalLM(nn.Module):
         self.config = self.draft_model_config.hf_config
         self.quant_config = vllm_config.quant_config
         self.linear_scale_name = _linear_scale_param_name(
-            vllm_config, getattr(self.config, "expert_dtype", "fp4")
+            vllm_config, _resolve_expert_dtype(self.config, self.quant_config)
         )
         self.pad_shared_expert = getattr(
             self.quant_config, "weight_block_size", None
@@ -393,7 +394,7 @@ class DSparkDeepseekV4ForCausalLM(nn.Module):
             )
         expert_scale_suffix = (
             ".weight_scale"
-            if getattr(self.config, "expert_dtype", "fp4") == "fp4"
+            if _resolve_expert_dtype(self.config, self.quant_config) == "fp4"
             else ".weight_scale_inv"
         )
 
diff --git a/vllm/models/deepseek_v41/nvidia/model.py b/vllm/models/deepseek_v41/nvidia/model.py
index 8ec0155f73..20f3e2b97b 100644
--- a/vllm/models/deepseek_v41/nvidia/model.py
+++ b/vllm/models/deepseek_v41/nvidia/model.py
@@ -1426,6 +1426,19 @@ class DeepseekV4Model(nn.Module, EagleModelMixin):
                 layer.hc_attn_fn_broadcast.copy_(broadcast)
 
 
+def _resolve_expert_dtype(config, quant_config) -> str:
+    """Expert dtype for the weight mapper. Converted FP8 checkpoints omit
+    ``expert_dtype`` from their config; the DeepSeek quant config resolves it
+    from hf_overrides, which do not reach nested text or draft configs."""
+    expert_dtype = getattr(config, "expert_dtype", None)
+    resolved = getattr(quant_config, "expert_dtype", None)
+    if resolved in ("fp4", "fp8") and (
+        expert_dtype is None or (expert_dtype == "fp4" and resolved == "fp8")
+    ):
+        expert_dtype = resolved
+    return expert_dtype or "fp4"
+
+
 def _linear_scale_param_name(vllm_config: VllmConfig, expert_dtype: str) -> str:
     """Parameter name the linear quant method registers for weight scales.
 
@@ -1561,7 +1574,7 @@ class DeepseekV41LLMForCausalLM(
 
         config = vllm_config.model_config.hf_config
         self.config = config
-        expert_dtype = getattr(config, "expert_dtype", "fp4")
+        expert_dtype = _resolve_expert_dtype(config, vllm_config.quant_config)
         self.hf_to_vllm_mapper = _make_deepseek_v4_weights_mapper(
             expert_dtype, _linear_scale_param_name(vllm_config, expert_dtype)
         )
