 from typing import Any
 
 import numpy as np
@@ -20,7 +21,7 @@ from vllm.model_executor.models.utils import extract_layer_index
 from vllm.platforms import current_platform
 from vllm.triton_utils import tl, triton
 from vllm.utils.mem_utils import MemorySnapshot, format_gib
-from vllm.utils.torch_utils import async_tensor_h2d
+from vllm.utils.torch_utils import async_tensor_h2d, get_dtype_size
 from vllm.v1.attention.backend import (
     AttentionBackend,
     AttentionMetadataBuilder,
@@ -564,6 +565,30 @@ def select_common_block_size(
     )
 
 
+def _musa_mamba_state_pools(
+    buf: torch.Tensor, spec: MambaSpec, num_blocks: int
+) -> list[torch.Tensor]:
+    """View one Mamba pool as a contiguous block pool per state.
+
+    The page layout interleaves a layer's states, so the SSM view carries a
+    page-sized block stride. Slicing the same bytes state-major gives each
+    state a dense pool instead.
+    """
+    flat = buf.view(-1)
+    pools: list[torch.Tensor] = []
+    offset = 0
+    for shape, dtype in zip(spec.shapes, spec.dtypes):
+        end = offset + num_blocks * prod(shape) * get_dtype_size(dtype)
+        if end > flat.numel():
+            raise RuntimeError(
+                f"Mamba pool of {flat.numel()} elements cannot hold "
+                f"{num_blocks} blocks of {shape} {dtype}: needs {end}"
+            )
+        pools.append(flat[offset:end].view(dtype).view(num_blocks, *shape))
+        offset = end
+    return pools
+
+
 def allocate_kv_cache(
     kv_cache_config: KVCacheConfig,
     device: torch.device,
@@ -629,6 +654,14 @@ def allocate_kv_cache(
             continue
 
         num_blocks = kv_cache_config.num_blocks_of(tensor)
+        if isinstance(spec, MambaSpec) and separate_musa_pools:
+            assert tensor.offset == 0
+            assert len(tensor.layers) == 1, "the MUSA Mamba pool is carved per layer"
+            kv_caches.update(
+                (name, _musa_mamba_state_pools(buf, spec, num_blocks))
+                for name in tensor.layers
+            )
+            continue
         kernel_block_size = None
         if kernel_block_sizes is not None and group_id < len(kernel_block_sizes):
             kernel_block_size = kernel_block_sizes[group_id]
@@ -826,7 +859,7 @@ def add_kv_sharing_layers_to_kv_cache_groups(
 
 
