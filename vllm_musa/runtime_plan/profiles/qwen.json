{
  "schema_version": "musa.runtime_profile.v1",
  "id": "qwen",
  "priority": 100,
  "reason": "declarative Qwen runtime profile",
  "provider_when": {
    "any": [
      {"ref": "cosyvoice_identity"},
      {"ref": "qwen35_identity"},
      {"ref": "qwen3_identity"},
      {"ref": "qwen2_identity"}
    ]
  },
  "conditions": {
    "cosyvoice_identity": {
      "any": [
        {"path": "model.effective_architectures", "op": "contains_any", "value": ["CosyVoice3Model"]},
        {"path": "model.model_type", "op": "eq", "value": "cosyvoice3"}
      ]
    },
    "qwen35_identity": {
      "any": [
        {"path": "model.effective_architectures", "op": "contains_any", "value": ["Qwen3_5ForCausalLM", "Qwen3_5ForConditionalGeneration", "Qwen3_5MoeForCausalLM", "Qwen3_5MoeForConditionalGeneration"]},
        {"path": "model.model_type", "op": "in", "value": ["qwen3_5", "qwen3_5_text", "qwen3_5_moe", "qwen3_5_moe_text"]}
      ]
    },
    "qwen3_identity": {
      "any": [
        {"path": "model.effective_architectures", "op": "contains_any", "value": ["Qwen3ForCausalLM", "Qwen3MoeForCausalLM"]},
        {"path": "model.model_type", "op": "eq", "value": "qwen3"}
      ]
    },
    "qwen2_identity": {
      "any": [
        {"path": "model.effective_architectures", "op": "contains_any", "value": ["Qwen2ForCausalLM", "Qwen2MoeForCausalLM"]},
        {"path": "model.model_type", "op": "eq", "value": "qwen2"}
      ]
    },
    "single_device": {
      "all": [
        {"path": "execution.tensor_parallel_size", "op": "eq", "value": 1},
        {"path": "execution.pipeline_parallel_size", "op": "eq", "value": 1},
        {"path": "execution.data_parallel_size", "op": "eq", "value": 1},
        {"path": "execution.decode_context_parallel_size", "op": "eq", "value": 1}
      ]
    },
    "bf16": {"path": "model.dtype", "op": "eq", "value": "bfloat16"},
    "no_quantization": {"path": "model.quantization", "op": "in", "value": [null, "none"]},
    "no_speculative": {"path": "execution.has_speculative_config", "op": "eq", "value": false},
    "not_pooling": {"path": "execution.is_pooling_model", "op": "eq", "value": false},
    "cache_supported": {
      "all": [
        {"path": "execution.cache_dtype", "op": "in", "value": [null, "auto", "bfloat16"]},
        {"path": "execution.cache_block_size", "op": "in", "value": [null, 64]}
      ]
    },
    "legacy_sampling": {
      "all": [
        {"path": "model.effective_architectures", "op": "contains_any", "value": ["Qwen2ForCausalLM", "Qwen2MoeForCausalLM", "Qwen3ForCausalLM", "Qwen3MoeForCausalLM", "Qwen3_5ForConditionalGeneration", "Qwen3_5MoeForConditionalGeneration"]},
        {"ref": "no_speculative"},
        {"ref": "not_pooling"}
      ]
    },
    "v2_sampling": {
      "path": "model.effective_architectures",
      "op": "contains_any",
      "value": ["Qwen2ForCausalLM", "Qwen2MoeForCausalLM", "Qwen3ForCausalLM", "Qwen3MoeForCausalLM", "Qwen3_5ForCausalLM", "Qwen3_5ForConditionalGeneration", "Qwen3_5MoeForCausalLM", "Qwen3_5MoeForConditionalGeneration"]
    },
    "fa3_architecture": {
      "path": "model.effective_architectures",
      "op": "contains_any",
      "value": ["Qwen2ForCausalLM", "Qwen2MoeForCausalLM", "Qwen3ForCausalLM", "Qwen3MoeForCausalLM", "Qwen3_5ForConditionalGeneration", "Qwen3_5MoeForConditionalGeneration", "CosyVoice3Model"]
    },
    "fa3_single_request": {
      "all": [
        {"ref": "fa3_architecture"},
        {"path": "execution.has_parallel_config", "op": "eq", "value": true},
        {"ref": "no_speculative"},
        {"ref": "single_device"},
        {"path": "execution.max_num_seqs", "op": "gt", "value": 0}
      ]
    },
    "qwen2_rope_presplit": {
      "all": [
        {"path": "model.family", "op": "eq", "value": "qwen2"},
        {"path": "model.model_type", "op": "in", "value": ["qwen2", "cosyvoice3"]},
        {"path": "model.hidden_size", "op": "eq", "value": 896},
        {"path": "model.num_hidden_layers", "op": "eq", "value": 24},
        {"path": "model.num_attention_heads", "op": "eq", "value": 14},
        {"ref": "bf16"},
        {"ref": "no_quantization"},
        {"path": "execution.has_quant_config", "op": "eq", "value": false},
        {"ref": "no_speculative"},
        {"path": "execution.has_parallel_config", "op": "eq", "value": true},
        {"ref": "cache_supported"},
        {"path": "model.enforce_eager", "op": "eq", "value": false},
        {"ref": "single_device"},
