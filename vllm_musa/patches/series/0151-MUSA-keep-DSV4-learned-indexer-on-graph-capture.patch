From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Tue, 8 Sep 2026 18:34:46 +0800
Subject: [PATCH] MUSA: keep DSV4 learned indexer on graph capture

---
 vllm/model_executor/layers/sparse_attn_indexer.py | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/vllm/model_executor/layers/sparse_attn_indexer.py b/vllm/model_executor/layers/sparse_attn_indexer.py
index 5f41c86307..7f65da56ca 100644
--- a/vllm/model_executor/layers/sparse_attn_indexer.py
+++ b/vllm/model_executor/layers/sparse_attn_indexer.py
@@ -2137,6 +2137,13 @@ class SparseAttnIndexer(CustomOp):
 
     def uses_musa_recent_indices(self) -> bool:
         """Whether this capture uses the MUSA recent-window approximation."""
+        # The recent table is metadata-only: it does not consume the learned
+        # indexer query or per-head weights and therefore is not semantically
+        # equivalent to the DSV4 learned indexer. The DSV4 optimization
+        # contract is currently the only caller that sets
+        # ``use_musa_native_indexer``.
+        if self.use_musa_native_indexer:
+            return False
         return (
             current_platform.is_musa()
             and self.use_musa_native_indexer
