+def _apply_qsa_output_gate(output: torch.Tensor, gate: torch.Tensor) -> None:
+    """Multiply the attention output by ``sigmoid(gate)`` like the Triton path.
+
+    The Triton epilogue rounds the attention output to its storage dtype and
+    then gates in FP32, so the same order is kept here.
+    """
+    output.mul_(torch.sigmoid(gate.float()))
+
+
+def _is_dense_page_cache(cache: torch.Tensor) -> bool:
+    """Whether a paged K/V cache has a dense innermost dim.
+
+    The TileLang kernels read the block and page strides off the tensor, so a
+    slab that stores K and V for one token side by side works; only the last
+    dim has to be contiguous for the vector gather.
+    """
+    paged = cache.squeeze(2)
+    if paged.ndim != 3:
+        return False
+    return paged.stride(2) == 1
+
 
