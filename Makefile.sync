# vLLM patch-series sync/maintenance.
#
# Maintains vLLM-MUSA's source modifications as a `git format-patch` series against
# a pinned upstream vLLM tag. Cross-version bumps use `git am -3` (true 3-way
# merge), so trivial upstream drift auto-merges and only real conflicts need
# hand-resolution.
#
# This is the *maintenance/generation* tool (developer + CI). The *build-time*
# application of the resulting series to third_party/vllm lives in
# vllm_musa/patches/build_apply.py. There is no runtime source-patching fallback.
#
# Usage:
#   make -f Makefile.sync checkout            # clone + checkout the pinned vLLM
#   make -f Makefile.sync apply-patches       # git am -3 the series onto it
#   make -f Makefile.sync format-patches      # regenerate the series from commits
#   make -f Makefile.sync clean apply-patches # fresh re-apply
#   # version bump: edit VLLM_TAG + VLLM_COMMIT in third_party/PINS, then:
#   make -f Makefile.sync clean apply-patches # resolve conflicts via `git am --continue`
#   make -f Makefile.sync format-patches      # rewrite series onto the new base

UPSTREAM := https://github.com/vllm-project/vllm.git
# Pinned upstream vLLM ref — single source of truth in third_party/PINS, read by
# BOTH this Makefile and setup.py, so they cannot desync on a bump.
VLLM_TAG := $(shell sed -n 's/^VLLM_TAG=//p' third_party/PINS)
VLLM_COMMIT := $(shell sed -n 's/^VLLM_COMMIT=//p' third_party/PINS)
VLLM_REF := $(if $(VLLM_COMMIT),$(VLLM_COMMIT),$(VLLM_TAG))
WORKDIR := third_party/vllm
PATCHES_DIR := vllm_musa/patches/series
VLLM_REQUIREMENTS_SOURCE := $(WORKDIR)/requirements/common.txt
VLLM_REQUIREMENTS_SNAPSHOT := requirements/vllm_common.txt

PATCHES := $(wildcard $(PATCHES_DIR)/*.patch)
# per-patch stamp files (.<name>.patched) — gitignored; make incremental apply
PATCHED := $(join $(dir $(PATCHES)),$(addsuffix ed,$(addprefix .,$(notdir $(PATCHES)))))

.NOTPARALLEL:
.PHONY: checkout apply-patches format-patches sync-vllm-requirements \
	check-vllm-requirements clean help

help:
	@echo "checkout | apply-patches | format-patches | sync-vllm-requirements | check-vllm-requirements | clean   (pin: $(VLLM_REF) from third_party/PINS)"

# --- fresh pinned checkout of upstream vLLM (a real git repo: 3-way works) ---
$(WORKDIR):
	git clone $(UPSTREAM) $(WORKDIR)

checkout: $(WORKDIR)
	git -C $(WORKDIR) fetch origin $(VLLM_REF)
	git -C $(WORKDIR) checkout -f --detach FETCH_HEAD

# --- replay the series as commits via `git am -3` (delegated to
#     musa_sync — ONE git code path, manifest-ordered, true 3-way per patch) ---
apply-patches:
	python3 tools/musa_sync.py rebase $(VLLM_REF)

# --- regenerate the series FROM the commits (delegated to musa_sync;
#     --no-signature --no-numbered --zero-commit, KEEP blob index lines for 3-way) ---
format-patches: | $(PATCHES_DIR)
	python3 tools/musa_sync.py regen

# Keep the outer distribution's runtime metadata in sync with the pinned
# upstream checkout. The checked-in snapshot is consumed before build commands
# can clone third_party/vllm, so generation is a maintenance-time operation.
sync-vllm-requirements: checkout
	python3 tools/sync_vllm_requirements.py \
		--source "$(VLLM_REQUIREMENTS_SOURCE)" \
		--output "$(VLLM_REQUIREMENTS_SNAPSHOT)"

check-vllm-requirements:
	python3 tools/sync_vllm_requirements.py --check \
		--source "$(VLLM_REQUIREMENTS_SOURCE)" \
		--output "$(VLLM_REQUIREMENTS_SNAPSHOT)"

$(PATCHES_DIR):
	mkdir -p $(PATCHES_DIR)

# --- reset for a clean re-apply ---
clean: checkout
	@git -C $(WORKDIR) am --abort 2>/dev/null || true
	$(RM) $(PATCHES_DIR)/.*.patched
