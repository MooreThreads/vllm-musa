From ff7007e9cd94a786593fe370e8247fd9f75bfee3 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Tue, 10 Nov 2026 16:58:37 +0800
Subject: [PATCH] MUSA: use external overlap eligibility callback

---
 .../layers/fused_moe/runner/moe_runner.py             | 11 +++--------
 .../layers/fused_moe/runner/shared_experts.py         |  8 +++++---
 2 files changed, 8 insertions(+), 11 deletions(-)

diff --git a/vllm/model_executor/layers/fused_moe/runner/moe_runner.py b/vllm/model_executor/layers/fused_moe/runner/moe_runner.py
index aa5bec8..5752679 100644
--- a/vllm/model_executor/layers/fused_moe/runner/moe_runner.py
+++ b/vllm/model_executor/layers/fused_moe/runner/moe_runner.py
@@ -282,27 +282,22 @@ class MoERunner(MoERunnerInterface):
 
         self._shared_experts: SharedExperts | None = None
         if shared_experts is not None:
-            musa_overlap = False
+            external_overlap = None
             if current_platform.is_musa():
                 from vllm_musa.model_executor.layers.shared_experts import (
                     can_overlap_shared_experts,
                 )
 
-                musa_overlap = not enable_dbo and can_overlap_shared_experts(
+                external_overlap = lambda: can_overlap_shared_experts(
                     get_current_vllm_config(), self._quant_method
                 )
-                if musa_overlap:
-                    logger.info_once(
-                        "Using MUSA W4AFP8 shared-expert overlap up to the "
-                        "configured token threshold"
-                    )
             can_overlap = lambda: self._quant_method.mk_can_overlap_shared_experts
             self._shared_experts = SharedExperts(
                 shared_experts,
                 moe_config=moe_config,
                 enable_dbo=enable_dbo,
                 mk_can_overlap_shared_experts=can_overlap,
-                musa_overlap=musa_overlap,
+                external_overlap=external_overlap,
             )
 
         # Needed for string -> MoERunner layer lookup in custom ops.
diff --git a/vllm/model_executor/layers/fused_moe/runner/shared_experts.py b/vllm/model_executor/layers/fused_moe/runner/shared_experts.py
index fb0b17b..55df777 100644
--- a/vllm/model_executor/layers/fused_moe/runner/shared_experts.py
+++ b/vllm/model_executor/layers/fused_moe/runner/shared_experts.py
@@ -43,7 +43,7 @@ class SharedExperts(torch.nn.Module):
         moe_config: FusedMoEConfig,
         enable_dbo: bool,
         mk_can_overlap_shared_experts: Callable[[], bool],
-        musa_overlap: bool = False,
+        external_overlap: Callable[[], bool] | None = None,
     ):
         super().__init__()
 
@@ -57,7 +57,9 @@ class SharedExperts(torch.nn.Module):
         self._moe_config = moe_config
 
         self._mk_can_overlap_shared_experts = mk_can_overlap_shared_experts
-        self._musa_overlap = musa_overlap and not enable_dbo
+        self._external_overlap_allowed = (
+            external_overlap() if external_overlap is not None else False
+        )
 
         # Allow disabling of the separate shared experts stream for
         # debug purposes.
@@ -113,7 +115,7 @@ class SharedExperts(torch.nn.Module):
         is_musa = current_platform.is_musa()
         platform_allows_overlap = (
             current_platform.is_cuda_alike() and not is_musa
-        ) or (is_musa and self._musa_overlap)
+        ) or (is_musa and self._external_overlap_allowed)
         should_run_shared_in_aux_stream = (
             platform_allows_overlap
             and self._stream is not None
-- 
2.25.1

