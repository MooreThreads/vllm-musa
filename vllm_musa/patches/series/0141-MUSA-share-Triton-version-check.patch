From: musa <musa@local>
Date: 2026-09-15T14:51:05+08:00
Subject: [PATCH] MUSA: share-Triton-version-check

---
 vllm/triton_utils/musa.py | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)
 create mode 100644 vllm/triton_utils/musa.py

diff --git a/vllm/triton_utils/musa.py b/vllm/triton_utils/musa.py
new file mode 100644
index 0000000000..0dd80f4f7b
--- /dev/null
+++ b/vllm/triton_utils/musa.py
@@ -0,0 +1,17 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Shared checks for MUSA Triton compatibility paths."""
+from functools import lru_cache
+
+
+@lru_cache(maxsize=1)
+def is_musa_triton_32() -> bool:
+    import torch
+    from packaging.version import Version
+
+    if getattr(torch.version, "musa", None) is None:
+        return False
+
+    from vllm.triton_utils import triton
+
+    return Version("3.2.0") <= Version(triton.__version__) < Version("3.3.0")
