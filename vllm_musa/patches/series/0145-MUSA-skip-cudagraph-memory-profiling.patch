@@ -6779,4 +6780,20 @@
     @torch.inference_mode()
     def profile_cudagraph_memory(self) -> int:
+        # Temporary graph-memory profiling can stall on MUSA even when the
+        # final PCG/FULL capture succeeds. Use a configurable reservation until
+        # the temporary profiling path is supported; real capture stays enabled.
+        if current_platform.is_musa():
+            reserved_bytes = int(
+                os.getenv("VLLM_MUSA_CUDAGRAPH_MEMORY_BYTES", str(1 << 30))
+            )
+            if reserved_bytes < 0:
+                raise ValueError("VLLM_MUSA_CUDAGRAPH_MEMORY_BYTES must be >= 0")
+            logger.warning_once(
+                "Skipping MUSA CUDA graph memory profiling; reserving %.2f GiB "
+                "(override with VLLM_MUSA_CUDAGRAPH_MEMORY_BYTES)",
+                reserved_bytes / (1 << 30),
+            )
+            return reserved_bytes
+
         with set_current_vllm_config(self.vllm_config):
             self._init_minimal_kv_cache_for_profiling()
