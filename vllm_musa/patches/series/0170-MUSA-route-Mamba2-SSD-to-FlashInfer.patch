From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Wed, 23 Sep 2026 17:52:48 +0800
Subject: [PATCH] MUSA: route Mamba2 SSD to FlashInfer

---
 .../layers/mamba/ops/ssd_combined.py          | 31 +++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/vllm/model_executor/layers/mamba/ops/ssd_combined.py b/vllm/model_executor/layers/mamba/ops/ssd_combined.py
index 8c645574b9..51f6a10fc5 100644
--- a/vllm/model_executor/layers/mamba/ops/ssd_combined.py
+++ b/vllm/model_executor/layers/mamba/ops/ssd_combined.py
@@ -174,6 +174,7 @@ def mamba_chunk_scan_combined_varlen(
     dt_limit=(0.0, float("inf")),
     return_intermediate_states=False,
     state_dtype=None,
+    backend=None,
 ):
     """
     Argument:
@@ -195,6 +196,8 @@ def mamba_chunk_scan_combined_varlen(
         dt_softplus: Whether to apply softplus to dt
         out: (seqlen, nheads, headdim) preallocated output tensor
         state_dtype: The data type of the ssm state
+        backend: Mamba backend name; "flashinfer" routes the SSD to the
+            FlashInfer kernels on MUSA.
     Return:
         varlen_states: (batch, nheads, headdim, dstate)
     """
@@ -202,6 +205,34 @@ def mamba_chunk_scan_combined_varlen(
     assert cu_seqlens is not None, "cu_seqlens must be provided assuming varlen input"
     assert seq_idx is not None
 
+    if x.device.type == "musa" and backend == "flashinfer":
+        # MUSA: FlashInfer supplies the SSD chunk-scan kernels.
+        from flashinfer.mamba.ssd_combined import (
+            ssd_combined_fwd_varlen as flashinfer_ssd_combined_fwd_varlen,
+        )
+
+        return flashinfer_ssd_combined_fwd_varlen(
+            x=x,
+            dt=dt,
+            A=A,
+            B=B,
+            C=C,
+            chunk_size=chunk_size,
+            cu_seqlens=cu_seqlens,
+            cu_chunk_seqlens=cu_chunk_seqlens,
+            last_chunk_indices=last_chunk_indices,
+            seq_idx=seq_idx,
+            out=out,
+            D=D,
+            z=z,
+            dt_bias=dt_bias,
+            initial_states=initial_states,
+            dt_softplus=dt_softplus,
+            dt_limit=dt_limit,
+            return_intermediate_states=return_intermediate_states,
+            state_dtype=state_dtype,
+        )
+
     varlen_states = _mamba_chunk_scan_combined_fwd(
         x,
         dt,
