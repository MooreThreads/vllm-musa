From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Thu, 26 Nov 2026 17:06:50 +0800
Subject: [PATCH] MUSA: enable PyNccl for pipeline parallelism

Let PP communicators use MCCL by default and honor the explicit library override. Resolve the native MUSA stream on the communicator device for collectives and point-to-point transfers.
---
 .../device_communicators/cuda_communicator.py |  9 ++++++
 .../device_communicators/pynccl.py            | 32 +++++++++++--------
 2 files changed, 28 insertions(+), 13 deletions(-)

diff --git a/vllm/distributed/device_communicators/cuda_communicator.py b/vllm/distributed/device_communicators/cuda_communicator.py
index 4c6cb64bdf..afdc743ac4 100644
--- a/vllm/distributed/device_communicators/cuda_communicator.py
+++ b/vllm/distributed/device_communicators/cuda_communicator.py
@@ -105,9 +105,18 @@ class CudaCommunicator(DeviceCommunicatorBase):
 
         self.pynccl_comm: PyNcclCommunicator | None = None
         if self.world_size > 1:
+            library_path = None
+            # Enable MCCL by default for PP. Other groups may use grouped
+            # collectives that can hang on MCCL (e.g. uneven DP/EP dispatch).
+            if (
+                current_platform.device_type == "musa"
+                and unique_name.split(":", 1)[0] == "pp"
+            ):
+                library_path = envs.VLLM_NCCL_SO_PATH or "libmccl.so.2"
             self.pynccl_comm = PyNcclCommunicator(
                 group=self.cpu_group if tcp_store_group is None else tcp_store_group,
                 device=self.device,
+                library_path=library_path,
             )
             if is_symmetric_memory_enabled():
                 register_nccl_symmetric_ops(self.pynccl_comm)
diff --git a/vllm/distributed/device_communicators/pynccl.py b/vllm/distributed/device_communicators/pynccl.py
index 76eeb2291f..42823a90b7 100644
--- a/vllm/distributed/device_communicators/pynccl.py
+++ b/vllm/distributed/device_communicators/pynccl.py
@@ -162,6 +162,12 @@ class PyNcclCommunicator:
             self.unique_id = group.broadcast_obj(self.unique_id, src=0)
         self._init_comm(device)
 
+    def _current_stream(self) -> torch.cuda.Stream:
+        if self.device.type == "musa":
+            # Native MUSA stream contexts bypass vLLM's CUDA stream cache.
+            return torch.musa.current_stream(self.device)
+        return current_stream()
+
