From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Wed, 9 Sep 2026 22:25:42 +0800
Subject: [PATCH] MUSA: pass Mamba2 graph metadata buffers

---
 vllm/v1/attention/backends/mamba_attn.py | 12 +++++++-----
 vllm/v1/worker/gpu_model_runner.py       | 17 ++++++++++++++---
 2 files changed, 21 insertions(+), 8 deletions(-)

diff --git a/vllm/v1/attention/backends/mamba_attn.py b/vllm/v1/attention/backends/mamba_attn.py
index 6b7ac71ae8..deec4a316c 100644
--- a/vllm/v1/attention/backends/mamba_attn.py
+++ b/vllm/v1/attention/backends/mamba_attn.py
@@ -202,7 +202,11 @@ class BaseMambaAttentionMetadataBuilder(AttentionMetadataBuilder[M], abc.ABC):
             self.supports_update_block_table = False
 
     def build_for_cudagraph_capture(
-        self, common_attn_metadata: CommonAttentionMetadata
+        self,
+        common_attn_metadata: CommonAttentionMetadata,
+        *,
+        num_accepted_tokens: torch.Tensor | None = None,
+        prev_last_scheduled_idx: torch.Tensor | None = None,
     ) -> M:
         """
         This method builds the metadata for full cudagraph capture.
@@ -220,12 +224,10 @@ class BaseMambaAttentionMetadataBuilder(AttentionMetadataBuilder[M], abc.ABC):
 
         assert m.max_query_len == 1 + self.num_spec_tokens  # decode-only
 
-        num_accepted_tokens = None
-        if self.num_spec_tokens > 0:
+        if num_accepted_tokens is None and self.num_spec_tokens > 0:
             num_accepted_tokens = torch.diff(m.query_start_loc)
 
-        prev_last_scheduled_idx = None
-        if (
+        if prev_last_scheduled_idx is None and (
             self.use_spec_decode
             and self.vllm_config.cache_config.mamba_cache_mode == "all"
         ):
diff --git a/vllm/v1/worker/gpu_model_runner.py b/vllm/v1/worker/gpu_model_runner.py
index 9087f87854..c0fb0361d9 100644
--- a/vllm/v1/worker/gpu_model_runner.py
+++ b/vllm/v1/worker/gpu_model_runner.py
@@ -2591,9 +2591,20 @@ class GPUModelRunner(
                     )
 
             if for_cudagraph_capture:
-                attn_metadata_i = builder.build_for_cudagraph_capture(
-                    common_attn_metadata
-                )
+                if isinstance(builder, Mamba2AttentionMetadataBuilder):
+                    attn_metadata_i = builder.build_for_cudagraph_capture(
+                        common_attn_metadata,
+                        num_accepted_tokens=extra_attn_metadata_args.get(
+                            "num_accepted_tokens"
+                        ),
+                        prev_last_scheduled_idx=extra_attn_metadata_args.get(
+                            "prev_last_scheduled_idx"
+                        ),
+                    )
+                else:
+                    attn_metadata_i = builder.build_for_cudagraph_capture(
+                        common_attn_metadata
+                    )
             elif (
                 cache_key in cached_attn_metadata
                 and builder.supports_update_block_table
