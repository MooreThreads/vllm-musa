From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Tue, 27 Oct 2026 10:43:12 +0800
Subject: [PATCH] MUSA: load the DeepSeek-V4.1 ratio-2 compressor rows
 separately

---
 .../deepseek_v41/common/ops/fused_compress_quant_cache.py  | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/vllm/models/deepseek_v41/common/ops/fused_compress_quant_cache.py b/vllm/models/deepseek_v41/common/ops/fused_compress_quant_cache.py
index 2ba9dbea3d..41efc75107 100644
--- a/vllm/models/deepseek_v41/common/ops/fused_compress_quant_cache.py
+++ b/vllm/models/deepseek_v41/common/ops/fused_compress_quant_cache.py
@@ -16,7 +16,12 @@ else:
 # The ring and raw rows a ratio-2 request program pools are not adjacent, so
 # reading them as one tile means joining two pointers. ROCm's Triton fails to
 # legalize `tt.join` on pointers, so there the two rows are loaded separately.
-_JOIN_ROW_PTRS = not current_platform.is_rocm()
+# MUSA: load the two pooled rows separately, as on ROCm, instead of joining
+# their pointers.
+_JOIN_ROW_PTRS = not (
+    current_platform.is_rocm()
+    or getattr(current_platform, "is_musa", lambda: False)()
+)
 
 
 def fused_save_compress_norm(
