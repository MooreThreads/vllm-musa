+def _musa_mamba_pool_blocks_per_request(
+    vllm_config: VllmConfig,
+    mamba_groups: list[KVCacheGroupSpec],
+    mamba_page: int,
+) -> int:
+    """Blocks one running request may hold in the dedicated Mamba pool.
+
+    The resident footprint already depends on the Mamba cache mode; only align
+    mode pins a snapshot that stays referenced until the request finishes and
+    lets an extra in-flight batch hold one retired running-state block. With
+    prefix-cache retention every retained segment stays pinned. A hash
+    granularity finer than the Mamba block additionally needs the block being
+    copied and its copy source. Clamped by the block-table row width.
+    """
+    live = max(
+        cdiv(group.kv_cache_spec.max_memory_usage_bytes(vllm_config), mamba_page)
+        for group in mamba_groups
+    )
+    if vllm_config.cache_config.mamba_cache_mode != "align":
+        return live
+    row = max(
+        group.kv_cache_spec.max_num_blocks_per_req(
+            vllm_config, vllm_config.model_config.max_model_len
+        )
+        for group in mamba_groups
+    )
+    if vllm_config.cache_config.prefix_cache_retention_interval:
+        return row
+    blocks = min(row, live + 1 + (vllm_config.max_concurrent_batches - 1))
+    if vllm_config.cache_config.enable_prefix_caching or vllm_config.kv_transfer_config:
+        dcp = vllm_config.parallel_config.decode_context_parallel_size
+        hash_block_size = vllm_config.cache_config.prefix_match_unit or math.gcd(
+            *(
+                group.kv_cache_spec.block_size
+                * (dcp if isinstance(group.kv_cache_spec, AttentionSpec) else 1)
+                for group in mamba_groups
+            )
+        )
+        if hash_block_size < max(
+            group.kv_cache_spec.block_size for group in mamba_groups
+        ):
+            blocks += 2
+            kv_transfer = vllm_config.kv_transfer_config
+            if kv_transfer is not None and kv_transfer.is_kv_producer:
+                blocks += 1
+    return min(row, blocks)
+
