+    def _musa_tilelang_ok(
+        self,
+        query: torch.Tensor,
+        key_cache: torch.Tensor,
+        value_cache: torch.Tensor,
+        use_prefill_config: bool,
+    ) -> bool:
+        """Whether the TileLang sparse kernels can take this step.
+
+        The kernels tile the grouped-query axis, so the number of query heads
+        per KV head has to fit one tile: 16 rows for prefill, 8 for split-k
+        decode. Every layout detail is read off the tensors.
+        """
+        if not current_platform.is_musa():
+            return False
+        if query.dtype is not torch.bfloat16:
+            return False
+        if key_cache.dtype is not torch.bfloat16:
+            return False
+        if value_cache.dtype is not torch.bfloat16:
+            return False
+        if key_cache.shape[2] != 1 or value_cache.shape[2] != 1:
+            return False
+        group_size = query.shape[1] // key_cache.shape[2]
+        if group_size > (16 if use_prefill_config else 8):
+            return False
+        if self.head_size % 8:
+            return False
+        return _is_dense_page_cache(key_cache) and _is_dense_page_cache(value_cache)
+
