diff --git a/vllm/v1/attention/backends/mla/sparse_utils.py b/vllm/v1/attention/backends/mla/sparse_utils.py
index ef92557..f6a0065 100644
--- a/vllm/v1/attention/backends/mla/sparse_utils.py
+++ b/vllm/v1/attention/backends/mla/sparse_utils.py
@@ -24,7 +24,13 @@ def flat_kv_row_view(
         "silently misaddress"
     )
     block_stride_rows = kv_cache.stride(0) // head_dim
-    num_rows = (num_blocks - 1) * block_stride_rows + block_size
+    assert kv_cache.shape[1] % block_size == 0, (
+        f"physical cache block size {kv_cache.shape[1]} must be divisible by "
+        f"kernel block size {block_size}"
+    )
+    # Keep every subpage of the final packed block addressable. The cache may
+    # expose a 128-token allocator page to a 64-token kernel.
+    num_rows = (num_blocks - 1) * block_stride_rows + kv_cache.shape[1]
     rows = kv_cache.as_strided((num_rows, head_dim), (head_dim, 1))
     return rows, block_stride_rows
 
@@ -43,6 +49,7 @@ def _convert_req_index_to_global_index_kernel(
     max_num_blocks_per_req: tl.constexpr,
     BLOCK_SIZE: tl.constexpr,
     BLOCK_STRIDE_ROWS: tl.constexpr,
+    BLOCKS_PER_STRIDE: tl.constexpr,
     BLOCK_N: tl.constexpr,  # tile width along columns
     HAS_PREFILL: tl.constexpr,
     COUNT_VALID: tl.constexpr,  # whether to count valid indices
@@ -109,7 +116,13 @@ def _convert_req_index_to_global_index_kernel(
     bt_ptr = block_table_ptr + req * bt_stride0 + block_id * bt_stride1
     is_invalid_tok |= ~valid_block | is_remote
     base = tl.load(bt_ptr, mask=valid_block & ~is_prefill & ~is_remote, other=0)
-    out_val = base * BLOCK_STRIDE_ROWS + inblock_off
+    logical_block = base // BLOCKS_PER_STRIDE
+    subblock = base % BLOCKS_PER_STRIDE
+    out_val = (
+        logical_block * BLOCK_STRIDE_ROWS
+        + subblock * BLOCK_SIZE
+        + inblock_off
+    )
 
     # Override with prefill output if prefill is enabled
     if HAS_PREFILL:
@@ -180,6 +193,7 @@ def triton_convert_req_index_to_global_index(
     token_indices: torch.Tensor,  # int32 [num_tokens, NUM_TOPK_TOKENS]
     BLOCK_SIZE: int = 64,
     BLOCK_STRIDE_ROWS: int | None = None,
+    BLOCKS_PER_STRIDE: int = 1,
     NUM_TOPK_TOKENS: int = 2048,
     BLOCK_N: int = 128,  # tile width along columns
     HAS_PREFILL_WORKSPACE: bool = False,
@@ -218,6 +232,7 @@ def triton_convert_req_index_to_global_index(
         "is allocated like token_indices, so a longer req_id writes out of bounds"
     )
     assert token_indices.shape[1] == NUM_TOPK_TOKENS
+    assert BLOCKS_PER_STRIDE > 0
     assert NUM_TOPK_TOKENS % BLOCK_N == 0, (
         f"NUM_TOPK_TOKENS ({NUM_TOPK_TOKENS}) must be divisible by BLOCK_N ({BLOCK_N})"
     )
@@ -281,6 +296,7 @@ def triton_convert_req_index_to_global_index(
         max_num_blocks_per_req,
         BLOCK_SIZE,
         BLOCK_STRIDE_ROWS if BLOCK_STRIDE_ROWS is not None else BLOCK_SIZE,
+        BLOCKS_PER_STRIDE,
         block_n,
         HAS_PREFILL_WORKSPACE,
         return_valid_counts,
