+def _musa_attention_specs_uniform(attention_specs: dict) -> bool:
+    """Whether the non-Mamba specs can share one attention KV tensor.
+
+    The separated MUSA allocator builds one tensor per page-size group and
+    views it with the first spec's dtype and geometry, so layers that differ in
+    dtype, block size, page size or head geometry cannot share a group.
+    """
+    signatures = {
+        (
+            type(spec),
+            getattr(spec, "dtype", None),
+            spec.block_size,
+            spec.page_size_bytes,
+            getattr(spec, "num_kv_heads", None),
+            getattr(spec, "head_size", None),
+        )
+        for spec in attention_specs.values()
+    }
+    return len(signatures) == 1
