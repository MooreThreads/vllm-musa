From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Wed, 30 Sep 2026 10:00:00 +0800
Subject: [PATCH] MUSA: route DeepSeek-V4 prefill score GEMM to DeepGEMM

---
 vllm/models/deepseek_v4/attention.py | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/vllm/models/deepseek_v4/attention.py b/vllm/models/deepseek_v4/attention.py
index 897fcdc7b2..979e368e09 100644
--- a/vllm/models/deepseek_v4/attention.py
+++ b/vllm/models/deepseek_v4/attention.py
@@ -4,6 +4,7 @@
 DeepseekV4 MLA Attention Layer
 """
 
+import os
 from abc import ABC, abstractmethod
 from collections.abc import Callable
 from typing import TYPE_CHECKING, Any, ClassVar, cast
@@ -91,6 +92,11 @@ def _fill_short_context_topk_indices(
 
 # MUSA: the DeepSeek-V4 attention helpers below branch on the active platform.
 _MUSA_DEEPSEEK_V4_SCORE_FP32_DEEPGEMM_MAX_TOKENS = 80
+# Above the multi-stream threshold the input projections run serially on the
+# main stream; score GEMMs there use DeepGEMM instead of a SIMT fp32 sgemm.
+_MUSA_DEEPSEEK_V4_SCORE_DEEPGEMM_PREFILL = (
+    os.environ.get("VLLM_MUSA_DSV4_SCORE_DEEPGEMM_PREFILL", "1") == "1"
+)
 
 
 def _musa_deepseek_v4_serialize_long_prefill(num_tokens: int) -> bool:
@@ -115,7 +121,13 @@ def _musa_deepseek_v4_use_score_fp32_deepgemm(
         and a.dtype == torch.bfloat16
         and weight.dtype == torch.bfloat16
         and out_dtype == torch.float32
-        and a.shape[0] <= _MUSA_DEEPSEEK_V4_SCORE_FP32_DEEPGEMM_MAX_TOKENS
+        and (
+            a.shape[0] <= _MUSA_DEEPSEEK_V4_SCORE_FP32_DEEPGEMM_MAX_TOKENS
+            or (
+                _MUSA_DEEPSEEK_V4_SCORE_DEEPGEMM_PREFILL
+                and a.shape[0] > envs.VLLM_MULTI_STREAM_GEMM_TOKEN_THRESHOLD
+            )
+        )
     )
 
 
