+    Host syncs such as ``.item()`` can fail while a graph is capturing. Fail
+    closed in that case so dispatch stays on the learned Torch path.
+    """
+    seq_lens = getattr(decode_metadata, "seq_lens", None)
+    if seq_lens is None:
+        return 2**31 - 1
+    try:
+        return int(seq_lens.reshape(-1).max().item())
+    except (RuntimeError, ValueError, TypeError):
+        return 2**31 - 1
 
 
