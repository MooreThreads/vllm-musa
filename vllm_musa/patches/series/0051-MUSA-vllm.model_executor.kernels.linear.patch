From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Tue, 27 Oct 2026 10:43:05 +0800
Subject: [PATCH] MUSA: vllm.model_executor.kernels.linear

---
 .../model_executor/kernels/linear/__init__.py | 45 ++++++++++++++++++-
 1 file changed, 43 insertions(+), 2 deletions(-)

diff --git a/vllm/model_executor/kernels/linear/__init__.py b/vllm/model_executor/kernels/linear/__init__.py
index bb7adad164..60a7264abc 100644
--- a/vllm/model_executor/kernels/linear/__init__.py
+++ b/vllm/model_executor/kernels/linear/__init__.py
@@ -381,7 +381,13 @@ def _filter_kernels_by_backend(
 ) -> list[type]:
     """Prefer matching kernels, falling back to auto by layer type."""
     backend_kernels = _LINEAR_BACKEND_KERNEL_MAP.get(backend, set())
-    filtered = [kernel for kernel in kernels if kernel in backend_kernels]
+    _backend_tuple = tuple(backend_kernels)
+    filtered = [
+        kernel
+        for kernel in kernels
+        if kernel in backend_kernels
+        or (current_platform.is_musa() and issubclass(kernel, _backend_tuple))
+    ]
     if not filtered:
         logger.warning_once(
             "--linear-backend=%s has no kernel for this linear layer type; "
@@ -699,7 +705,42 @@ def choose_scaled_mm_linear_kernel(
             scope="global",
         )
 
-    platform_kernels = possible_kernels.get(current_platform._enum, [])
+    platform_kernels = possible_kernels.get(current_platform._enum)
+    if platform_kernels is None and current_platform.is_musa():
+        if possible_kernels is _POSSIBLE_FP8_BLOCK_KERNELS:
+            from vllm_musa.model_executor.kernels.linear.scaled_mm.deep_gemm import (
+                MUSADeepGemmFp8BlockScaledMMKernel,
+            )
+
+            platform_kernels = [
+                MUSADeepGemmFp8BlockScaledMMKernel,
+                TritonFp8BlockScaledMMKernel,
+            ]
+        elif possible_kernels is _POSSIBLE_FP8_KERNELS:
+            from vllm_musa.model_executor.kernels.linear.scaled_mm.torch_scaled_mm import (
+                MUSAChannelWiseTorchFP8ScaledMMLinearKernel,
+                MUSAPerTensorTorchFP8ScaledMMLinearKernel,
+                MUSARowWiseTorchFP8ScaledMMLinearKernel,
+            )
+
+            platform_kernels = [
+                MUSAPerTensorTorchFP8ScaledMMLinearKernel,
+                MUSARowWiseTorchFP8ScaledMMLinearKernel,
+                MUSAChannelWiseTorchFP8ScaledMMLinearKernel,
+            ]
+        elif possible_kernels is _POSSIBLE_INT8_KERNELS:
+            from vllm_musa.model_executor.kernels.linear.scaled_mm.torch_scaled_mm import (
+                MUSATorchInt8ScaledMMLinearKernel,
+            )
+
+            platform_kernels = [MUSATorchInt8ScaledMMLinearKernel]
+
+    if platform_kernels is None:
+        raise ValueError(
+            "Failed to find a kernel that can implement the "
+            "ScaledMM linear layer. No kernels are registered for "
+            f"platform {current_platform._enum.name}."
+        )
 
     # Apply --linear-backend filtering when set.
     platform_kernels = _resolve_backend_kernels(
