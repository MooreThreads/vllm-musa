+_running_on_musa = getattr(torch.version, "musa", None) is not None
+if _running_on_musa:
+    from mate.deep_gemm import tf32_hc_prenorm_gemm
+    from vllm_musa.deepseek_v4_jit.tilelang_kernels import (
+        ihc_post_kernel,
+        ihc_pre_big_fuse_decode_split_kernel,
+    )
+
+
+_MUSA_IHC_SPLITS = 32
+
+
+def _musa_ihc_prenorm_projection(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    output_size: int,
+    eps: float,
+) -> torch.Tensor | None:
+    """Fuse the decode iHC projection and input-square reduction on MUSA."""
+    if not _running_on_musa or x.shape[0] != 1:
+        return None
+
+    x_flat = x.flatten(1)
+    num_splits = _MUSA_IHC_SPLITS
+    num_tokens = x.shape[0]
+    d_partial = torch.empty(
+        (num_splits, num_tokens, output_size),
+        dtype=torch.float32,
+        device=x.device,
+    )
+    s_partial = torch.empty(
+        (num_splits, num_tokens), dtype=torch.float32, device=x.device
+    )
+    tf32_hc_prenorm_gemm(
+        x_flat,
+        weight,
+        d_partial,
+        s_partial,
+        num_splits=num_splits,
+    )
+    d = d_partial.sum(dim=0)
+    rms_recip = torch.rsqrt(s_partial.sum(dim=0).unsqueeze(-1) / x_flat.shape[-1] + eps)
+    return d * rms_recip
+
+
+def _musa_ihc_pre(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    hc_scale: torch.Tensor,
+    hc_base: torch.Tensor,
+    hc_eps: float,
+    magnitude: float,
+    rms_eps: float,
+) -> tuple[torch.Tensor, torch.Tensor] | None:
+    """Fuse the full single-token iHC pre path on MUSA."""
+    if (
+        not _running_on_musa
+        or x.device.type != "musa"
+        or weight.device != x.device
+        or hc_scale.device != x.device
+        or hc_base.device != x.device
+        or x.shape[0] != 1
+        or x.shape[1:] != (4, 6144)
+        or weight.shape != (8, 24576)
+        or hc_scale.shape != (2,)
+        or hc_base.shape != (8,)
+        or x.dtype != torch.bfloat16
+        or weight.dtype != torch.float32
+        or hc_scale.dtype != torch.float32
+        or hc_base.dtype != torch.float32
+        or not x.is_contiguous()
+        or not weight.is_contiguous()
+    ):
+        return None
+
+    num_tokens = x.shape[0]
+    d_partial = torch.empty(
+        (_MUSA_IHC_SPLITS, num_tokens, 8),
+        dtype=torch.float32,
+        device=x.device,
+    )
+    s_partial = torch.empty(
+        (_MUSA_IHC_SPLITS, num_tokens), dtype=torch.float32, device=x.device
+    )
+    post = torch.empty((num_tokens, 4), dtype=torch.float32, device=x.device)
+    layer_input = torch.empty((num_tokens, 6144), dtype=torch.bfloat16, device=x.device)
+    tf32_hc_prenorm_gemm(
+        x.flatten(1),
+        weight,
+        d_partial,
+        s_partial,
+        num_splits=_MUSA_IHC_SPLITS,
+    )
+    ihc_pre_big_fuse_decode_split_kernel(
+        hidden_size=6144,
+        rms_eps=rms_eps,
+        hc_eps=hc_eps,
+        magnitude=magnitude,
+        n_splits=_MUSA_IHC_SPLITS,
+    )(d_partial, s_partial, hc_scale, hc_base, x, post, layer_input)
+    return layer_input, post
+
+
+def _musa_ihc_post(
+    x: torch.Tensor, residual: torch.Tensor, post: torch.Tensor
+) -> torch.Tensor | None:
+    """Fuse the single-token iHC post gate and residual add on MUSA."""
+    if (
+        not _running_on_musa
+        or x.device.type != "musa"
+        or residual.device != x.device
+        or post.device != x.device
+        or x.shape[0] != 1
+        or x.shape[1:] != (6144,)
+        or residual.shape != (x.shape[0], 4, 6144)
+        or post.shape != (x.shape[0], 4)
+        or x.dtype != torch.bfloat16
+        or residual.dtype != torch.bfloat16
+        or post.dtype != torch.float32
+        or not x.is_contiguous()
+        or not residual.is_contiguous()
+        or not post.is_contiguous()
+    ):
+        return None
+
+    out = torch.empty_like(residual)
+    ihc_post_kernel(hidden_size=6144)(x, residual, post, out)
+    return out
+
 
