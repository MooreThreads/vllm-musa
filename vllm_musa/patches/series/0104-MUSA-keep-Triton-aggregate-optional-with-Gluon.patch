From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Wed, 19 Aug 2026 18:49:36 +0800
Subject: [PATCH] MUSA: keep Triton aggregate optional with Gluon

---
 vllm/triton_utils/__init__.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/vllm/triton_utils/__init__.py b/vllm/triton_utils/__init__.py
index 671b4a6..64f7f59 100644
--- a/vllm/triton_utils/__init__.py
+++ b/vllm/triton_utils/__init__.py
@@ -12,11 +12,11 @@ if TYPE_CHECKING or HAS_TRITON:
     import triton
     import triton.language as tl
     import triton.language.extra.libdevice as tldevice
-    from triton.language.core import _aggregate as aggregate  # noqa: E501
 
     try:
         from triton.experimental import gluon
         from triton.experimental.gluon import language as gl
+        from triton.language.core import _aggregate as aggregate  # noqa: E501
     except ImportError:
         # The MUSA Torch 2.11 stack uses Triton 3.2, which predates Gluon.
         # Gluon is only consumed by platform-specific AMD kernels, so keep
@@ -24,6 +24,7 @@ if TYPE_CHECKING or HAS_TRITON:
         # through the same explicit placeholder as a Triton-less install.
         gluon = TritonLanguagePlaceholder()
         gl = TritonLanguagePlaceholder()
+        aggregate = TritonLanguagePlaceholder()
 else:
     triton = TritonPlaceholder()
     tl = TritonLanguagePlaceholder()
