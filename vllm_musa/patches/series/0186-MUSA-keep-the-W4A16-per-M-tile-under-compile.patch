From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Mon, 12 Oct 2026 13:20:12 +0800
Subject: [PATCH] MUSA: keep the W4A16 per-M tile under compile

apply_weights() picks its tile from the runtime M through a Python branch. Under
torch.compile Dynamo inlines that branch into the traced graph, so the choice is frozen at
the size profiled during warmup (16384) and every later forward replays the large-M tile -
including batch-1 decode, which then never reaches the small-M path at all.

Run the GEMM through a torch.library.custom_op instead. Dynamo cannot inline a custom op,
so the decision is re-evaluated on every call, and cudagraph capture happens per capture
size: the batch-1 graph bakes the M=1 tile. On platforms without the wrapper the module
keeps exporting the plain launcher under the original name.

qzeros is optional in the launcher but custom-op schemas need a real Tensor, so an empty
int32 tensor carries the symmetric case.
---
 .../linear/mixed_precision/triton_w4a16.py    | 38 ++++++++++++++++++-
 1 file changed, 37 insertions(+), 1 deletion(-)

diff --git a/vllm/model_executor/kernels/linear/mixed_precision/triton_w4a16.py b/vllm/model_executor/kernels/linear/mixed_precision/triton_w4a16.py
index 18407152ad..2db66ceb1d 100644
--- a/vllm/model_executor/kernels/linear/mixed_precision/triton_w4a16.py
+++ b/vllm/model_executor/kernels/linear/mixed_precision/triton_w4a16.py
@@ -248,7 +248,7 @@ def triton_w4a16_gemm_kernel(
     tl.store(c_ptrs, c, mask=mask_c)
 
 
-def triton_w4a16_gemm(
+def _w4a16_launch(
     a: torch.Tensor,  # [M, K] fp16/bf16
     b_q: torch.Tensor,  # [K, N//8] int32
     scales: torch.Tensor,  # [K//G, N] fp16/bf16
@@ -592,3 +592,39 @@ class TritonW4A16LinearKernel(MPLinearKernel):
             output.add_(bias)
 
         return output.reshape(out_shape)
+
+
+_musa_check = getattr(current_platform, "is_musa", None)
+_is_musa = callable(_musa_check) and _musa_check()
+if _is_musa:
+    from torch.library import custom_op
+
+    @custom_op("vllm_musa::triton_w4a16_gemm_runtime", mutates_args=())
+    def _triton_w4a16_gemm_runtime_op(
+        a: torch.Tensor,
+        b_q: torch.Tensor,
+        scales: torch.Tensor,
+        qzeros: torch.Tensor,
+        group_size: int,
+        zp_bias: int,
+    ) -> torch.Tensor:
+        # Runs on every call / every cudagraph capture, so the tile and split-K
+        # decisions below see the real runtime M instead of the trace-time M.
+        qz = None if qzeros.numel() == 0 else qzeros
+        return _w4a16_launch(a, b_q, scales, qz, group_size, zp_bias)
+
+    @_triton_w4a16_gemm_runtime_op.register_fake
+    def _triton_w4a16_gemm_runtime_fake(a, b_q, scales, qzeros, group_size, zp_bias):
+        return a.new_empty((a.shape[0], b_q.shape[1] * 8))
+
+    def triton_w4a16_gemm(a, b_q, scales, qzeros, group_size, zp_bias=8):
+        """Runtime-dispatched W4A16 GEMM (see the docstring of ``_w4a16_launch``)."""
+        if qzeros is None:
+            # custom_op schemas need a real Tensor; an empty one means "symmetric".
+            qzeros = a.new_empty(0, dtype=torch.int32)
+        return _triton_w4a16_gemm_runtime_op(a, b_q, scales, qzeros, group_size, zp_bias)
+else:
+    # Other platforms (ROCm) keep the plain Triton launcher: apply_weights()
+    # calls triton_w4a16_gemm by name either way.
+    triton_w4a16_gemm = _w4a16_launch
+
