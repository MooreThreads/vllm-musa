+def test_musa_mamba_pool_holds_align_snapshots(
+    monkeypatch, overrides, blocks_per_request
+):
+    monkeypatch.setattr(
+        kv_cache_utils, "musa_mamba_separate_pool_enabled", lambda: True
+    )
+    if "retention" in overrides:
+        monkeypatch.setenv(
+            "VLLM_PREFIX_CACHE_RETENTION_INTERVAL", str(overrides["retention"])
+        )
+    else:
+        monkeypatch.delenv("VLLM_PREFIX_CACHE_RETENTION_INTERVAL", raising=False)
+    mamba_cache_mode = overrides.get("mamba_cache_mode", "align")
+    config = SimpleNamespace(
+        cache_config=SimpleNamespace(
+            mamba_cache_mode=mamba_cache_mode,
+            enable_prefix_caching=mamba_cache_mode == "align",
+            prefix_match_unit=overrides.get("prefix_match_unit"),
+            num_gpu_blocks_override=4,
+        ),
+        model_config=SimpleNamespace(
+            max_model_len=overrides.get("max_model_len", 6144)
+        ),
+        scheduler_config=SimpleNamespace(max_num_seqs=2),
+        parallel_config=SimpleNamespace(decode_context_parallel_size=1),
+        kv_transfer_config=overrides.get("kv_transfer_config"),
+        max_concurrent_batches=overrides.get("max_concurrent_batches", 2),
+    )
+    mamba_spec = new_mamba_spec(
+        block_size=2176, num_speculative_blocks=6, mamba_cache_mode=mamba_cache_mode
+    )
+    attn_spec = new_kv_cache_spec(block_size=2176)
+    groups = [
+        KVCacheGroupSpec(["attn"], attn_spec),
+        KVCacheGroupSpec(["mamba0", "mamba1"], mamba_spec),
+    ]
+
+    # available_memory=0 takes the graph-profiling path, which keeps the full
+    # Mamba pool next to the override-sized attention pool.
+    _, _, mamba_num_blocks = kv_cache_utils._musa_separated_mamba_attn_tensors(
+        config, groups, 0
+    )
+    assert mamba_num_blocks == 2 * blocks_per_request + 1
+    # The memory estimate reserves the same Mamba pool plus one max-length
+    # attention request.
+    assert kv_cache_utils._max_memory_usage_bytes_from_groups(config, groups) == (
+        mamba_spec.page_size_bytes * mamba_num_blocks * 2
+        + attn_spec.max_memory_usage_bytes(config)
+    )
+
+
+def test_musa_mamba_memory_estimate_uses_shared_pool_for_other_connectors(
+    monkeypatch,
+):
+    """Without a dedicated Mamba pool the estimate follows the shared pool."""
+    monkeypatch.setattr(
+        kv_cache_utils, "musa_mamba_separate_pool_enabled", lambda: True
+    )
+    attn_spec = new_kv_cache_spec(block_size=16)
+    mamba_spec = new_mamba_spec(block_size=16, mamba_cache_mode="align")
+    assert attn_spec.page_size_bytes == mamba_spec.page_size_bytes
+    groups = [
+        KVCacheGroupSpec(["attn"], attn_spec),
+        KVCacheGroupSpec(["mamba"], mamba_spec),
+    ]
+    config = SimpleNamespace(
+        cache_config=SimpleNamespace(mamba_cache_mode="align"),
+        model_config=SimpleNamespace(max_model_len=1024),
+        scheduler_config=SimpleNamespace(max_num_seqs=8),
+        parallel_config=SimpleNamespace(decode_context_parallel_size=1),
+        kv_transfer_config=SimpleNamespace(kv_connector="NixlConnector"),
+    )
+
+    # One max-length attention request plus one Mamba window of 2 + 2
+    # speculative blocks, not a per-running-request Mamba reservation.
+    page = attn_spec.page_size_bytes
+    assert kv_cache_utils._max_memory_usage_bytes_from_groups(
+        config, groups
+    ) == page * (1024 // 16 + 2 + 2)
