From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Sat, 7 Nov 2026 10:30:00 +0800
Subject: [PATCH] MUSA: avoid MCCL groups in DP/EP all2all collectives

MCCL can hang when one group holds collectives of small tensors, which
the data-parallel MoE all2all issues: the dispatch gathers several
tensors in one group, and all_gatherv/reduce_scatterv for uneven
per-rank sizes group one broadcast or reduce per rank. On MUSA, gather
a batch tensor by tensor, and serve uneven sizes with one all_gather or
reduce_scatter over rows padded to the largest size.
---
 .../device_communicators/cuda_communicator.py |  8 ++-
 .../device_communicators/pynccl.py            | 62 +++++++++++++++++++
 2 files changed, 68 insertions(+), 2 deletions(-)

diff --git a/vllm/distributed/device_communicators/cuda_communicator.py b/vllm/distributed/device_communicators/cuda_communicator.py
index 4c6cb64bdf..3f74a9b6e4 100644
--- a/vllm/distributed/device_communicators/cuda_communicator.py
+++ b/vllm/distributed/device_communicators/cuda_communicator.py
@@ -968,10 +968,14 @@ class CudaCommunicator(DeviceCommunicatorBase):
             return _all_gather_single(input_, sizes)
 
         output_list = []
-        pynccl_comm.group_start()
+        # MUSA: MCCL can hang on a group of all-gathers of small tensors.
+        grouped = current_platform.device_type != "musa"
+        if grouped:
+            pynccl_comm.group_start()
         for inp in input_:
             output_list.append(_all_gather_single(inp, sizes=sizes))
-        pynccl_comm.group_end()
+        if grouped:
+            pynccl_comm.group_end()
 
         return output_list
 
diff --git a/vllm/distributed/device_communicators/pynccl.py b/vllm/distributed/device_communicators/pynccl.py
index 76eeb2291f..81581b0397 100644
--- a/vllm/distributed/device_communicators/pynccl.py
+++ b/vllm/distributed/device_communicators/pynccl.py
@@ -23,6 +23,7 @@ from vllm.distributed.device_communicators.pynccl_wrapper import (
 )
 from vllm.distributed.utils import StatelessProcessGroup
 from vllm.logger import init_logger
+from vllm.platforms import current_platform
 from vllm.utils.torch_utils import current_stream
 
 logger = init_logger(__name__)
@@ -340,6 +341,11 @@ class PyNcclCommunicator:
         if stream is None:
             stream = current_stream()
         assert output_tensor.shape[0] == sum(sizes)
+        if current_platform.device_type == "musa":
+            # MUSA: MCCL can hang on a group of small broadcasts, so gather
+            # the rows padded to the largest size in one all_gather.
+            self._all_gatherv_padded(output_tensor, input_tensor, sizes, stream)
+            return
         split_offset = 0
         self.nccl.ncclGroupStart()
         for root, split_size in enumerate(sizes):
@@ -403,6 +409,13 @@ class PyNcclCommunicator:
         )
         if stream is None:
             stream = current_stream()
+        if current_platform.device_type == "musa":
+            # MUSA: see all_gatherv; reduce the rows padded to the largest
+            # size in one reduce_scatter.
+            self._reduce_scatterv_padded(
+                output_tensor, input_tensor, sizes, op, stream
+            )
+            return
 
         split_offset = 0
         self.nccl.ncclGroupStart()
@@ -421,6 +434,55 @@ class PyNcclCommunicator:
             split_offset += split_size
         self.nccl.ncclGroupEnd()
 
+    def _all_gatherv_padded(
+        self,
+        output_tensor: torch.Tensor,
+        input_tensor: torch.Tensor,
+        sizes: list[int],
+        stream,
+    ) -> None:
+        max_size = max(sizes)
+        if max_size == 0:
+            return
+        rows = input_tensor.shape[1:]
+        with torch.cuda.stream(stream):
+            padded = input_tensor.new_empty((max_size, *rows))
+            padded[: input_tensor.shape[0]].copy_(input_tensor)
+            gathered = input_tensor.new_empty((max_size * self.world_size, *rows))
+            self.all_gather(gathered, padded, stream=stream)
+            offset = 0
+            for rank, size in enumerate(sizes):
+                start = rank * max_size
+                output_tensor[offset : offset + size].copy_(
+                    gathered[start : start + size]
+                )
+                offset += size
+
+    def _reduce_scatterv_padded(
+        self,
+        output_tensor: torch.Tensor,
+        input_tensor: torch.Tensor,
+        sizes: list[int],
+        op: ReduceOp,
+        stream,
+    ) -> None:
+        max_size = max(sizes)
+        if max_size == 0:
+            return
+        rows = input_tensor.shape[1:]
+        with torch.cuda.stream(stream):
+            padded = input_tensor.new_empty((max_size * self.world_size, *rows))
+            offset = 0
+            for rank, size in enumerate(sizes):
+                start = rank * max_size
+                padded[start : start + size].copy_(
+                    input_tensor[offset : offset + size]
+                )
+                offset += size
+            reduced = input_tensor.new_empty((max_size, *rows))
+            self.reduce_scatter(reduced, padded, op=op, stream=stream)
+            output_tensor.copy_(reduced[: output_tensor.shape[0]])
+
     def reduce(
         self,
         output_tensor: torch.Tensor,
