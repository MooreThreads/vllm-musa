From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Thu, 20 Aug 2026 15:35:00 +0800
Subject: [PATCH] MUSA: scalarize stochastic rejection predicate

MUSA Triton can retain the stochastic acceptance predicate as a one-element
block after combining the probability ratio with the valid-draft mask. Reduce
it to a scalar before updating the loop-carried accepted-length state.
---
 vllm/v1/worker/gpu/spec_decode/rejection_sampler_utils.py | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/vllm/v1/worker/gpu/spec_decode/rejection_sampler_utils.py b/vllm/v1/worker/gpu/spec_decode/rejection_sampler_utils.py
index 9a9f092f66..c2857861bc 100644
--- a/vllm/v1/worker/gpu/spec_decode/rejection_sampler_utils.py
+++ b/vllm/v1/worker/gpu/spec_decode/rejection_sampler_utils.py
@@ -665,6 +665,8 @@ def _rejection_kernel(
                     # Probability ratio test: p(x) > u * q(x)
                     # Equivalent log form: log_p(x) > log(u) + log_q(x)
                     accepted = target_logprob > tl.log(u) + draft_logprob
+                accepted |= tl.zeros((1,), tl.int1)
+                accepted = tl.sum(accepted.to(tl.int32), axis=0) != 0
                 verifying = accepted
                 accepted_length += accepted
                 tl.store(sampled_ptr + req_idx * sampled_stride + i, draft_sampled)
