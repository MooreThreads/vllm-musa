+def _musa_router_projection(
+    hidden_states: torch.Tensor, weight: torch.Tensor
+) -> torch.Tensor | None:
+    """Run the single-token FP32 router projection with split-K on MUSA."""
+    if (
+        not _running_on_musa
+        or hidden_states.device.type != "musa"
+        or weight.device != hidden_states.device
+        or hidden_states.shape[0] != 1
+        or hidden_states.shape[1:] != (6144,)
+        or weight.shape != (256, 6144)
+        or hidden_states.dtype != torch.bfloat16
+        or weight.dtype != torch.float32
+        or not hidden_states.is_contiguous()
+        or not weight.is_contiguous()
+    ):
+        return None
+
+    num_splits = 16
+    num_tokens = hidden_states.shape[0]
+    partial = torch.empty(
+        (num_splits, num_tokens, weight.shape[0]),
+        dtype=torch.float32,
+        device=hidden_states.device,
+    )
+    sqr_sum = torch.empty(
+        (num_splits, num_tokens),
+        dtype=torch.float32,
+        device=hidden_states.device,
+    )
+    tf32_hc_prenorm_gemm(
+        hidden_states,
+        weight,
+        partial,
+        sqr_sum,
+        num_splits=num_splits,
+    )
+    return partial.sum(dim=0)
+
 
