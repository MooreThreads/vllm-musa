From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Sat, 11 Jul 2026 13:30:00 +0800
Subject: [PATCH] MUSA: allow Gemma RMSNorm residual donation

Route residual Gemma RMSNorm through the same maybe-inplace IR contract used
by ordinary RMSNorm. The pre-AOT functionalization pass validates activation
liveness, while backend providers independently select profitable kernels.
---
 vllm/model_executor/layers/layernorm.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/vllm/model_executor/layers/layernorm.py b/vllm/model_executor/layers/layernorm.py
index 5f9e763af0..3a1d202b2a 100644
--- a/vllm/model_executor/layers/layernorm.py
+++ b/vllm/model_executor/layers/layernorm.py
@@ -157,7 +157,9 @@ class GemmaRMSNorm(CustomOp):
         weight = self.weight.float() + 1.0
         if residual is None:
             return ir.ops.rms_norm(x, weight, self.variance_epsilon)
-        return ir.ops.fused_add_rms_norm(x, residual, weight, self.variance_epsilon)
+        return ir.ops.fused_add_rms_norm.maybe_inplace(
+            x, residual, weight, self.variance_epsilon
+        )
 
     def forward_cuda(
         self,
