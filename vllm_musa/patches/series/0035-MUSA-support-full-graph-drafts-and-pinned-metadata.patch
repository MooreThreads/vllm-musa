+                # / PR #34880: enable FULL-mode draft capture when padded
+                # drafter batch and draft FULL wrapping are enabled (default ON
+                # for Eagle/Eagle3, OFF for MTP on MUSA).
+                import os as _eagle_os
+
+                _draft_full_default = (
+                    "1"
+                    if (
+                        not current_platform.is_musa()
+                        or self.speculative_config.method
+                        in ("eagle", "eagle3", "dflash")
+                    )
+                    else "0"
+                )
+                self.supports_sd_full_graph = (
+                    not self.speculative_config.disable_padded_drafter_batch
