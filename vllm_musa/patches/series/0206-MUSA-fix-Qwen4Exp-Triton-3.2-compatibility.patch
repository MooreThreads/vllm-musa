 vllm/models/qwen4_exp/common/qsa_cache.py     | 136 +++++++++++-------
 .../qwen4_exp/nvidia/ops/qsa_indexer.py       |  24 +++-
 3 files changed, 108 insertions(+), 59 deletions(-)

diff --git a/vllm/models/qwen4_exp/common/ngram_embedding.py b/vllm/models/qwen4_exp/common/ngram_embedding.py
index 85a382c5ec..cdd3c40e08 100644
--- a/vllm/models/qwen4_exp/common/ngram_embedding.py
+++ b/vllm/models/qwen4_exp/common/ngram_embedding.py
@@ -376,9 +376,9 @@ class Qwen4ExpPLEDeviceEmbedding(Qwen4ExpPLEEmbedding):
 
 @triton.jit
 def _lookup_ple_embedding_from_pinned_kernel(
-    weight_ptr: tl.pointer_type(tl.uint8),  # type: ignore[valid-type]
+    weight_ptr,
     ids_ptr,
-    output_ptr: tl.pointer_type(tl.uint8),  # type: ignore[valid-type]
+    output_ptr,
     row_bytes,
     tp_vocab_start,
     tp_vocab_end,
@@ -388,7 +388,10 @@ def _lookup_ple_embedding_from_pinned_kernel(
 
     Byte pointers keep the storage dtype out of the kernel signature, so
     dtypes Triton cannot lower on the GPU (FP8 E4M3FN before SM89) still work.
+    MUSA: Triton 3.2 cannot parse pointer annotations, so cast in the body.
     """
+    weight_ptr = weight_ptr.to(tl.pointer_type(tl.uint8))
+    output_ptr = output_ptr.to(tl.pointer_type(tl.uint8))
     row_id = tl.program_id(0).to(tl.int64)
     global_idx = tl.load(ids_ptr + row_id)
     in_range = (global_idx >= tp_vocab_start) & (global_idx < tp_vocab_end)
diff --git a/vllm/models/qwen4_exp/common/qsa_cache.py b/vllm/models/qwen4_exp/common/qsa_cache.py
index f960dea071..b214e1dd52 100644
--- a/vllm/models/qwen4_exp/common/qsa_cache.py
+++ b/vllm/models/qwen4_exp/common/qsa_cache.py
@@ -189,6 +189,25 @@ def compressed_qsa_slot_mapping(
     return slots
 
 
+if hasattr(tl, "gather"):
+
+    @triton.jit
+    def _gather_1d(src, index, BLOCK_SRC: tl.constexpr):
+        return tl.gather(src, index, 0)
+
+else:
+
+    @triton.jit
+    def _gather_1d(src, index, BLOCK_SRC: tl.constexpr):
+        """Gather from a 1-D register vector without ``tl.gather``."""
+        src_idx = tl.arange(0, BLOCK_SRC)
+        out = tl.zeros_like(index)
+        for i in tl.range(0, BLOCK_SRC):
+            value = tl.sum(tl.where(src_idx == i, src, 0), axis=0)
+            out = tl.where(index == i, value, out)
+        return out
+
+
