+    def _prepare_decode_step_attn_metadata(
+        self,
+        common_attn_metadata: CommonAttentionMetadata,
+        batch_size: int,
+        input_batch_size: int,
+        cudagraph_runtime_mode: CUDAGraphMode,
+        num_rejected_tokens_gpu: torch.Tensor | None = None,
+    ) -> CommonAttentionMetadata:
+        padded_batch_size = (
+            input_batch_size
+            if cudagraph_runtime_mode == CUDAGraphMode.FULL
+            else batch_size
+        )
+        self._draft_query_start_loc.np[: batch_size + 1] = self.token_arange_np[
+            : batch_size + 1
+        ]
+        if padded_batch_size > batch_size:
+            self._draft_query_start_loc.np[
+                batch_size + 1 : padded_batch_size + 1
+            ] = batch_size
+        self._draft_query_start_loc.copy_to_gpu(padded_batch_size + 1)
+
+        self._draft_seq_lens[:batch_size].copy_(
+            common_attn_metadata.seq_lens[:batch_size]
+        )
+        if self.num_speculative_tokens > 1 and num_rejected_tokens_gpu is not None:
+            self._draft_seq_lens[:batch_size] -= num_rejected_tokens_gpu
+        if padded_batch_size > batch_size:
+            self._draft_seq_lens[batch_size:padded_batch_size].zero_()
+
+        runner = getattr(self, "runner", None)
+        blk_table_tensor = common_attn_metadata.block_table_tensor
+        seq_lens_cpu_ub = common_attn_metadata.seq_lens_cpu_upper_bound
+        is_prefilling = common_attn_metadata.is_prefilling
+        if padded_batch_size > batch_size and runner is not None:
+            if self.kv_cache_gid >= 0:
+                blk_table_tensor = runner.input_batch.block_table[
+                    self.kv_cache_gid
+                ].get_device_tensor(padded_batch_size)
+                blk_table_tensor[batch_size:padded_batch_size].zero_()
+            if seq_lens_cpu_ub is not None:
+                runner.optimistic_seq_lens_cpu[
+                    batch_size:padded_batch_size
+                ].zero_()
+                seq_lens_cpu_ub = runner.optimistic_seq_lens_cpu[:padded_batch_size]
+        else:
+            blk_table_tensor = blk_table_tensor[:padded_batch_size]
+            if seq_lens_cpu_ub is not None:
+                seq_lens_cpu_ub = seq_lens_cpu_ub[:padded_batch_size]
+
+        if (
+            is_prefilling is not None
+            and self.vllm_config.parallel_config.prefill_context_parallel_size <= 1
+        ):
+            is_prefilling = None
+
+        if input_batch_size > batch_size:
+            self._slot_mapping_buffer[batch_size:input_batch_size].fill_(
+                PADDING_SLOT_ID
+            )
+
+        return common_attn_metadata.replace(
+            query_start_loc=self._draft_query_start_loc.gpu[
+                : padded_batch_size + 1
+            ],
+            query_start_loc_cpu=self._draft_query_start_loc.cpu[
+                : padded_batch_size + 1
+            ],
+            seq_lens=self._draft_seq_lens[:padded_batch_size],
+            seq_lens_cpu_upper_bound=seq_lens_cpu_ub,
+            num_reqs=padded_batch_size,
+            num_actual_tokens=padded_batch_size,
+            max_query_len=1,
+            block_table_tensor=blk_table_tensor,
+            slot_mapping=self._slot_mapping_buffer[:input_batch_size],
+            is_prefilling=is_prefilling,
+        )
 
