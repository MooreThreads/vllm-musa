+        if not out_req_ids:
+            return None
+
+        wanted = set(out_req_ids)
+        remaining: deque[
+            tuple[torch.cuda.Stream, torch.cuda.Event, list[str], int]
+        ] = deque()
+        while self._pending_copies:
+            stream, event, copy_req_ids, copy_id = self._pending_copies.popleft()
+            if wanted.intersection(copy_req_ids):
