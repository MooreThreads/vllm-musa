+def test_musa_mamba_align_keeps_hashed_snapshot_on_repeated_skip():
+    """Repeated align retirement must not free a hashed boundary snapshot."""
+    from vllm.v1.core.single_type_kv_cache_manager import MambaManager
+
+    block_size = 16
+    pool = BlockPool(
+        num_gpu_blocks=4,
+        enable_caching=True,
+        hash_block_size=block_size,
+    )
+    blocks = pool.get_new_blocks(2)
+    blocks[0].set_block_hash(
+        make_block_hash_with_group_id(BlockHash(b"x" * 32), 1),
+        block_size,
+    )
+
+    manager = object.__new__(MambaManager)
+    manager.mamba_cache_mode = "align"
+    manager.block_size = block_size
+    manager.kv_cache_spec = MambaSpec(
+        block_size=block_size,
+        shapes=(1, 1),
+        dtypes=(torch.float32,),
+        mamba_cache_mode="align",
+    )
+    manager.block_pool = pool
+    manager.req_to_blocks = {"request": blocks}
+    manager._null_block = pool.null_block
+    manager.last_state_block_idx = {"request": 0}
+    manager._num_retired_blocks = {}
+
+    manager.remove_skipped_blocks("request", 48)
+    manager.remove_skipped_blocks("request", 48)
+
+    assert blocks[0] is not pool.null_block
+    assert blocks[0].block_hash is not None
+    assert blocks[0].ref_cnt == 1
+
