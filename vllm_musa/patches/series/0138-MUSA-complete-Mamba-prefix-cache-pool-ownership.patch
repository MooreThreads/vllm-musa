+def _musa_mamba_blocks_per_request(vllm_config, kv_cache_groups) -> int:
+    """Peak number of dedicated-pool blocks one running request can hold."""
+    mamba_specs = [
+        g.kv_cache_spec
+        for g in kv_cache_groups
+        if isinstance(g.kv_cache_spec, MambaSpec)
+    ]
+    mamba_page = get_uniform_page_size(mamba_specs)
+    num_blocks = max(
+        cdiv(spec.max_memory_usage_bytes(vllm_config), mamba_page)
+        for spec in mamba_specs
+    )
+    cache_config = vllm_config.cache_config
+    if cache_config.mamba_cache_mode != "align":
+        return num_blocks
+
+    # A request's block table never exceeds its row; the copy blocks added
+    # below are held outside it.
+    max_model_len = vllm_config.model_config.max_model_len
+    row_blocks = max(
+        spec.max_num_blocks_per_req(vllm_config, max_model_len) for spec in mamba_specs
+    )
+    if envs.VLLM_PREFIX_CACHE_RETENTION_INTERVAL:
+        # Every retained segment snapshot stays referenced until the request
+        # finishes.
+        num_blocks = row_blocks
+    else:
+        # Beyond the resident window, the prefix-hit, shared-prefix and
+        # last-prompt-block snapshots stay referenced until the request
+        # finishes, and each extra in-flight batch can still hold one retired
+        # running-state block.
+        num_blocks = min(
+            row_blocks, num_blocks + 3 + vllm_config.max_concurrent_batches - 1
+        )
+
+    if cache_config.enable_prefix_caching or vllm_config.kv_transfer_config is not None:
+        # Same hash granularity as resolve_kv_cache_block_sizes().
+        dcp = vllm_config.parallel_config.decode_context_parallel_size
+        hash_block_size = cache_config.prefix_match_unit or math.gcd(
+            *(
+                g.kv_cache_spec.block_size
+                * (dcp if isinstance(g.kv_cache_spec, AttentionSpec) else 1)
+                for g in kv_cache_groups
+            )
+        )
+        if hash_block_size < max(spec.block_size for spec in mamba_specs):
+            # A partial-block hit asks for one more block on the step that
+            # copies it and keeps the copy source until the copy has run.
+            num_blocks += 2
+            kv_transfer_config = vllm_config.kv_transfer_config
+            if kv_transfer_config is not None and kv_transfer_config.is_kv_producer:
+                # The producer also keeps its partial-tail block until the
+                # request finishes.
+                num_blocks += 1
+    return num_blocks
