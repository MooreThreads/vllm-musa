From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Wed, 28 Oct 2026 16:44:42 +0800
Subject: [PATCH] MUSA: initialize the Mamba2 profiling output

---
 vllm/model_executor/layers/mamba/mamba_mixer2.py | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/vllm/model_executor/layers/mamba/mamba_mixer2.py b/vllm/model_executor/layers/mamba/mamba_mixer2.py
index bee3aef37d..86042e389d 100644
--- a/vllm/model_executor/layers/mamba/mamba_mixer2.py
+++ b/vllm/model_executor/layers/mamba/mamba_mixer2.py
@@ -776,6 +776,11 @@ class MambaMixer2(MambaBase, PluggableLayer):
         if attn_metadata is None:
             # V1 profile run -- warm up SSD kernels so that autotuning
             # completes before SSM cache allocation.
+            if current_platform.is_musa():
+                # The caller consumes the supplied output buffer, not this
+                # method's return value, so initialize it before the profiling
+                # forward leaves it at whatever the allocator handed back.
+                output.zero_()
             self._warmup_ssd_kernels(projected_states)
             hidden_states_B_C = (
                 hidden_states_B_C.transpose(0, 1).clone().transpose(0, 1)
