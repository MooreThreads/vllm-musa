+++ b/tests/v1/core/test_kv_cache_utils.py
@@ -635,6 +635,103 @@ def new_mamba_spec(
     )
 
 
+@pytest.mark.parametrize(
+    ("mode", "speculative_blocks", "max_concurrent_batches", "expected_pool_blocks"),
+    [
+        ("none", 0, 2, 9),
+        ("align", 0, 1, 25),
+        ("align", 6, 2, 81),
+    ],
+)
+def test_musa_dedicated_mamba_pool_capacity_by_mode(
+    mode, speculative_blocks, max_concurrent_batches, expected_pool_blocks
+):
+    """Pin the mamba-pool block count for none/align pool ownership."""
+    mamba = new_mamba_spec(
+        block_size=64,
+        num_speculative_blocks=speculative_blocks,
+        mamba_cache_mode=mode,
+    )
+    attention = new_kv_cache_spec(block_size=64)
+    # The align sizing path reads all of these; a missing attribute raises
+    # AttributeError instead of pinning a block count.
+    config = SimpleNamespace(
+        cache_config=SimpleNamespace(
+            mamba_cache_mode=mode,
+            num_gpu_blocks_override=None,
+            enable_prefix_caching=False,
+            prefix_match_unit=None,
+            prefix_cache_retention_interval=0,
+        ),
+        scheduler_config=SimpleNamespace(max_num_seqs=8),
+        model_config=SimpleNamespace(max_model_len=131072),
+        parallel_config=SimpleNamespace(decode_context_parallel_size=1),
+        kv_transfer_config=None,
+        max_concurrent_batches=max_concurrent_batches,
+    )
+    groups = [
+        KVCacheGroupSpec(["mamba"], mamba),
+        KVCacheGroupSpec(["attention"], attention),
+    ]
+    tensors, _, mamba_pool_blocks = (
+        kv_cache_utils._musa_separated_mamba_attn_tensors(
+            config, groups, available_memory=64 * 1024 * 1024
+        )
+    )
+    assert mamba_pool_blocks == expected_pool_blocks
+    assert next(t for t in tensors if t.layers == ["mamba"]).size == (
+        mamba.page_size_bytes * mamba_pool_blocks
+    )
+
+
+def test_musa_pool_capacity_estimate_covers_the_dedicated_pool(monkeypatch):
+    """The startup capacity check must charge the fixed Mamba pool.
+
+    One request's resident footprint is not the reservation: the dedicated
+    pool is sized for every running request plus the null block.
+    """
+    monkeypatch.setattr(
+        kv_cache_utils, "_musa_separate_pool_eligible", lambda *args: True
+    )
+    mamba = new_mamba_spec(
+        block_size=64,
+        num_speculative_blocks=6,
+        mamba_cache_mode="align",
+    )
+    attention = new_kv_cache_spec(block_size=64)
+    config = SimpleNamespace(
+        cache_config=SimpleNamespace(
+            mamba_cache_mode="align",
+            num_gpu_blocks_override=None,
+            enable_prefix_caching=False,
+            prefix_match_unit=None,
+            prefix_cache_retention_interval=0,
+        ),
+        scheduler_config=SimpleNamespace(max_num_seqs=8),
+        model_config=SimpleNamespace(max_model_len=131072),
+        parallel_config=SimpleNamespace(decode_context_parallel_size=1),
+        kv_transfer_config=None,
+        max_concurrent_batches=2,
+    )
+    groups = [
+        KVCacheGroupSpec(["mamba"], mamba),
+        KVCacheGroupSpec(["attention"], attention),
+    ]
+    estimated = kv_cache_utils._max_memory_usage_bytes_from_groups(config, groups)
+    pool_blocks = 8 * 10 + 1  # max_num_seqs * blocks_per_req + null block
+    attention_blocks = (131072 + 63) // 64
+    assert estimated == (
+        mamba.page_size_bytes * pool_blocks
+        + attention.page_size_bytes * attention_blocks
+    )
+
+    # The estimate must grow with the pool. A per-request bound is independent
+    # of max_num_seqs and would be a flat line here.
+    config.scheduler_config.max_num_seqs = 256
+    wider = kv_cache_utils._max_memory_usage_bytes_from_groups(config, groups)
+    assert wider - estimated == (256 - 8) * 10 * mamba.page_size_bytes
+
+
