+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm.v1.worker.gpu.spec_decode.utils import DraftTokensHandler
+
+
+def _device() -> torch.device | None:
+    if hasattr(torch, "musa") and torch.musa.is_available():
+        return torch.device("musa")
+    if torch.cuda.is_available():
+        return torch.device("cuda")
+    return None
+
+
+DEVICE = _device()
+
+
+def _input_batch(req_ids: list[str], structured: bool):
+    return SimpleNamespace(
+        req_ids=req_ids, has_structured_output_reqs=structured
+    )
+
+
+def _set(
+    handler: DraftTokensHandler,
+    req_ids: list[str],
+    tokens: list[list[int]],
+    structured: bool,
+) -> None:
+    handler.set_draft_tokens(
+        _input_batch(req_ids, structured),
+        torch.tensor(tokens, device=DEVICE),
+    )
+
+
+def _begin_step(handler: DraftTokensHandler, req_ids: list[str]) -> None:
+    handler.begin_step(
+        SimpleNamespace(
+            pending_structured_output_tokens=False,
+            has_structured_output_spec_decode=True,
+            scheduled_spec_decode_tokens={req_id: [-1] for req_id in req_ids},
+        )
+    )
+
+
+@pytest.mark.skipif(DEVICE is None, reason="Requires a GPU device")
+def test_structured_drafts_survive_unstructured_set() -> None:
+    handler = DraftTokensHandler(DEVICE)
+    _set(handler, ["a", "b"], [[11, 12], [21, 22]], structured=True)
+    _set(handler, ["plain"], [[31, 32]], structured=False)
+
+    _begin_step(handler, ["a", "b", "plain"])
+    drafts = handler.get_draft_tokens()
+    assert drafts is not None
+    assert dict(zip(drafts.req_ids, drafts.draft_token_ids, strict=True)) == {
+        "a": [11, 12],
+        "b": [21, 22],
+        "plain": [-1, -1],
+    }
+
+
+@pytest.mark.skipif(DEVICE is None, reason="Requires a GPU device")
+def test_two_in_flight_sets_keep_their_own_event_and_rows() -> None:
+    handler = DraftTokensHandler(DEVICE)
+    _set(handler, ["a"], [[11, 12]], structured=True)
+    first_event = handler._pending_copies[0][1]
+    _set(handler, ["b"], [[21, 22]], structured=True)
+    second_event = handler._pending_copies[1][1]
+
+    # A shared, re-recorded event is the MUSA wait-delay bug: the second
+    # record() would make the first synchronize() wait on the second copy.
+    assert first_event is not second_event
+
+    _begin_step(handler, ["a", "b"])
+    drafts = handler.get_draft_tokens()
+    assert drafts is not None
+    assert dict(zip(drafts.req_ids, drafts.draft_token_ids, strict=True)) == {
+        "a": [11, 12],
+        "b": [21, 22],
+    }
+    assert not handler._pending_copies
+    assert len(handler._free_streams) == 2
+
+
+@pytest.mark.skipif(DEVICE is None, reason="Requires a GPU device")
+def test_discard_and_empty_get() -> None:
+    handler = DraftTokensHandler(DEVICE)
+    _set(handler, ["a", "b"], [[11, 12], [21, 22]], structured=True)
+    handler.discard("b")
+
+    _begin_step(handler, ["a"])
+    drafts = handler.get_draft_tokens()
+    assert drafts is not None
+    assert dict(zip(drafts.req_ids, drafts.draft_token_ids, strict=True)) == {
+        "a": [11, 12]
+    }
+
+    handler.discard("a")
+    _begin_step(handler, ["a"])
+    assert handler.get_draft_tokens() is None
