index dca14718a9..268f0a9596 100644
--- a/vllm/v1/worker/gpu/model_runner.py
+++ b/vllm/v1/worker/gpu/model_runner.py
@@ -789,7 +789,10 @@ class GPUModelRunner(LoRAModelRunnerMixin):
                 ),
             )
         self.kv_caches = [
-            cache for cache in kv_caches_dict.values() if cache.device == self.device
+            state
+            for cache in kv_caches_dict.values()
+            for state in (cache if isinstance(cache, (list, tuple)) else (cache,))
+            if state.device == self.device
         ]
         self.model_state.initialize_kv_cache(self.kv_cache_config, self.block_tables)
         if is_profiling:
diff --git a/vllm/v1/worker/utils.py b/vllm/v1/worker/utils.py
index ee1c8a1734..11c40499ba 100644
--- a/vllm/v1/worker/utils.py
+++ b/vllm/v1/worker/utils.py
