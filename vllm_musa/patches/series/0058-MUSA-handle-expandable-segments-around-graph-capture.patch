From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Mon, 26 Oct 2026 08:26:29 +0000
Subject: [PATCH] MUSA: handle expandable segments around graph capture

torch_musa's expandable-segment allocator cannot grow a segment while a
stream is being captured, which surfaces as a spurious OOM during graph
capture even when device memory is still available (e.g. a 2 MiB allocation
failing with several GiB free).

Expandable segments are still needed during profile_run to avoid
fragmentation OOMs, so keep them enabled there and switch to ordinary
segments around both capture sites: the throwaway graphs used to profile
graph memory and the real capture. Each toggle rewrites the allocator conf
the allocator last applied, changing only expandable_segments: parsing a
partial conf instead resets max_split_size, garbage_collection_threshold,
roundup_power2_divisions and max_non_split_rounding_size, and the snapshot
does not expose all of them. backend: tokens are dropped from the replay,
because the runtime parser asserts they name the backend chosen at load and
a settings call cannot change it.

The toggle reads the applied conf once per capture site and is skipped with
a warning when the allocator snapshot is unreadable or carries no applied
conf, or when the wheel lacks _set_allocator_settings, rather than silently
replaying a partial conf or doing nothing. The setting is restored after
the capture so later allocations keep the fragmentation benefit.
---
 vllm/v1/worker/gpu_worker.py | 93 ++++++++++++++++++++++++++++++++++--
 1 file changed, 90 insertions(+), 3 deletions(-)

diff --git a/vllm/v1/worker/gpu_worker.py b/vllm/v1/worker/gpu_worker.py
index 7f53e62247..02186a85b3 100644
--- a/vllm/v1/worker/gpu_worker.py
+++ b/vllm/v1/worker/gpu_worker.py
@@ -4,6 +4,7 @@
 
 import gc
 import os
+import re
 import time
 from collections.abc import Callable
 from contextlib import AbstractContextManager, contextmanager, nullcontext
@@ -114,6 +115,88 @@ from .utils import request_memory
 logger = init_logger(__name__)
 
 
+_MUSA_EXPANDABLE_SEGMENTS = re.compile(
+    r"expandable_segments\s*:\s*(?:true|false)", re.IGNORECASE
+)
+# The runtime parser asserts that a backend: token matches the backend chosen
+# at load, which a settings replay cannot change, so the token is dropped.
+_MUSA_BACKEND_TOKEN = re.compile(r"^\s*backend\s*:", re.IGNORECASE)
+
+
+def _musa_allocator_confs(settings: dict) -> tuple[str, str] | None:
+    """Replay the applied allocator conf with expandable segments off and on.
+
+    The setter resets the other allocator knobs unless they are included, so
+    rewrite the conf the allocator last applied instead of a partial one.
+    """
+    conf = settings.get("PYTORCH_MUSA_ALLOC_CONF")
+    if not conf:
+        return None
+    conf = ",".join(
+        token
+        for token in conf.split(",")
+        if token.strip() and not _MUSA_BACKEND_TOKEN.match(token)
+    )
+
+    def replay(expandable_segments: bool) -> str:
+        token = f"expandable_segments:{expandable_segments}"
+        if not conf:
+            return token
+        if _MUSA_EXPANDABLE_SEGMENTS.search(conf):
+            return _MUSA_EXPANDABLE_SEGMENTS.sub(token, conf, count=1)
+        return f"{conf},{token}"
+
+    return replay(False), replay(True)
+
+
+@contextmanager
+def _musa_ordinary_segments():
+    """Capture graphs on ordinary segments while MUSA uses expandable ones.
+
+    torch_musa cannot grow an expandable segment during stream capture, so the
+    profiling graphs and the real capture run on ordinary segments; the applied
+    setting is restored afterwards for the following allocations.
+    """
+    if not current_platform.is_musa():
+        yield
+        return
+    try:
+        settings = torch.musa.memory._snapshot()["allocator_settings"]
+    except Exception:
+        logger.warning(
+            "MUSA allocator settings are unreadable; capture keeps the "
+            "caller's allocator mode",
+            exc_info=True,
+        )
+        yield
+        return
+    if not settings.get("expandable_segments", False):
+        yield
+        return
+    set_settings = getattr(torch.musa.memory, "_set_allocator_settings", None)
+    if set_settings is None:
+        logger.warning_once(
+            "torch.musa.memory._set_allocator_settings is missing; graph "
+            "capture keeps the caller's allocator mode"
+        )
+        yield
+        return
+    confs = _musa_allocator_confs(settings)
+    if confs is None:
+        logger.warning(
+            "MUSA allocator snapshot has no applied config; capture keeps the "
+            "caller's allocator mode instead of replaying a partial one"
+        )
+        yield
+        return
+    capture_conf, restore_conf = confs
+    set_settings(capture_conf)
+    try:
+        yield
+    finally:
+        set_settings(restore_conf)
+
+
 def _musa_deepseek_v4_mtp_sparse_prefill_reserve_bytes(
     vllm_config: VllmConfig,
 ) -> int:
@@ -750,7 +833,10 @@ class Worker(WorkerBase):
         if (
             current_platform.is_cuda_alike() or current_platform.is_xpu()
         ) and self.vllm_config.compilation_config.cudagraph_mode != CUDAGraphMode.NONE:
-            cudagraph_memory_estimate = self.model_runner.profile_cudagraph_memory()
+            with _musa_ordinary_segments():
+                cudagraph_memory_estimate = (
+                    self.model_runner.profile_cudagraph_memory()
+                )
 
         # Respect the opt-in flag as originally designed.
         cudagraph_memory_estimate_applied = (
@@ -1035,8 +1121,9 @@ class Worker(WorkerBase):
 
         cuda_graph_memory_bytes = 0
         if not self.model_config.enforce_eager:
-            with self._get_cudagraph_capture_context():
-                cuda_graph_memory_bytes = self.model_runner.capture_model()
+            with _musa_ordinary_segments():
+                with self._get_cudagraph_capture_context():
+                    cuda_graph_memory_bytes = self.model_runner.capture_model()
 
         # Compare actual vs estimated CUDA graph memory (if we did profiling)
         if (
