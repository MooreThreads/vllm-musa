         kv_rows, block_stride_rows = flat_kv_row_view(
             kv_c_and_k_pe_cache, attn_metadata.block_size
         )
+        blocks_per_stride = (
+            kv_c_and_k_pe_cache.shape[1] // attn_metadata.block_size
