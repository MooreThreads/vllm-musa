From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Thu, 29 Oct 2026 10:59:31 +0800
Subject: [PATCH] MUSA: one contiguous block pool per Mamba state

The MUSA dedicated Mamba pool packs a layer's states into one page, so the
SSM view hands every kernel a page-sized block stride. GDN decode then
carries that stride into its per-layer state access, and the native Mamba2
SSU rejects the view outright because it only accepts a dense
[slots, heads, dim, dstate] pool.

Slice the same bytes state-major instead: each state of a layer becomes its
own contiguous block pool, which the existing list-valued bind path already
accepts. The runner keeps a flat list of pools, and the attention groups,
block zeroer and KV block copy all address a pool by its own stride, so no
other component changes.
---
 vllm/model_executor/layers/mamba/abstract.py | 12 +++--
 vllm/v1/worker/gpu/model_runner.py           |  5 +-
 vllm/v1/worker/utils.py                      | 57 ++++++++++++++++++--
 3 files changed, 64 insertions(+), 10 deletions(-)

diff --git a/vllm/model_executor/layers/mamba/abstract.py b/vllm/model_executor/layers/mamba/abstract.py
index 5322f899dd..d958b1d0e5 100644
--- a/vllm/model_executor/layers/mamba/abstract.py
+++ b/vllm/model_executor/layers/mamba/abstract.py
@@ -25,12 +25,14 @@ class MambaBase(AttentionLayerBase):
     kv_cache: tuple[torch.Tensor, ...]
     supports_dcp: bool = False
 
-    def bind_kv_cache(self, kv_cache: torch.Tensor) -> None:
-        """Unpack a raw ``[B, 1, 1, C]`` int8 page view into per-state views.
+    def bind_kv_cache(self, kv_cache: torch.Tensor | list[torch.Tensor]) -> None:
+        """Bind either packed pages or pre-carved dense Mamba state views."""
+        if isinstance(kv_cache, (list, tuple)):
+            self.kv_cache = tuple(kv_cache)
+            return
 
-        Each block's ``C`` bytes hold the layer's states (e.g. conv, ssm)
-        packed contiguously; slice them out and reinterpret per dtype/shape.
-        """
+        # Each block's ``C`` bytes hold the layer's states (e.g. conv, ssm)
+        # packed contiguously; slice them out and reinterpret per dtype/shape.
         pages = kv_cache.squeeze(dim=(1, 2))
         states: list[torch.Tensor] = []
         offset = 0
diff --git a/vllm/v1/worker/gpu/model_runner.py b/vllm/v1/worker/gpu/model_runner.py
