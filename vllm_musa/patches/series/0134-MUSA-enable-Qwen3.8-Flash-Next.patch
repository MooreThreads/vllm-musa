+            raise ValueError(
+                f"CSA+linear mamba cache owner {names[0]!r} needs "
+                f"{unpadded_page} bytes, but a main_kv tensor page has "
+                f"{main_kv_page} bytes."
+            )
+        num_groups = _get_csa_linear_mamba_group_count(
+            vllm_config, names, main_kv_names
