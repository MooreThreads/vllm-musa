From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Tue, 27 Oct 2026 10:43:11 +0800
Subject: [PATCH] MUSA: reuse FP8 input scale during graph capture

---
 .../kernels/linear/scaled_mm/BlockScaledMMLinearKernel.py | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/vllm/model_executor/kernels/linear/scaled_mm/BlockScaledMMLinearKernel.py b/vllm/model_executor/kernels/linear/scaled_mm/BlockScaledMMLinearKernel.py
index 865bebeada..ad323e3798 100644
--- a/vllm/model_executor/kernels/linear/scaled_mm/BlockScaledMMLinearKernel.py
+++ b/vllm/model_executor/kernels/linear/scaled_mm/BlockScaledMMLinearKernel.py
@@ -123,10 +123,10 @@ class Fp8BlockScaledMMLinearKernel(
             q_input = input_2d
             # Provide a concrete placeholder so apply_block_scaled_mm args are
             # always Tensors. Subclasses with apply_input_quant=False must not
-            # use As in apply_block_scaled_mm.
-            input_scale = (
-                input_scale if input_scale is not None else input_2d.new_empty(1)
-            )
+            # use As in apply_block_scaled_mm. Reuse an existing scale tensor
+            # because MUSA cannot allocate a new placeholder during graph
+            # capture.
+            input_scale = input_scale if input_scale is not None else weight_scale
 
         output = self.apply_block_scaled_mm(
             A=q_input,
