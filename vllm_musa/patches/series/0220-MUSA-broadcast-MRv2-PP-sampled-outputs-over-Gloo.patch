+def _load_musart_event_sync():
+    for soname in ("libmusart.so", "libmusart.so.2"):
+        try:
+            fn = ctypes.CDLL(soname).musaEventSynchronize
+            fn.argtypes, fn.restype = [ctypes.c_void_p], ctypes.c_int
+            return fn
+        except (OSError, AttributeError):
+            pass
+    return None
