From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Tue, 24 Nov 2026 17:14:23 +0800
Subject: [PATCH] MUSA: order MRv2 PP communicators

Delegate MUSA handler selection to the plugin on the MRv2 PP path.
Order feedback against worker-managed activation I/O and drain outstanding
slots before pause or shutdown. Keep the upstream handler as the default
on all other devices.
---
 vllm/v1/worker/gpu/model_runner.py | 11 ++++++++++-
 vllm/v1/worker/gpu/pp_utils.py     |  9 ++++++++-
 vllm/v1/worker/gpu_worker.py       | 18 ++++++++++++++++++
 3 files changed, 36 insertions(+), 2 deletions(-)

diff --git a/vllm/v1/worker/gpu/model_runner.py b/vllm/v1/worker/gpu/model_runner.py
index 029b413666..221da95664 100644
--- a/vllm/v1/worker/gpu/model_runner.py
+++ b/vllm/v1/worker/gpu/model_runner.py
@@ -333,11 +333,20 @@ class GPUModelRunner(LoRAModelRunnerMixin):
         )
         self.fast_prefill: FastPrefillHelper | None = None
         if self.use_pp:
-            self.pp_handler = PPHandler(
+            handler_cls = PPHandler
+            if current_platform.is_musa():
+                from vllm_musa.v1.worker.pp_handler import select_pp_handler
+
+                handler_cls = select_pp_handler(
+                    self.parallel_config, self.num_speculative_steps
+                )
+            self.pp_handler = handler_cls(
                 max_num_reqs=self.max_num_reqs,
                 num_speculative_steps=self.num_speculative_steps,
                 device=self.device,
             )
+            if handler_cls is not PPHandler:
+                self.musa_pp_handler = self.pp_handler
 
         # Samplers and decode_query_len created in load_model() after
         # model_state exists (num_new_sampled_tokens_per_step from ModelState).
diff --git a/vllm/v1/worker/gpu/pp_utils.py b/vllm/v1/worker/gpu/pp_utils.py
index 818d80759a..bcd7e61606 100644
--- a/vllm/v1/worker/gpu/pp_utils.py
+++ b/vllm/v1/worker/gpu/pp_utils.py
@@ -71,7 +71,7 @@ class PPHandler:
         self.num_speculative_steps = num_speculative_steps
         self.device = device
         self.main_stream = torch.cuda.current_stream(device)
-        self.broadcast_stream = torch.cuda.Stream(device)
+        self.broadcast_stream = self._make_broadcast_stream()
 
         # On non-last ranks, a FIFO with one entry per in-flight step: the entry
         # pushed by step T's `receive` is consumed pp_size steps later. Pre-seeded
@@ -96,6 +96,12 @@ class PPHandler:
         )
         self.aux_hidden_state_relay_keys: tuple[str, ...] = ()
 
+    def _make_broadcast_stream(self) -> torch.cuda.Stream:
+        return torch.cuda.Stream(self.device)
+
+    def _after_feedback_broadcast(self) -> None:
+        pass
+
     def on_req_idx_freed(self, req_idx: int) -> None:
         self.req_idx_gen_np[req_idx] += 1
 
@@ -276,5 +282,6 @@ class PPHandler:
             torch.distributed.broadcast(
                 combined, src=self.last_rank, group=self.broadcast_group
             )
+            self._after_feedback_broadcast()
             for tensor in (sampled_token_ids, num_sampled, num_rejected):
                 tensor.record_stream(self.broadcast_stream)
diff --git a/vllm/v1/worker/gpu_worker.py b/vllm/v1/worker/gpu_worker.py
index 02186a85b3..80eca428f4 100644
--- a/vllm/v1/worker/gpu_worker.py
+++ b/vllm/v1/worker/gpu_worker.py
@@ -368,6 +368,7 @@ class Worker(WorkerBase):
 
         # Device handles of the previous step's PP intermediate-tensor send.
         self._pp_send_work: list[Handle] = []
+        self._musa_pp_handler = None
 
         # Resolved lazily on first sleep/wake; persists worker-process state.
         self._sleep_mode_backend: SleepModeBackend | None = None
@@ -688,6 +689,7 @@ class Worker(WorkerBase):
             alloc_context=lambda: self._maybe_get_memory_pool_context("workspace"),
         )
         self.model_runner: GPUModelRunner = self._make_model_runner()
+        self._musa_pp_handler = getattr(self.model_runner, "musa_pp_handler", None)
         if self.rank == 0:
             # If usage stat is enabled, collect relevant info.
             report_usage_stats(self.vllm_config)
@@ -1476,6 +1478,8 @@ class Worker(WorkerBase):
         intermediate_tensors = None
         forward_pass = scheduler_output.total_num_scheduled_tokens > 0
         if forward_pass and not get_pp_group().is_first_rank:
+            if self._musa_pp_handler is not None:
+                self._musa_pp_handler.before_activation_recv()
             tensor_dict, comm_handles, comm_postprocess = (
                 get_pp_group().irecv_tensor_dict(
                     all_gather_group=get_tp_group(),
@@ -1513,6 +1517,8 @@ class Worker(WorkerBase):
         # Non-blocking send of the intermediate tensors. The metadata handle
         # is reaped lazily by the GroupCoordinator; the device handles are
         # waited at the top of the next step.
+        if self._musa_pp_handler is not None:
+            self._musa_pp_handler.submit_pending_feedback()
         handles = get_pp_group().isend_tensor_dict(
             output.tensors,
             all_gather_group=get_tp_group(),
@@ -1767,6 +1773,17 @@ class Worker(WorkerBase):
         if not self._weight_update_is_draft:
             self.model_runner.reset_lora_state()
 
+    def _drain_pp_feedback(self) -> None:
+        """Pause and shutdown can bypass the next step's activation-send wait."""
+        if self._musa_pp_handler is not None:
+            self._musa_pp_handler.submit_pending_feedback(
+                previous_sends=self._pp_send_work
+            )
+
+    def synchronize_device(self) -> None:
+        self._drain_pp_feedback()
+        super().synchronize_device()
+
     def shutdown(self) -> None:
         gc.unfreeze()
 
@@ -1786,6 +1803,7 @@ class Worker(WorkerBase):
         # Release GPU resources held by the model runner so that memory
         # can be reclaimed when running in-process
         if model_runner := getattr(self, "model_runner", None):
+            self._drain_pp_feedback()
             model_runner.shutdown()
 
         # Release kept-alive cumem pools while the pluggable allocator wrappers
