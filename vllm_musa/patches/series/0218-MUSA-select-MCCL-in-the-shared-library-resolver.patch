From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Thu, 19 Nov 2026 22:51:13 +0800
Subject: [PATCH] MUSA: select MCCL in the shared library resolver

Use libmccl.so.2 when no library path is specified on a MUSA build.
---
 vllm/utils/nccl.py | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/vllm/utils/nccl.py b/vllm/utils/nccl.py
index 1136661f6e..721ade7fcf 100644
--- a/vllm/utils/nccl.py
+++ b/vllm/utils/nccl.py
@@ -18,7 +18,7 @@ logger = init_logger(__name__)
 
 
 def find_nccl_library() -> str:
-    """Return NCCL/RCCL shared library name to load.
+    """Return the NCCL, RCCL, or MCCL shared library name to load.
 
     Uses `VLLM_NCCL_SO_PATH` if set; otherwise chooses by torch backend.
     """
@@ -32,8 +32,10 @@ def find_nccl_library() -> str:
             so_file = "libnccl.so.2"
         elif torch.version.hip is not None:
             so_file = "librccl.so.1"
+        elif getattr(torch.version, "musa", None) is not None:
+            so_file = "libmccl.so.2"
         else:
-            raise ValueError("NCCL only supports CUDA and ROCm backends.")
+            raise ValueError("NCCL only supports CUDA, ROCm, and MUSA backends.")
         logger.debug_once("Found nccl from library %s", so_file)
     return so_file
 
