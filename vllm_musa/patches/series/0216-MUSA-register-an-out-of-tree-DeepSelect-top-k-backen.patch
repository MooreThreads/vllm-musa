From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Sun, 22 Nov 2026 23:26:01 +0800
Subject: [PATCH] MUSA: register an out-of-tree DeepSelect top-k backend

---
 vllm/model_executor/layers/indexer_topk.py | 41 ++++++++++++++++++++----------
 1 file changed, 28 insertions(+), 13 deletions(-)

diff --git a/vllm/model_executor/layers/indexer_topk.py b/vllm/model_executor/layers/indexer_topk.py
index 02c4280ea0..26674bb274 100644
--- a/vllm/model_executor/layers/indexer_topk.py
+++ b/vllm/model_executor/layers/indexer_topk.py
@@ -43,14 +43,17 @@ def get_deep_select_stride_requirement() -> tuple[int, int]:
 
 def is_deep_select_supported(input: torch.Tensor, topk: int) -> bool:
     """Whether the kernel accepts this input (dtype/stride/topk constraints)."""
+    input_alignment, _ = get_deep_select_stride_requirement()
     return (
-        topk <= 4096
-        and input.shape[1] < 2**23
+        input.dim() == 2
+        and 0 < input.shape[1] < 2**23
+        and 0 < topk <= 4096
         and input.dtype in (torch.float32, torch.bfloat16)
         and input.stride(1) == 1
+        and input.storage_offset() * input.element_size() % input_alignment == 0
         and input.stride(0)
         * input.element_size()
-        % get_deep_select_stride_requirement()[0]
+        % input_alignment
         == 0
     )
 
@@ -80,8 +83,8 @@ def deep_select_topk(
 
     Args:
         input: (num_rows, vocab_size), bf16 or fp32. stride(1) must be 1 and
-            stride(0) must be 1024B-aligned.
-        topk: Number of elements to select per row; must be <= 4096.
+            stride(0) must satisfy the kernel's byte alignment requirement.
+        topk: Number of elements to select per row; must be in [1, 4096].
         end: Optional (num_rows,) int32 tensor with the exclusive right
             boundary of each row. Rows with `end[i] < topk` get their
             remaining indices filled with -1.
@@ -93,10 +96,14 @@ def deep_select_topk(
         The (num_rows, topk) indices tensor.
 
     """
+    input_alignment, output_alignment = get_deep_select_stride_requirement()
     assert input.dim() == 2 and input.stride(1) == 1
+    assert 0 < input.shape[1] < 2**23
+    assert 0 < topk <= 4096
+    assert indices_dtype in (torch.int32, torch.int64)
     assert (
-        input.stride(0) * input.element_size() % get_deep_select_stride_requirement()[0]
-        == 0
+        input.storage_offset() * input.element_size() % input_alignment == 0
+        and input.stride(0) * input.element_size() % input_alignment == 0
     )
 
     num_rows = input.shape[0]
@@ -105,8 +112,16 @@ def deep_select_topk(
             num_rows, topk, input.device, indices_dtype
         )
     else:
+        assert output_idx.device == input.device
         assert output_idx.dtype == indices_dtype
+        assert output_idx.dim() == 2
         assert output_idx.shape[0] >= num_rows and output_idx.shape[1] >= topk
+        assert output_idx.stride(1) == 1
+        assert (
+            output_idx.storage_offset() * output_idx.element_size() % output_alignment
+            == 0
+        )
+        assert output_idx.stride(0) * output_idx.element_size() % output_alignment == 0
 
     torch.ops.deep_select.topk(
         input,
@@ -125,7 +140,7 @@ def deep_select_topk(
         # logits from uninitialized KV cache; the reference topk kernels do
         # not trap on NaN, and trapping would abort CUDA graph capture.
     )
-    return output_idx
+    return output_idx[:, :topk]
 
 
 # ---------------------------------------------------------------------------
@@ -153,8 +168,8 @@ class SparseIndexerTopk(torch.nn.Module):
             )
         self._backend = backend
         self._is_cuda = current_platform.is_cuda()
-        self._has_deep_select = self._is_cuda and (
-            current_platform.is_device_capability_family(100)
+        self._is_musa = (
+            current_platform.is_out_of_tree() and current_platform.is_musa()
         )
         self._has_flashinfer_topk = has_flashinfer()
         self._cooperative_capable = self._is_cuda and (
@@ -190,9 +205,9 @@ class SparseIndexerTopk(torch.nn.Module):
                     f"topk_tokens must be in (512, 1024, 2048), got {topk_tokens}"
                 )
         elif self._backend == "deep_select":
-            if not self._is_cuda:
-                failures.append("requires a CUDA platform")
-            elif not self._has_deep_select:
+            if not self._is_cuda and not self._is_musa:
+                failures.append("requires a CUDA or MUSA platform")
+            elif self._is_cuda and not current_platform.is_device_capability_family(100):
                 failures.append("requires SM100a/SM103a (10.x device family)")
             elif not _HAS_DEEP_SELECT_C:
                 failures.append("vllm._deepselect_C could not be imported")
