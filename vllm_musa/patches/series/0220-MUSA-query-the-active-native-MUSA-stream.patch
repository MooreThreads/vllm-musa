From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Thu, 26 Nov 2026 17:11:55 +0800
Subject: [PATCH] MUSA: query the active native MUSA stream

Ray PP uses the shared stream helper to synchronize after PyNccl receives. Read the native MUSA stream so communication and synchronization agree inside native stream contexts.
---
 vllm/utils/torch_utils.py | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/vllm/utils/torch_utils.py b/vllm/utils/torch_utils.py
index 6d80de8194..98e0963567 100644
--- a/vllm/utils/torch_utils.py
+++ b/vllm/utils/torch_utils.py
@@ -827,6 +827,10 @@ def current_stream() -> torch.cuda.Stream:
     """
     from vllm.platforms import current_platform
 
+    if current_platform.device_type == "musa":
+        # Native MUSA stream contexts bypass the patched CUDA stream setter.
+        return torch.musa.current_stream()
+
     if not hasattr(_current_stream_tls, "value") or _current_stream_tls.value is None:
         # when this function is called before any stream is set,
         # we return the default stream.
