+@pytest.mark.parametrize(
+    ("overrides", "blocks_per_request"),
+    [
+        # In none mode only the running and speculative states are held.
+        ({"mamba_cache_mode": "none"}, 1 + 6),
+        # Bounded by the block-table row: cdiv(6144, 2176) + 6.
+        ({}, 9),
+        # Resident window, three pinned snapshots and one retired state per
+        # extra in-flight batch.
+        ({"max_model_len": 16384}, 2 + 6 + 3 + 1),
+        ({"max_model_len": 16384, "max_concurrent_batches": 1}, 2 + 6 + 3),
+        # Retained segment snapshots are bounded only by the row.
+        ({"max_model_len": 16384, "retention": 2176}, 8 + 6),
+        # A partial-block hit adds the copy-on-write step.
+        ({"max_model_len": 16384, "prefix_match_unit": 544}, 2 + 6 + 3 + 1 + 2),
+        (
+            {
+                "max_model_len": 16384,
+                "prefix_match_unit": 544,
+                "kv_transfer_config": SimpleNamespace(
+                    kv_connector="MooncakeConnector", is_kv_producer=False
+                ),
+            },
+            2 + 6 + 3 + 1 + 2,
+        ),
+        # A producer also keeps its partial-tail block until the request
+        # finishes.
+        (
+            {
+                "max_model_len": 16384,
+                "prefix_match_unit": 544,
+                "kv_transfer_config": SimpleNamespace(
+                    kv_connector="MooncakeConnector", is_kv_producer=True
+                ),
+            },
+            2 + 6 + 3 + 1 + 2 + 1,
+        ),
+    ],
