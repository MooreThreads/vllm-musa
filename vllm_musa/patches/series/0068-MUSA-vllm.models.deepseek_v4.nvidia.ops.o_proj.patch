From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Thu, 25 Jun 2026 12:00:00 +0000
Subject: [PATCH] MUSA: vllm.models.deepseek_v4.nvidia.ops.o_proj

---
 vllm/models/deepseek_v4/nvidia/ops/o_proj.py | 34 ++++++++++++++++----
 1 file changed, 27 insertions(+), 7 deletions(-)

diff --git a/vllm/models/deepseek_v4/nvidia/ops/o_proj.py b/vllm/models/deepseek_v4/nvidia/ops/o_proj.py
index b064fbe9cd..70cc2052b0 100644
--- a/vllm/models/deepseek_v4/nvidia/ops/o_proj.py
+++ b/vllm/models/deepseek_v4/nvidia/ops/o_proj.py
@@ -63,11 +63,31 @@ def deep_gemm_fp8_o_proj(
     weight_scale = (
         wo_a.weight_scale if hasattr(wo_a, "weight_scale") else wo_a.weight_scale_inv
     )
-    fp8_einsum(
-        "bhr,hdr->bhd",
-        (o_fp8, o_scale),
-        (wo_a.weight, weight_scale),
-        z,
-        recipe=einsum_recipe,
-    )
+    if current_platform.is_musa():
+        # MUSA: mate's fp8_einsum rejects the 2D o_proj weight that upstream
+        # passes; the MUSA provider normalizes it to the grouped 3D layout.
+        from vllm_musa.deepseek_v4_jit.fp8_einsum import (
+            try_musa_deepseek_v4_fp8_einsum,
+        )
+
+        handled, reason = try_musa_deepseek_v4_fp8_einsum(
+            o_fp8,
+            o_scale,
+            wo_a.weight,
+            weight_scale,
+            z,
+            "bhr,hdr->bhd",
+        )
+        if not handled:
+            raise RuntimeError(
+                f"MUSA DeepSeek-V4 o_proj fp8_einsum unsupported: {reason}"
+            )
+    else:
+        fp8_einsum(
+            "bhr,hdr->bhd",
+            (o_fp8, o_scale),
+            (wo_a.weight, weight_scale),
+            z,
+            recipe=einsum_recipe,
+        )
     return wo_b(z.flatten(1))
