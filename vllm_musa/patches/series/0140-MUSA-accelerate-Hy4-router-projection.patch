diff --git a/csrc/libtorch_stable/fp32_router_gemm_entry.cu b/csrc/libtorch_stable/fp32_router_gemm_entry.cu
index 8643e33cbe..931a744320 100644
--- a/csrc/libtorch_stable/fp32_router_gemm_entry.cu
+++ b/csrc/libtorch_stable/fp32_router_gemm_entry.cu
@@ -134,7 +134,9 @@ void fp32_router_gemm(
 
   const torch::stable::accelerator::DeviceGuard device_guard(
       mat_a.get_device_index());
+#ifndef USE_MUSA
   STD_TORCH_CHECK(getSMVersion() >= 90, "fp32_router_gemm: requires SM90+");
+#endif
 
   auto stream = get_current_cuda_stream(mat_a.get_device_index());
   float* out_ptr = reinterpret_cast<float*>(output.mutable_data_ptr());
@@ -153,6 +155,10 @@ void fp32_router_gemm(
   }
 }
 
+#ifdef USE_MUSA
+STABLE_TORCH_LIBRARY_IMPL(_C, PrivateUse1, m) {
+#else
 STABLE_TORCH_LIBRARY_IMPL(_C, CUDA, m) {
