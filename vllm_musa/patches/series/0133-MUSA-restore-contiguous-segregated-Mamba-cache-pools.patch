From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Fri, 21 Aug 2026 21:03:10 +0800
Subject: [PATCH] MUSA: restore contiguous segregated Mamba cache pools

---
 vllm/model_executor/layers/mamba/abstract.py | 14 +++++-
 vllm/v1/worker/utils.py                      | 45 ++++++++++++++++----
 2 files changed, 50 insertions(+), 9 deletions(-)

diff --git a/vllm/model_executor/layers/mamba/abstract.py b/vllm/model_executor/layers/mamba/abstract.py
index ef35023..2510fd8 100644
--- a/vllm/model_executor/layers/mamba/abstract.py
+++ b/vllm/model_executor/layers/mamba/abstract.py
@@ -26,12 +26,24 @@ class MambaBase(AttentionLayerBase):
     kv_cache: tuple[torch.Tensor, ...]
     supports_dcp: bool = False
 
-    def bind_kv_cache(self, kv_cache: torch.Tensor) -> None:
+    def bind_kv_cache(
+        self, kv_cache: torch.Tensor | list[torch.Tensor] | tuple[torch.Tensor, ...]
+    ) -> None:
         """Unpack a raw ``[B, 1, 1, C]`` int8 page view into per-state views.
 
         Each block's ``C`` bytes hold the layer's states (e.g. conv, ssm)
         packed contiguously; slice them out and reinterpret per dtype/shape.
         """
+        if isinstance(kv_cache, (list, tuple)):
+            expected = len(tuple(self.get_state_shape()))
+            if len(kv_cache) != expected:
+                raise ValueError(
+                    "Unexpected number of Mamba state pools: "
+                    f"got {len(kv_cache)}, expected {expected}"
+                )
+            self.kv_cache = tuple(kv_cache)
+            return
+
         pages = kv_cache.squeeze(dim=(1, 2))
         states: list[torch.Tensor] = []
         offset = 0
diff --git a/vllm/v1/worker/utils.py b/vllm/v1/worker/utils.py
index d72c022..849b557 100644
--- a/vllm/v1/worker/utils.py
+++ b/vllm/v1/worker/utils.py
@@ -18,7 +18,7 @@ from vllm.model_executor.models.utils import extract_layer_index
 from vllm.platforms import current_platform
 from vllm.triton_utils import tl, triton
 from vllm.utils.mem_utils import MemorySnapshot, format_gib
-from vllm.utils.torch_utils import async_tensor_h2d
+from vllm.utils.torch_utils import async_tensor_h2d, get_dtype_size
 from vllm.v1.attention.backend import (
     AttentionBackend,
     AttentionMetadataBuilder,
@@ -397,7 +397,7 @@ def allocate_kv_cache(
     device: torch.device,
     layout: KVCacheLayout,
     kernel_block_sizes: list[int] | None = None,
-) -> dict[str, torch.Tensor]:
+) -> dict[str, torch.Tensor | list[torch.Tensor]]:
     """Allocate the KV cache and view it as ``[B, H, N, C]`` per layer.
 
     By default every KVCacheTensor uses the same backing allocation: layer ``l``
@@ -427,7 +427,7 @@ def allocate_kv_cache(
         for allocation_id, raw_size in backing_sizes.items()
     }
 
-    kv_caches: dict[str, torch.Tensor] = {}
+    kv_caches: dict[str, torch.Tensor | list[torch.Tensor]] = {}
     for tensor in kv_cache_config.kv_cache_tensors:
         buf = buffers[tensor.musa_allocation_id]
         layer_name = tensor.layers[0]
@@ -440,7 +440,12 @@ def allocate_kv_cache(
         if isinstance(spec, UniformTypeKVCacheSpecs):
             spec = spec.kv_cache_specs[layer_name]
 
-        num_blocks = kv_cache_config.num_blocks
+        num_blocks = (
+            kv_cache_config.musa_mamba_num_blocks
+            if tensor.musa_mamba_pool
+            and kv_cache_config.musa_mamba_num_blocks is not None
+            else kv_cache_config.num_blocks
+        )
         kernel_block_size = None
         if kernel_block_sizes is not None and group_id < len(kernel_block_sizes):
             kernel_block_size = kernel_block_sizes[group_id]
@@ -455,7 +460,27 @@ def allocate_kv_cache(
             tensor,
             kernel_block_size=kernel_block_size,
         )
-        kv_caches.update(zip(tensor.layers, views))
+        if tensor.musa_mamba_pool:
+            assert isinstance(spec, MambaSpec)
+            assert len(tensor.layers) == 1 and len(views) == 1
+            raw = buffers[tensor.musa_allocation_id]
+            state_tensors: list[torch.Tensor] = []
+            storage_offset = 0
+            for shape, dtype in zip(spec.shapes, spec.dtypes):
+                state_nbytes = math.prod(shape) * get_dtype_size(dtype)
+                end = storage_offset + num_blocks * state_nbytes
+                if end > tensor.size:
+                    raise RuntimeError(
+                        "Mamba cache backing is too small for contiguous state "
+                        f"pools: end={end}, size={tensor.size}, shape={shape}, "
+                        f"dtype={dtype}, num_blocks={num_blocks}"
+                    )
+                state = raw[storage_offset:end].view(dtype)
+                state_tensors.append(state.view(num_blocks, *shape))
+                storage_offset = end
+            kv_caches[tensor.layers[0]] = state_tensors
+        else:
+            kv_caches.update(zip(tensor.layers, views))
     return kv_caches
 
 
@@ -591,9 +616,9 @@ def add_kv_sharing_layers_to_kv_cache_groups(
 
 
 def bind_kv_cache(
-    kv_caches: dict[str, torch.Tensor],
+    kv_caches: dict[str, torch.Tensor | list[torch.Tensor]],
     forward_context: dict[str, Attention],
-    runner_kv_caches: list[torch.Tensor],
+    runner_kv_caches: list[torch.Tensor | list[torch.Tensor]],
     num_attn_module: int = 1,
 ) -> None:
     """
@@ -643,7 +668,7 @@ def bind_kv_cache(
 
 
 def copy_kv_cache_blocks_inplace(
-    kv_caches: Iterable[torch.Tensor],
+    kv_caches: Iterable[torch.Tensor | list[torch.Tensor]],
     num_blocks: int,
     kv_cache_block_copies: Sequence[KVCacheBlockCopy],
 ) -> None:
@@ -655,6 +680,10 @@ def copy_kv_cache_blocks_inplace(
     seen: set[tuple[torch.device, int]] = set()
     copied_storages: set[tuple[torch.device, int]] = set()
     for cache in kv_caches:
+        # Dedicated Mamba pools disable prefix caching and therefore never
+        # participate in attention-pool copy-on-write operations.
+        if isinstance(cache, list):
+            continue
         # Layers sharing KV (cross-layer sharing) alias the same view; copy it
         # once. data_ptr distinguishes per-layer views of a shared allocation.
         key = (cache.device, cache.data_ptr())
