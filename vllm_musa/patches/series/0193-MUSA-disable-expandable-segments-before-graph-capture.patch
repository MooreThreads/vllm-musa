From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Wed, 21 Oct 2026 18:00:00 +0800
Subject: [PATCH] MUSA: handle expandable segments around CUDA graph capture

torch_musa's expandable-segment allocator cannot grow a segment while a
stream is being captured, which surfaces as a spurious OOM during graph
capture even when device memory is still available (e.g. a 2 MiB allocation
failing with several GiB free).

Expandable segments are still needed during profile_run to avoid
fragmentation OOMs, so keep them enabled there and switch to ordinary
segments around both capture sites: the throwaway graphs used to profile
graph memory and the real capture. Each toggle now replays the full
allocator config, because parsing a partial one resets max_split_size,
garbage_collection_threshold and roundup_power2_divisions, and the setting
is restored after the capture so later allocations keep the fragmentation
benefit.

Verified on S5000 with Qwen3.5-122B-A10B TP4 at --gpu-memory-utilization
0.96 without --kv-cache-memory-bytes: graph estimate 2.14 GiB, available KV
cache 14.03 GiB, all graphs captured, server started and served requests.
---
 vllm/v1/worker/gpu_worker.py | 66 ++++++++++++++++++++++++++++++++++--
 1 file changed, 64 insertions(+), 2 deletions(-)

diff --git a/vllm/v1/worker/gpu_worker.py b/vllm/v1/worker/gpu_worker.py
index a2ff198..bafbc50 100644
--- a/vllm/v1/worker/gpu_worker.py
+++ b/vllm/v1/worker/gpu_worker.py
@@ -92,6 +92,41 @@ from .utils import request_memory
 logger = init_logger(__name__)
 
 
+def _musa_expandable_segments_enabled() -> bool:
+    conf = os.environ.get("PYTORCH_MUSA_ALLOC_CONF", "")
+    return "expandable_segments:true" in conf.replace(" ", "").lower()
+
+
+def _musa_allocator_conf(expandable_segments: bool) -> str:
+    """Rebuild the full allocator config because parsing a partial one resets
+    max_split_size, garbage_collection_threshold and roundup_power2_divisions.
+    """
+    try:
+        settings = torch.musa.memory._snapshot().get("allocator_settings", {})
+    except Exception:
+        settings = {}
+    parts = [f"expandable_segments:{expandable_segments}"]
+    max_split_size = settings.get("max_split_size", -1)
+    if max_split_size >= 0:
+        parts.append(f"max_split_size_mb:{max_split_size // (1 << 20)}")
+    gc_threshold = settings.get("garbage_collection_threshold", 0.0)
+    if gc_threshold > 0:
+        parts.append(f"garbage_collection_threshold:{gc_threshold}")
+    roundup = settings.get("roundup_power2_divisions") or {}
+    if any(int(v) for v in roundup.values()):
+        entries = ",".join(f"{k}:{v}" for k, v in roundup.items())
+        parts.append(f"roundup_power2_divisions:[{entries}]")
+    return ",".join(parts)
+
+
+def _musa_set_expandable_segments(enabled: bool) -> None:
+    if not current_platform.is_musa() or not hasattr(
+        torch.musa.memory, "_set_allocator_settings"
+    ):
+        return
+    torch.musa.memory._set_allocator_settings(_musa_allocator_conf(enabled))
+
+
 def _musa_deepseek_v4_mtp_sparse_prefill_reserve_bytes(
     vllm_config: VllmConfig,
 ) -> int:
@@ -576,7 +611,22 @@ class Worker(WorkerBase):
             current_platform.is_cuda_alike()
             and self.vllm_config.compilation_config.cudagraph_mode != CUDAGraphMode.NONE
         ):
-            cudagraph_memory_estimate = self.model_runner.profile_cudagraph_memory()
+            # MUSA's expandable-segment allocator cannot grow during stream
+            # capture, so use ordinary segments for the throwaway profiling
+            # graphs and restore the setting for the KV cache allocation.
+            restore_expandable = (
+                current_platform.is_musa()
+                and _musa_expandable_segments_enabled()
+            )
+            if restore_expandable:
+                _musa_set_expandable_segments(False)
+            try:
+                cudagraph_memory_estimate = (
+                    self.model_runner.profile_cudagraph_memory()
+                )
+            finally:
+                if restore_expandable:
+                    _musa_set_expandable_segments(True)
 
         # Respect the opt-in flag as originally designed.
         cudagraph_memory_estimate_applied = (
@@ -789,7 +839,19 @@ class Worker(WorkerBase):
 
         cuda_graph_memory_bytes = 0
         if not self.model_config.enforce_eager:
-            cuda_graph_memory_bytes = self.model_runner.capture_model()
+            # Expandable segments cannot grow while a stream is being captured,
+            # which surfaces as an OOM during graph capture.
+            restore_expandable = (
+                current_platform.is_musa()
+                and _musa_expandable_segments_enabled()
+            )
+            if restore_expandable:
+                _musa_set_expandable_segments(False)
+            try:
+                cuda_graph_memory_bytes = self.model_runner.capture_model()
+            finally:
+                if restore_expandable:
+                    _musa_set_expandable_segments(True)
 
         # Compare actual vs estimated CUDA graph memory (if we did profiling)
         if (
