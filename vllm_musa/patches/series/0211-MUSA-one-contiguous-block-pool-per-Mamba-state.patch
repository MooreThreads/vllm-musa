 from typing import Any
 
 import numpy as np
@@ -20,7 +21,7 @@ from vllm.model_executor.models.utils import extract_layer_index
 from vllm.platforms import current_platform
 from vllm.triton_utils import tl, triton
 from vllm.utils.mem_utils import MemorySnapshot, format_gib
-from vllm.utils.torch_utils import async_tensor_h2d
+from vllm.utils.torch_utils import async_tensor_h2d, get_dtype_size
 from vllm.v1.attention.backend import (
     AttentionBackend,
     AttentionMetadataBuilder,
@@ -564,6 +565,33 @@ def select_common_block_size(
     )
 
 
+def _musa_mamba_state_pools(
+    buf: torch.Tensor, spec: MambaSpec, num_blocks: int
+) -> list[torch.Tensor]:
+    """Build one semantically correct state view per packed block page.
+
+    The shared fused backing allocation is page-major: each block contains all
+    of a layer's states.  A flat state-major slice mixes adjacent blocks, so
+    retain the page stride while selecting each state's byte range.
+    """
+    page_bytes = buf.numel() // num_blocks
+    pages = buf.view(num_blocks, page_bytes)
+    pools: list[torch.Tensor] = []
+    offset = 0
+    for shape, dtype in zip(spec.shapes, spec.dtypes):
+        state_bytes = prod(shape) * get_dtype_size(dtype)
+        end = offset + state_bytes
+        if end > page_bytes:
+            raise RuntimeError(
+                f"Mamba page of {page_bytes} bytes cannot hold "
+                f"state {shape} {dtype}: needs {end}"
+            )
+        state = pages[:, offset:end].view(dtype)
+        pools.append(state.view(num_blocks, *shape))
+        offset = end
+    return pools
+
+
 def allocate_kv_cache(
     kv_cache_config: KVCacheConfig,
     device: torch.device,
@@ -615,6 +643,23 @@ def allocate_kv_cache(
             continue
 
         num_blocks = kv_cache_config.num_blocks_of(tensor)
+        if isinstance(spec, MambaSpec):
+            kv_caches.update(
+                (
+                    name,
+                    _musa_mamba_state_pools(
+                        buf.narrow(
+                            0,
+                            tensor.offset + layer_idx * tensor.layer_stride,
+                            tensor.layer_stride,
+                        ),
+                        spec,
+                        num_blocks,
