+    def _musa_prewarm_qsa_tilelang(self, vllm_config: VllmConfig) -> None:
+        """Build the TileLang kernels and their scratch before graph capture.
+
+        The decode path is first reached while the decode graphs are being
+        captured, so a lazy build or allocation there would land in the graph
+        memory pool and alias another captured size.
+        """
+        if not current_platform.is_musa():
+            return
+        try:
+            from vllm_musa.jit_kernel.tilelang.qsa_sparse_attn_v2 import (
+                prewarm_qsa_kernels,
+            )
+
+            # Only the sizes capture replays need buffers warmed outside the
+            # graph pool; an eager decode step allocates its own row count on
+            # demand. Decode takes the TileLang path only when explicitly
+            # enabled, so otherwise reserve no scratch at all (a captured size
+            # costs ~64 KiB per row at head_dim=128).
+            decode_rows: tuple[int, ...] = ()
+            if os.environ.get("VLLM_MUSA_QSA_TILELANG_DECODE") == "1":
+                decode_rows = tuple(
+                    sorted(vllm_config.compilation_config.cudagraph_capture_sizes or ())
+                )
+            prewarm_qsa_kernels(
+                self.num_heads // self.num_kv_heads,
+                self.head_dim,
+                self.indexer.packed_output_width - 1,
+                vllm_config.cache_config.block_size,
+                self.kv_cache_torch_dtype,
+                decode_rows=decode_rows,
+            )
+        except Exception as error:  # a prewarm failure must not break serving
+            logger.warning_once("QSA TileLang prewarm skipped: %s", error)
+
