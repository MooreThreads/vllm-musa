+            weights_fp32 = weights.to(torch.float32)
+            _musa_fill_decode_topk_from_indexer_cache_capture(
+                q_deq[: metadata.num_decode_tokens],
+                kv_cache,
+                weights_fp32[: metadata.num_decode_tokens],
