 vllm/v1/engine/core.py                 | 47 ++++++++++++++++++--------
 vllm/v1/worker/gpu_model_runner.py     | 43 ++++++++++++-----------
 vllm/v1/worker/mamba_utils.py          | 16 ++++++---
 4 files changed, 97 insertions(+), 42 deletions(-)

