         # pending non-blocking PP send work from the previous iteration
         self._pp_send_work: list[Handle] = []
+        # MUSA queues a large number of kernels during V2 warmup. Fence each
+        # model call only while warmup_kernels() is active so a later, global
+        # synchronize does not trip the device watchdog. This must not use
+        # MUSA_LAUNCH_BLOCKING, which is cached when the runtime initializes
+        # and would also serialize steady-state inference.
+        self._musa_sync_warmup_model_calls = False
 
         # Resolved lazily on first sleep/wake; persists worker-process state.
         self._sleep_mode_backend: SleepModeBackend | None = None
@@ -862,7 +868,14 @@ class Worker(WorkerBase):
 
