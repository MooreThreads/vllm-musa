diff --git a/vllm/model_executor/layers/sparse_attn_indexer.py b/vllm/model_executor/layers/sparse_attn_indexer.py
index 6693701f8585538bc066991ed64d98c3c5fa5c15..2092efce8aee2ae9dbc9ba11e5d9c8b84c82b45e 100644
--- a/vllm/model_executor/layers/sparse_attn_indexer.py
+++ b/vllm/model_executor/layers/sparse_attn_indexer.py
@@ -2331,6 +2331,40 @@ def sparse_attn_indexer(
     # fill.
     if not skip_topk_buffer_clear:
         topk_indices_buffer[: hidden_states.shape[0]] = -1
+    if (
+        current_platform.is_out_of_tree()
+        and current_platform.is_musa()
+        and candidate_blocks is not None
+        and not use_pcp
+    ):
+        from vllm_musa.kernels.sparse_mqa import try_candidate_indexer
+        from vllm_musa.kernels.sparse_mqa_dispatch import candidate_path_enabled
+
+        if candidate_path_enabled() and try_candidate_indexer(
+            q_quant,
+            kv_cache,
+            weights,
+            attn_metadata_narrowed,
+            candidate_blocks,
+            candidate_block_size,
+            topk_indices_buffer[:, :topk_tokens],
+            max_model_len,
+            use_fp4_cache,
+            candidate_write,
+        ):
+            return topk_indices_buffer
+        return _musa_fill_exact_sparse_indexer_indices(
+            hidden_states,
+            k_cache_prefix,
+            kv_cache,
+            q_quant,
+            weights,
+            topk_tokens,
+            head_dim,
+            max_model_len,
+            topk_indices_buffer,
+            use_fp4_cache,
+        )
     if has_prefill:
         prefill_metadata = attn_metadata_narrowed.prefill
         assert prefill_metadata is not None
@@ -2820,7 +2854,18 @@ class SparseAttnIndexer(CustomOp):
         k: torch.Tensor | None,
         weights: torch.Tensor,
     ):
-        if current_platform.is_cuda() or current_platform.is_xpu():
+        use_candidates = False
+        if current_platform.is_out_of_tree() and current_platform.is_musa():
+            from vllm_musa.kernels.sparse_mqa_dispatch import candidate_path_enabled
+
+            use_candidates = (
+                self.candidate_blocks is not None and candidate_path_enabled()
+            )
+        if (
+            current_platform.is_cuda()
+            or current_platform.is_xpu()
+            or use_candidates
+        ):
             return self.forward_cuda(hidden_states, q_quant, k, weights)
         elif current_platform.is_rocm():
             if self.use_pcp and self.dcp_world_size > 1:
