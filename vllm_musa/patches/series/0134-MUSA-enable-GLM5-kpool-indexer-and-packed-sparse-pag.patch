diff --git a/vllm/model_executor/layers/sparse_attn_indexer_kpool.py b/vllm/model_executor/layers/sparse_attn_indexer_kpool.py
index 5924d9f..bd08f31 100644
--- a/vllm/model_executor/layers/sparse_attn_indexer_kpool.py
+++ b/vllm/model_executor/layers/sparse_attn_indexer_kpool.py
@@ -47,6 +47,79 @@ RADIX_TOPK_WORKSPACE_SIZE = 1024 * 1024
 # MXFP4 layout: 2 values packed per byte, ue8m0 (1-byte) scale per block of 32.
 MXFP4_BLOCK_SIZE = 32
 
+
+def _musa_topk_rows(
+    logits: torch.Tensor,
+    row_starts: torch.Tensor,
+    row_ends: torch.Tensor,
+    out: torch.Tensor,
+    topk: int,
+) -> None:
+    """Functional MUSA fallback for the CUDA-only per-row top-k kernels.
+
+    Only columns in ``[row_starts, row_ends)`` participate. Rows shorter than
+    ``topk`` are padded with -1, matching the sentinel consumed by the sparse
+    indexer pool-expansion path.
+    """
+    num_rows, num_columns = logits.shape
+    effective_k = min(topk, num_columns)
+    out.fill_(-1)
+    if num_rows == 0 or effective_k == 0:
+        return
+
+    row_starts = row_starts.reshape(-1)[:num_rows].to(torch.int64)
+    row_ends = row_ends.reshape(-1)[:num_rows].to(torch.int64)
+    row_starts = row_starts.clamp(min=0, max=num_columns)
+    row_ends = row_ends.clamp(min=0, max=num_columns)
+    columns = torch.arange(num_columns, device=logits.device, dtype=torch.int64)
+    valid = (columns[None, :] >= row_starts[:, None]) & (
+        columns[None, :] < row_ends[:, None]
+    )
+    masked_logits = logits.masked_fill(~valid, float("-inf"))
+    indices = torch.topk(
+        masked_logits, effective_k, dim=-1, largest=True, sorted=False
+    ).indices.to(torch.int32)
+
+    selected_valid = (indices >= row_starts[:, None]) & (
+        indices < row_ends[:, None]
+    )
+    indices.masked_fill_(~selected_valid, -1)
+    out[:, :effective_k].copy_(indices)
+
+
+def _musa_top_k_per_row_prefill(
+    logits: torch.Tensor,
+    row_starts: torch.Tensor,
+    row_ends: torch.Tensor,
+    out: torch.Tensor,
+    topk: int,
+) -> None:
+    _musa_topk_rows(logits, row_starts, row_ends, out, topk)
+
+
+def _musa_top_k_per_row_decode(
+    logits: torch.Tensor,
+    next_n: int,
+    seq_lens: torch.Tensor,
+    out: torch.Tensor,
+    topk: int,
+) -> None:
+    num_rows = logits.shape[0]
+    rows = torch.arange(num_rows, device=logits.device, dtype=torch.int64)
+    if seq_lens.ndim == 2:
+        row_ends = seq_lens.reshape(-1)[:num_rows]
+    else:
+        batch_indices = torch.div(rows, next_n, rounding_mode="floor")
+        next_n_offsets = rows.remainder(next_n)
+        row_ends = (
+            seq_lens.reshape(-1)[batch_indices]
+            - next_n
+            + next_n_offsets
+            + 1
+        )
+    row_starts = torch.zeros_like(row_ends)
+    _musa_topk_rows(logits, row_starts, row_ends, out, topk)
+
 # kpool write helper: form pools from the current token batch and compress them
 # into the index K cache via the fused Triton kernel.
 
@@ -562,7 +635,15 @@ def sparse_attn_indexer_kpool(
                     chunk.token_start : chunk.token_end, :topk_tokens
                 ]
 
-            if current_platform.is_xpu():
+            if current_platform.is_musa():
+                _musa_top_k_per_row_prefill(
+                    logits,
+                    chunk.cu_seqlen_ks,
+                    chunk.cu_seqlen_ke,
+                    topk_dst,
+                    select_k,
+                )
+            elif current_platform.is_xpu():
                 xpu_ops.top_k_per_row_prefill(  # type: ignore[attr-defined]
                     logits,
                     chunk.cu_seqlen_ks,
@@ -837,7 +918,15 @@ def sparse_attn_indexer_kpool(
                 attn_metadata_narrowed.max_seq_len,
             )
         else:
-            if current_platform.is_xpu():
+            if current_platform.is_musa():
+                _musa_top_k_per_row_decode(
+                    logits,
+                    next_n,
+                    seq_lens,
+                    topk_dst,
+                    select_k,
+                )
+            elif current_platform.is_xpu():
                 xpu_ops.top_k_per_row_decode(  # type: ignore[attr-defined]
                     logits,
                     next_n,
@@ -991,7 +1080,7 @@ class SparseAttnIndexerKpool(CustomOp):
         index_kpool: int = 1,
         positions: torch.Tensor | None = None,
     ):
-        if current_platform.is_cuda() or current_platform.is_xpu():
+        if current_platform.is_cuda() or current_platform.is_xpu() or current_platform.is_musa():
             return self.forward_cuda(
                 hidden_states,
                 q_quant,
