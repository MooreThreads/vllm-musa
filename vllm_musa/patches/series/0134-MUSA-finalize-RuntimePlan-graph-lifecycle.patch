diff --git a/vllm/platforms/interface.py b/vllm/platforms/interface.py
index 5c041f1632..52ea05eee4 100644
--- a/vllm/platforms/interface.py
+++ b/vllm/platforms/interface.py
@@ -585,6 +585,23 @@ class Platform:
         """
         pass
 
+    @classmethod
+    def finalize_config(cls, vllm_config: "VllmConfig") -> None:
+        """Finalize platform-owned config after all update hooks have run."""
+
+        return None
+
+    @classmethod
+    def validate_cudagraph_config(
+        cls,
+        vllm_config: "VllmConfig",
+        *,
+        uniform_decode_query_len: int,
+    ) -> None:
+        """Validate config immediately before CUDAGraph runtime setup."""
+
+        return None
+
     @classmethod
     def _find_non_ssm_backend(
         cls, vllm_config: "VllmConfig"
