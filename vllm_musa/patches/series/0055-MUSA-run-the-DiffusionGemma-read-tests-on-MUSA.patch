From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Thu, 22 Oct 2026 18:03:48 +0800
Subject: [PATCH] MUSA: run the DiffusionGemma read tests on MUSA

The read suite gates on current_platform.is_cuda() and hardcodes device="cuda",
so MUSA (an out-of-tree platform that reports itself is_cuda_alike() but keeps
is_cuda() False) skipped the whole per-request canvas/pin/read-only state
machine that /v1/systemone reads through.

Gate on current_platform.is_cuda_alike() and take the device from
current_platform.device_type. The 21 cases then run on MUSA and pass.
---
 tests/v1/sample/test_diffusion_gemma_reads.py | 27 +++++++++++--------
 1 file changed, 16 insertions(+), 11 deletions(-)

diff --git a/tests/v1/sample/test_diffusion_gemma_reads.py b/tests/v1/sample/test_diffusion_gemma_reads.py
index 4abadc254d..e393838b88 100644
--- a/tests/v1/sample/test_diffusion_gemma_reads.py
+++ b/tests/v1/sample/test_diffusion_gemma_reads.py
@@ -19,10 +19,15 @@ from vllm.model_executor.models.diffusion_gemma import (
 from vllm.platforms import current_platform
 from vllm.v1.outputs import LogprobsTensors
 
+
+# The sampler state lives on the GPU; MUSA is CUDA-alike but keeps is_cuda() False.
 pytestmark = pytest.mark.skipif(
-    not current_platform.is_cuda(), reason="the sampler state lives on the GPU"
+    not current_platform.is_cuda_alike(),
+    reason="the sampler state lives on the GPU",
 )
 
+DEVICE = current_platform.device_type or "cpu"
+
 CL = 8
 VOCAB = 64
 MAX_REQS = 4
@@ -35,7 +40,7 @@ def _states() -> DiffusionGemmaRequestStates:
         canvas_length=CL,
         vocab_size=VOCAB,
         max_denoising_steps=MAX_STEPS,
-        device=torch.device("cuda"),
+        device=torch.device(DEVICE),
         hidden_size=4,
         stability_threshold=2,
     )
@@ -43,7 +48,7 @@ def _states() -> DiffusionGemmaRequestStates:
 
 def _slots(*idx: int) -> tuple[np.ndarray, torch.Tensor]:
     slots = np.array(idx, dtype=np.int64)
-    return slots, torch.tensor(slots, device="cuda")
+    return slots, torch.tensor(slots, device=DEVICE)
 
 
 def test_seed_canvas_replaces_only_seeded_slots():
@@ -191,11 +196,11 @@ def test_pinned_positions_hold_their_seed_through_a_step():
     states.is_encoder_phase[0] = False
     seed = list(range(10, 10 + CL))
     states.set_seed_canvas(0, seed)
-    states.canvas[0] = torch.tensor(seed, device="cuda")
+    states.canvas[0] = torch.tensor(seed, device=DEVICE)
     states.set_pins(0, [0, 1, 2, 3])
 
     # Flat logits accept nothing, so every free position is renoised.
-    _denoise_once(states, [0], embed_weight=torch.ones(VOCAB, 4, device="cuda"))
+    _denoise_once(states, [0], embed_weight=torch.ones(VOCAB, 4, device=DEVICE))
 
     assert states.canvas[0, :4].tolist() == seed[:4]
     # The soft embed is zero at pinned positions and non-zero elsewhere.
@@ -244,14 +249,14 @@ def test_self_conditioning_stores_a_bf16_model_in_the_fp32_buffer(stance):
         _denoise_once(
             states,
             [0],
-            embed_weight=torch.ones(VOCAB, 4, dtype=torch.bfloat16, device="cuda"),
+            embed_weight=torch.ones(VOCAB, 4, dtype=torch.bfloat16, device=DEVICE),
             embed_dtype=torch.bfloat16,
         )
 
     assert states.self_conditioning_embeds.dtype == torch.float32
     # uniform probs @ an all-ones embedding
     assert torch.allclose(
-        states.self_conditioning_embeds[0], torch.ones(CL, 4, device="cuda")
+        states.self_conditioning_embeds[0], torch.ones(CL, 4, device=DEVICE)
     )
 
 
@@ -353,10 +358,10 @@ def test_batch_allowed_needs_one_shared_set():
 
 
 def test_mask_rows_to_allowed_masks_only_constrained_rows():
-    logits = torch.randn(5, VOCAB, device="cuda")
+    logits = torch.randn(5, VOCAB, device=DEVICE)
     before = logits.clone()
-    first = torch.tensor([3, 7], device="cuda")
-    third = torch.tensor([0], device="cuda")
+    first = torch.tensor([3, 7], device=DEVICE)
+    third = torch.tensor([0], device=DEVICE)
 
     out = _mask_rows_to_allowed(logits, [0, 2, 3], [2, 1, 2], [first, None, third])
 
@@ -378,5 +383,5 @@ def test_mask_rows_to_allowed_masks_only_constrained_rows():
 
 
 def test_mask_rows_to_allowed_is_a_no_op_without_constrained_rows():
-    logits = torch.randn(3, VOCAB, device="cuda")
+    logits = torch.randn(3, VOCAB, device=DEVICE)
     assert _mask_rows_to_allowed(logits, [0, 1], [1, 2], [None, None]) is logits
