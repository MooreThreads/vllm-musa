     def compute_slot_mapping(
         self,
@@ -211,11 +222,23 @@
         )
 
     def commit_block_table(self, num_reqs: int) -> None:
+        if (
+            self.slot_mapping_mode == SlotMappingMode.NONE
+            and not self._mamba_table_dirty
+            and num_reqs <= self._mamba_uploaded_rows
+        ):
+            return
         self.block_table.copy_to_gpu(num_reqs)
+        self._mamba_table_dirty = False
+        # A partial upload leaves rows outside the active prefix uncommitted.
+        # Upload them if that prefix grows, even without a subsequent mutation.
+        self._mamba_uploaded_rows = num_reqs
 
