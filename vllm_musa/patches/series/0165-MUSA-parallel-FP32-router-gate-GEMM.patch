 vllm/model_executor/layers/fused_moe/router/gate_linear.py | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/vllm/model_executor/layers/fused_moe/router/gate_linear.py b/vllm/model_executor/layers/fused_moe/router/gate_linear.py
index ba46c1d..0e5ec38 100644
--- a/vllm/model_executor/layers/fused_moe/router/gate_linear.py
+++ b/vllm/model_executor/layers/fused_moe/router/gate_linear.py
@@ -179,6 +179,27 @@ class GateLinear(ReplicatedLinear):
     def forward(
         self, x: torch.Tensor
     ) -> torch.Tensor | tuple[torch.Tensor, Parameter | None]:
+        # Tier 0 (MUSA): parallel FP32 router gate.
+        #
+        # With force_fp32_compute the FP32 weight reaches Tier 6 and lands on the
+        # vendor FP32 SGEMM, which launches with grid=(1,1,1) and costs ~292 us at
+        # every M on S5000 - 19% of the decode step device time for Nemotron-3.5
+        # (29 MoE layers x 1 call per step).  The MUSA kernel below is bitwise
+        # identical to that GEMM (same FP32 accumulation order) and ~1.9x faster
+        # at decode M, so the router's top-k and the model output do not change.
+        if (
+            x.device.type == "musa"
+            and x.shape[-1] == 2688
+            and self.weight.shape == (128, 2688)
+        ):
+            from vllm_musa.model_executor.layers.fused_moe.router.musa_router_gemm import (  # noqa: E501
+                router_gate_fp32,
+            )
+
+            output = router_gate_fp32(x, self.weight)
+            if output is not None:
+                return output, None
+
         # Tier 1: cuteDSL ll_bf16_gemm (SM90+, any dims)
         if self.allow_ll_bf16_gemm and x.shape[0] <= 16 and x.dtype == torch.bfloat16:
             from vllm.model_executor.kernels.linear.cute_dsl.ll_bf16 import (
