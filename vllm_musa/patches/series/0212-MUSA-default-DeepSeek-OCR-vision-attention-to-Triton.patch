From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Fri, 30 Oct 2026 15:02:47 +0800
Subject: [PATCH] MUSA: default DeepSeek-OCR vision attention to Triton

Set the MUSA vision encoder default in the model constructor only when
no backend is configured. Preserve all explicit backend choices and
leave backend selection and logging to MMEncoderAttention.
---
 vllm/model_executor/models/deepseek_ocr.py | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/vllm/model_executor/models/deepseek_ocr.py b/vllm/model_executor/models/deepseek_ocr.py
index 902fc87355..8c4c95d42c 100644
--- a/vllm/model_executor/models/deepseek_ocr.py
+++ b/vllm/model_executor/models/deepseek_ocr.py
@@ -59,6 +59,7 @@ from vllm.transformers_utils.processors.deepseek_ocr import (
     count_tiles,
 )
 from vllm.utils.tensor_schema import TensorSchema, TensorShape
+from vllm.v1.attention.backends.registry import AttentionBackendEnum
 from vllm.v1.sample.logits_processor import (
     AdapterLogitsProcessor,
     RequestLogitsProcessor,
@@ -393,6 +394,14 @@ class DeepseekOCRForCausalLM(
         quant_config = vllm_config.quant_config
         multimodal_config = vllm_config.model_config.multimodal_config
 
+        if (
+            _is_musa_runtime()
+            and multimodal_config.mm_encoder_attn_backend is None
+        ):
+            multimodal_config.mm_encoder_attn_backend = (
+                AttentionBackendEnum.TRITON_ATTN
+            )
+
         self.config = config
         self.model_config = vllm_config.model_config
         self.multimodal_config = multimodal_config
