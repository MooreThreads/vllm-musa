                 )
 
+        if self.for_draft_model and cudagraph_mode.has_full_cudagraphs():
+            max_num_seqs = self.vllm_config.scheduler_config.max_num_seqs
+            assert self.compilation_config.cudagraph_capture_sizes is not None, (
+                "Cudagraph capture sizes must be set when full mode is enabled."
+            )
+            spec_cfg = self.vllm_config.speculative_config
+            if (
+                spec_cfg is not None
+                and not spec_cfg.parallel_drafting
+                and self.vllm_config.num_speculative_tokens >= 2
+            ):
+                target_qdl = 1 + self.vllm_config.num_speculative_tokens
+                max_target_tokens = target_qdl * max_num_seqs
+                target_decode_sizes = [
+                    x
+                    for x in self.compilation_config.cudagraph_capture_sizes
+                    if target_qdl <= x <= max_target_tokens
+                ]
+                capture_sizes_for_draft_model = sorted(
+                    {
+                        self._bs_to_padded_graph_size[
+                            min(target_bs // target_qdl, max_num_seqs)
+                        ]
+                        for target_bs in target_decode_sizes
+                    }
+                )
+                for bs, num_active_loras in product(
+                    capture_sizes_for_draft_model, lora_cases
+                ):
+                    self.add_cudagraph_key(
+                        CUDAGraphMode.FULL,
+                        self._create_padded_batch_descriptor(
+                            bs, True, num_active_loras > 0, num_active_loras, 1
+                        ),
+                    )
+
         self.keys_initialized = True
 
     def dispatch(
