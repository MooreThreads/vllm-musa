From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Wed, 19 Aug 2026 19:31:16 +0800
Subject: [PATCH] MUSA: skip CUDA-only FA4 warmup

---
 vllm/model_executor/warmup/kernel_warmup.py | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/vllm/model_executor/warmup/kernel_warmup.py b/vllm/model_executor/warmup/kernel_warmup.py
index cd16c63b58..2e76db3dc8 100644
--- a/vllm/model_executor/warmup/kernel_warmup.py
+++ b/vllm/model_executor/warmup/kernel_warmup.py
@@ -129,7 +129,10 @@ def kernel_warmup(worker: "Worker", *, process_local_only: bool = False):
     # Run next so input-prep kernels JIT against pristine runner state.
     if worker.vllm_config.kernel_config.enable_jit_warmup:
         kimi_k3_triton_warmup(worker)
-        fa4_cutedsl_warmup(worker)
+        if not current_platform.is_musa():
+            fa4_cutedsl_warmup(worker)
+        else:
+            logger.info_once("Skipping CUDA-only FA4 CuTeDSL warmup on MUSA.")
         sparse_mla_triton_warmup(worker)
 
     if current_platform.has_device_capability(90):
