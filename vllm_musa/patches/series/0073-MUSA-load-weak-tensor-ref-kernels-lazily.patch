From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Mon, 29 Jun 2026 17:23:00 +0800
Subject: [PATCH] MUSA: load weak tensor ref kernels lazily

---
 vllm/utils/torch_utils.py | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/vllm/utils/torch_utils.py b/vllm/utils/torch_utils.py
index 0e133a3773..1da1a89401 100644
--- a/vllm/utils/torch_utils.py
+++ b/vllm/utils/torch_utils.py
@@ -847,6 +847,12 @@ def weak_ref_tensor(tensor: Any) -> Any:
     This ignores 0-size tensors as those don't allocate any memory.
     """
     if isinstance(tensor, torch.Tensor) and tensor.numel() > 0:
+        if not hasattr(torch.ops._C, "weak_ref_tensor"):
+            from vllm.platforms import current_platform
+
+            if current_platform.is_musa():
+                current_platform.import_kernels()
+
         return torch.ops._C.weak_ref_tensor(tensor)
     else:
         return tensor
