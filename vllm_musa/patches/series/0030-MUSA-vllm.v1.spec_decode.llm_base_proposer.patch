+    def _should_use_full_cudagraph_wrap(self) -> bool:
+        import os as _os
+
+        cudagraph_mode = self.compilation_config.cudagraph_mode
+        if (
+            self.method == "dflash"
+            and _os.environ.get("VLLM_MUSA_DFLASH_FULL_WRAP", "1") == "0"
+        ):
+            return False
+        draft_full_wrap_default = (
+            "1"
+            if (
+                not current_platform.is_musa()
+                or self.method in ("eagle", "eagle3", "dflash")
+            )
+            else "0"
+        )
+        return (
+            _os.environ.get("VLLM_MUSA_DRAFT_FULL_WRAP", draft_full_wrap_default)
+            == "1"
