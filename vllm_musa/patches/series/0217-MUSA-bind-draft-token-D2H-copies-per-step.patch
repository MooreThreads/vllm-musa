+        """Return the latest drafts for the requests this output consumes."""
+        wanted_req_ids = self._step_req_ids
+        if wanted_req_ids is None:
+            # Synchronous scheduling retrieves the batch that was just sampled.
+            wanted_req_ids = set(self._last_set_req_ids)
