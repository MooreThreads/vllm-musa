From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Tue, 27 Oct 2026 10:43:13 +0800
Subject: [PATCH] MUSA: keep the allocator settings while loading weights

---
 vllm/v1/worker/gpu_worker.py | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/vllm/v1/worker/gpu_worker.py b/vllm/v1/worker/gpu_worker.py
index fa66bf6852..7f53e62247 100644
--- a/vllm/v1/worker/gpu_worker.py
+++ b/vllm/v1/worker/gpu_worker.py
@@ -455,6 +455,8 @@ class Worker(WorkerBase):
         """Limit CUDA/ROCm allocator splitting, restoring settings on exit."""
         if (
             not current_platform.is_cuda_alike()
+            # MUSA: the accelerator allocator-settings API is CUDA/ROCm only.
+            or self.device_config.device_type == "musa"
             or torch.cuda.memory.get_allocator_backend() != "native"
         ):
             yield
