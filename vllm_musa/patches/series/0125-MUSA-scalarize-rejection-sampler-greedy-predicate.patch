From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Thu, 20 Aug 2026 14:40:00 +0800
Subject: [PATCH] MUSA: scalarize rejection sampler greedy predicate

MUSA Triton can represent the rejection predicate as either a scalar or a
one-element block across sampler specializations. Broadcast both forms to a
one-element block, then reduce it to a scalar before it becomes loop-carried
state.
---
 vllm/v1/worker/gpu/spec_decode/rejection_sampler_utils.py | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/vllm/v1/worker/gpu/spec_decode/rejection_sampler_utils.py b/vllm/v1/worker/gpu/spec_decode/rejection_sampler_utils.py
index 3ea9f35ee8..0ee48bb08c 100644
--- a/vllm/v1/worker/gpu/spec_decode/rejection_sampler_utils.py
+++ b/vllm/v1/worker/gpu/spec_decode/rejection_sampler_utils.py
@@ -586,6 +586,8 @@ def _rejection_kernel(
                 else:
                     accepted = target_argmax == draft_sampled
                 accepted &= is_valid_draft
+                accepted |= tl.zeros((1,), tl.int1)
+                accepted = tl.sum(accepted.to(tl.int32), axis=0) != 0
                 verifying = accepted
                 accepted_length += accepted
                 tl.store(
