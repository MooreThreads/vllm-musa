index 0000000000..4eabe1d01e
--- /dev/null
+++ b/tests/models/qwen4_exp/test_qsa_work_metadata.py
@@ -0,0 +1,36 @@
+# SPDX-License-Identifier: Apache-2.0
+
+import torch
+
+from vllm.models.qwen4_exp.common.qsa_cache import (
+    _build_qsa_work_metadata_musa,
+)
+
+
+def test_qsa_work_metadata_musa_multi_request_cpu() -> None:
+    query_start_loc = torch.tensor([0, 1, 21, 21], dtype=torch.int32)
+    seq_lens = torch.tensor([1, 29, 40], dtype=torch.int32)
+    output = torch.empty((8, 2), dtype=torch.int32)
+
+    _build_qsa_work_metadata_musa(
+        query_start_loc,
+        seq_lens,
+        output,
+        num_reqs=3,
+        compress_ratio=4,
+    )
+
+    expected = torch.tensor(
+        [
+            [0, 0],
+            [1, 0],
+            [1, 1],
+            [1, 2],
+            [1, 3],
+            [1, 4],
+            [-1, -1],
+            [-1, -1],
+        ],
+        dtype=torch.int32,
+    )
+    torch.testing.assert_close(output, expected)
