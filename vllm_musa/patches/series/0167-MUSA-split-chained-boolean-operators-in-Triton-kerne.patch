From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Tue, 27 Oct 2026 10:43:11 +0800
Subject: [PATCH] MUSA: split chained boolean operators in Triton kernels

---
 vllm/models/deepseek_v32/common/kernels.py        | 2 +-
 vllm/v1/attention/ops/triton_attention_helpers.py | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/vllm/models/deepseek_v32/common/kernels.py b/vllm/models/deepseek_v32/common/kernels.py
index 255b1f5aaf..d4eb98658f 100644
--- a/vllm/models/deepseek_v32/common/kernels.py
+++ b/vllm/models/deepseek_v32/common/kernels.py
@@ -231,7 +231,7 @@ def _fused_norm_rope_kernel(
         return
 
     if slot_mapping_ptr is None:
-        if kv_out_ptr is None and kpe_out_ptr is None and index_k_out_ptr is None:
+        if kv_out_ptr is None and (kpe_out_ptr is None and index_k_out_ptr is None):
             return
     elif tl.load(slot_mapping_ptr + tok_idx) < 0 and (
         pid != 1 or (kv_out_ptr is None and kpe_out_ptr is None)
diff --git a/vllm/v1/attention/ops/triton_attention_helpers.py b/vllm/v1/attention/ops/triton_attention_helpers.py
index dcfce10dc8..4c1be12f62 100644
--- a/vllm/v1/attention/ops/triton_attention_helpers.py
+++ b/vllm/v1/attention/ops/triton_attention_helpers.py
@@ -193,7 +193,7 @@ def compute_tile_loop_bounds(
         + (BLOCK_M - 1) // num_queries_per_kv
         + 1
     )
-    if USE_MM_PREFIX or USE_R_SWA or USE_PER_SEQ_CAUSAL or (not USE_CAUSAL):
+    if USE_MM_PREFIX or (USE_R_SWA or (USE_PER_SEQ_CAUSAL or (not USE_CAUSAL))):
         # Read the full sequence but never past seq_len: the causal-style
         # formula above can overshoot for non-causal sequences, and slots
         # >= seq_len are unwritten KV (last-block tail) that may hold NaN
