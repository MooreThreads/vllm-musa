--- a/vllm/v1/engine/core.py
+++ b/vllm/v1/engine/core.py
@@ -93,6 +93,7 @@ from vllm.v1.fault_tolerance.engine_core_sentinel import (
 )
 from vllm.v1.kv_cache_interface import (
     KVCacheConfig,
+    MambaSpec,
     get_kv_cache_spec_kind,
     is_full_attention_spec,
 )
@@ -340,20 +341,38 @@ class EngineCore:
         vllm_config.cache_config.num_gpu_blocks = scheduler_kv_cache_config.num_blocks
         kv_cache_groups = scheduler_kv_cache_config.kv_cache_groups
         if kv_cache_groups:
-            # Exclude groups that opt out of prefix caching (e.g. a circular
-            # buffer, a 1-block/req scratch buffer with a small ring block):
-            # their small block_size would otherwise drag the global block_size
-            # below the real allocator block size and desync it from mamba.
-            participating = [
-                g.kv_cache_spec.block_size
-                for g in kv_cache_groups
-                if g.kv_cache_spec.prefix_cacheable
-            ]
-            vllm_config.cache_config.block_size = min(
-                participating
-                if participating
-                else [g.kv_cache_spec.block_size for g in kv_cache_groups]
-            )
+            if (
+                vllm_config.cache_config.mamba_cache_mode == "align"
+                and any(isinstance(g.kv_cache_spec, MambaSpec) for g in kv_cache_groups)
+                and any(
+                    not isinstance(g.kv_cache_spec, MambaSpec)
+                    for g in kv_cache_groups
+                )
+            ):
+                # Dedicated Mamba pools keep attention and recurrent pages
+                # independent, so the scheduler block is the attention page
+                # rather than the smallest page across both cache families.
+                vllm_config.cache_config.block_size = max(
+                    g.kv_cache_spec.block_size
+                    for g in kv_cache_groups
+                    if not isinstance(g.kv_cache_spec, MambaSpec)
+                )
+            else:
+                # Exclude groups that opt out of prefix caching (e.g. a circular
+                # buffer, a 1-block/req scratch buffer with a small ring block):
+                # their small block_size would otherwise drag the global
+                # block_size below the real allocator block size and desync it
+                # from mamba.
+                participating = [
+                    g.kv_cache_spec.block_size
+                    for g in kv_cache_groups
+                    if g.kv_cache_spec.prefix_cacheable
+                ]
+                vllm_config.cache_config.block_size = min(
+                    participating
+                    if participating
+                    else [g.kv_cache_spec.block_size for g in kv_cache_groups]
+                )
             update_kv_cache_capacity(vllm_config, scheduler_kv_cache_config)
 
         vllm_config.validate_block_size()
