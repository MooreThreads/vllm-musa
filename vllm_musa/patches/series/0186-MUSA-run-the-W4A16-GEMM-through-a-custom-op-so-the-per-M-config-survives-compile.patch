+# --- MUSA runtime dispatch ------------------------------------------------
+if current_platform.is_musa():
+    import torch
+    from torch.library import custom_op
+
+    @custom_op("vllm_musa::triton_w4a16_gemm_runtime", mutates_args=())
+    def _triton_w4a16_gemm_runtime_op(
+        a: torch.Tensor,
+        b_q: torch.Tensor,
+        scales: torch.Tensor,
+        qzeros: torch.Tensor,
+        group_size: int,
+        zp_bias: int,
+    ) -> torch.Tensor:
+        # Runs on every call / every cudagraph capture, so the tile and split-K
+        # decisions below see the real runtime M instead of the trace-time M.
+        qz = None if qzeros.numel() == 0 else qzeros
+        return _w4a16_launch(a, b_q, scales, qz, group_size, zp_bias)
+
+    @_triton_w4a16_gemm_runtime_op.register_fake
+    def _triton_w4a16_gemm_runtime_fake(a, b_q, scales, qzeros, group_size, zp_bias):
+        return a.new_empty((a.shape[0], b_q.shape[1] * 8))
+
+    def triton_w4a16_gemm(a, b_q, scales, qzeros, group_size, zp_bias=8):
+        """Runtime-dispatched W4A16 GEMM (see the docstring of ``_w4a16_launch``)."""
+        if qzeros is None:
+            # custom_op schemas need a real Tensor; an empty one means "symmetric".
+            qzeros = a.new_empty(0, dtype=torch.int32)
+        return _triton_w4a16_gemm_runtime_op(a, b_q, scales, qzeros, group_size, zp_bias)
+# --- end MUSA runtime dispatch --------------------------------------------
+
