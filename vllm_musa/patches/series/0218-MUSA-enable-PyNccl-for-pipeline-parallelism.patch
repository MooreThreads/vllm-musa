                 return
 
-            stream = current_stream()
+            stream = self._current_stream()
             # A small all_reduce for warmup.
             data = torch.zeros(1, device=device)
-            self.all_reduce(data)
+            self.all_reduce(data, stream=stream)
             stream.synchronize()
             del data
 
@@ -286,7 +292,7 @@ class PyNcclCommunicator:
