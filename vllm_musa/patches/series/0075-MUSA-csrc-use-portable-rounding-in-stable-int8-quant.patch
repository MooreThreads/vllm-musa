From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Wed, 1 Jul 2026 17:30:00 +0800
Subject: [PATCH] MUSA(csrc): use portable rounding in stable int8 quant
 kernels

The scaled_quant.cu float_to_int8_rn / float_to_int32_rn / int32_to_int8
helpers cannot use the NVIDIA-only `cvt.rni.sat.*` inline PTX on mcc (it emits
wrong int8s), so take the portable std::nearbyint + saturate path that ROCm
already uses.

These kernels define dynamic_scaled_fp8_quant, dynamic_per_token_scaled_fp8_quant
and the static/dynamic int8 quant ops (all Tensor-arg, boxable), plus
static_scaled_fp8_quant (kept CUDA-only -- its int[] group_shape is unboxable).
---
 .../quantization/w8a8/int8/scaled_quant.cu             | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/csrc/libtorch_stable/quantization/w8a8/int8/scaled_quant.cu b/csrc/libtorch_stable/quantization/w8a8/int8/scaled_quant.cu
index e620c18184..be1c7cfd9f 100644
--- a/csrc/libtorch_stable/quantization/w8a8/int8/scaled_quant.cu
+++ b/csrc/libtorch_stable/quantization/w8a8/int8/scaled_quant.cu
@@ -8,7 +8,9 @@
 #include "../../../cub_helpers.h"
 
 static inline __device__ int8_t float_to_int8_rn(float x) {
-#ifdef USE_ROCM
+// MUSA: mcc cannot assemble the NVIDIA-only `cvt.rni.sat.s8.f32` PTX below
+// (it emits wrong int8s), so take the portable nearbyint+saturate path ROCm uses.
+#if defined(USE_ROCM) || defined(USE_MUSA)
   static constexpr auto i8_min =
       static_cast<float>(std::numeric_limits<int8_t>::min());
   static constexpr auto i8_max =
@@ -37,7 +39,8 @@ static inline __device__ int8_t float_to_int8_rn(float x) {
 }
 
 static inline __device__ int32_t float_to_int32_rn(float x) {
-#ifdef USE_ROCM
+// MUSA: same as float_to_int8_rn -- avoid the NVIDIA-only cvt PTX on mcc.
+#if defined(USE_ROCM) || defined(USE_MUSA)
   // int32_max is not exactly representable as float.
   // Therefore, we need to be careful and manually return int32_max on overflow.
   // For symmetry, we also do the same for int32_min, even though it is exactly
@@ -72,7 +75,8 @@ static inline __device__ int32_t float_to_int32_rn(float x) {
 }
 
 static inline __device__ int8_t int32_to_int8(int32_t x) {
-#ifdef USE_ROCM
+// MUSA: same as float_to_int8_rn -- avoid the NVIDIA-only cvt PTX on mcc.
+#if defined(USE_ROCM) || defined(USE_MUSA)
   static constexpr auto i8_min =
       static_cast<int32_t>(std::numeric_limits<int8_t>::min());
   static constexpr auto i8_max =
