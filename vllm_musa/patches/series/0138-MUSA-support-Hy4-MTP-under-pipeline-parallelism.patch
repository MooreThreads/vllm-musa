+        output = self.model_runner.sample_tokens(grammar_output)
+        if self._musa_sync_warmup_model_calls:
+            torch.musa.synchronize()
+        return output
 
     @torch.inference_mode()
     @with_gpu_sync_check
@@ -1179,7 +1195,10 @@ class Worker(WorkerBase):
             ):
                 if (
                     current_platform.is_musa()
-                    and os.getenv("VLLM_MUSA_SYNC_EXECUTE_MODEL") == "1"
+                    and (
+                        self._musa_sync_warmup_model_calls
+                        or os.getenv("VLLM_MUSA_SYNC_EXECUTE_MODEL") == "1"
