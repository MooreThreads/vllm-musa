From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Tue, 27 Oct 2026 10:43:12 +0800
Subject: [PATCH] MUSA: insert the DeepSeek-V4.1 DSpark context KV with the
 MUSA op

---
 vllm/models/deepseek_v41/attention.py     | 37 ++++++++++++++++++++++-
 vllm/models/deepseek_v41/nvidia/dspark.py |  5 +++
 2 files changed, 41 insertions(+), 1 deletion(-)

diff --git a/vllm/models/deepseek_v41/attention.py b/vllm/models/deepseek_v41/attention.py
index bffead2255..0e41d50c07 100644
--- a/vllm/models/deepseek_v41/attention.py
+++ b/vllm/models/deepseek_v41/attention.py
@@ -177,6 +177,34 @@ def _resolve_dsv4_kv_cache_dtype(
     return kv_cache_dtype, torch.bfloat16
 
 
+
+def _musa_deepseek_v4_kv_rope_insert(
+    attn: "DeepseekV4Attention",
+    kv: torch.Tensor,
+    slot_mapping: torch.Tensor,
+    positions: torch.Tensor,
+) -> None:
+    """MUSA: the fused CUDA KV insert op is not built. The MUSA q-norm, RoPE
+    and KV insert takes a query; pass a zero one and discard its result."""
+    assert not attn.kv_mxfp8
+    from vllm_musa import _custom_ops as _musa_custom_ops
+
+    dummy_q = torch.zeros(
+        (kv.shape[0], attn.n_local_heads, attn.head_dim),
+        dtype=kv.dtype,
+        device=kv.device,
+    )
+    _musa_custom_ops.deepseek_v4_qnorm_rope_kv_insert(
+        dummy_q,
+        kv,
+        attn.swa_cache_layer.kv_cache,
+        slot_mapping.contiguous(),
+        positions.contiguous(),
+        attn.rotary_emb.cos_sin_cache,
+        attn.eps,
+        attn.swa_cache_layer.block_size,
+    )
+
 class DeepseekV4Attention(nn.Module, AttentionLayerBase, ABC):
     """DeepseekV4 MLA attention layer.
 
@@ -696,7 +724,14 @@ class DeepseekV4Attention(nn.Module, AttentionLayerBase, ABC):
         attn_metadata = get_forward_context().attn_metadata
         qr_kv, kv_score, _ = self._run_parallel_input_projections(hidden_states)
         _, _, kv = self._split_qkv_and_norm(qr_kv)
-        if isinstance(attn_metadata, dict):
+        if isinstance(attn_metadata, dict) and current_platform.is_musa():
+            _musa_deepseek_v4_kv_rope_insert(
+                self,
+                kv,
+                cast(Any, attn_metadata[self.swa_cache_layer.prefix]).slot_mapping,
+                positions,
+            )
+        elif isinstance(attn_metadata, dict):
             # The KV half of _fused_qnorm_rope_kv_insert, bit for bit, without
             # the unused query; same as dspark's _insert_context_kv.
             cache = self.swa_cache_layer.kv_cache
diff --git a/vllm/models/deepseek_v41/nvidia/dspark.py b/vllm/models/deepseek_v41/nvidia/dspark.py
index 4a39edd701..a3cee00f63 100644
--- a/vllm/models/deepseek_v41/nvidia/dspark.py
+++ b/vllm/models/deepseek_v41/nvidia/dspark.py
@@ -50,6 +50,8 @@ from vllm.models.common.ops.sequence_parallel import (
     sp_padding_mask,
     sp_shard,
 )
+from vllm.models.deepseek_v41.attention import _musa_deepseek_v4_kv_rope_insert
+from vllm.platforms import current_platform
 
 from ..common.mm_preprocess import IMAGE_SENTINEL_BASE_ID
 from .model import (
@@ -266,6 +268,9 @@ def _insert_context_kv(
     # differ). block_size stays the layer's, so the op's size(1) check still
     # cross-checks the two rather than restating the tensor.
     cache = attn.swa_cache_layer.kv_cache
+    if current_platform.is_musa():
+        _musa_deepseek_v4_kv_rope_insert(attn, kv, slot_mapping, positions)
+        return
     torch.ops._C.fused_deepseek_v4_kv_rope_insert(
         kv,
         cache,
